--8.7 zxAnPonRmOnuCfmMepDmTable
-------------------------------------------------------------------------------
    zxAnPonRmOnuCfmMepDmTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuCfmMepDmEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This managed entity models DM test in G.984.4."
        REFERENCE   "G.984.4 9.3.22 Dot1ag MEP"
        ::= { zxAnPonRmOnuCfmObjects 7 }

    zxAnPonRmOnuCfmMepDmEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuCfmMepDmEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is entry in the zxAnPonRmOnuCfmMepDmTable."
        INDEX   { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuCfmMdId, 
                  zxAnPonOnuCfmMaId, zxAnPonOnuCfmMepId }
        ::= { zxAnPonRmOnuCfmMepDmTable 1 }

    ZxAnPonRmOnuCfmMepDmEntry ::=
        SEQUENCE {
            zxAnPonOnuDmWayType                     INTEGER,
            zxAnPonOnuDmAction                      INTEGER,
            zxAnPonOnuDmTargetMac                   MacAddress,
            zxAnPonOnuDmTargetMepId                 Integer32,
            zxAnPonOnuDmInterval                    INTEGER,
            zxAnPonOnuDmPri                         Integer32,
            zxAnPonOnuDmDropEligibility             INTEGER,
            zxAnPonOnuDmTransmitMsgs                Integer32,
            zxAnPonOnuDmLastDelay                   OCTET STRING,
            zxAnPonOnuDmCurrentDelay                OCTET STRING,
            zxAnPonOnuDmDelay                       OCTET STRING,
            zxAnPonOnuDmDelayDiff                   OCTET STRING,
            zxAnPonOnuDmDelayAvg                    OCTET STRING,
            zxAnPonOnuDmDelayAvgDiff                OCTET STRING
        }

    zxAnPonOnuDmWayType  OBJECT-TYPE
        SYNTAX      INTEGER {
                    dmOneWay(1),
                    dmTwoWay(2)
                    }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "
             dmSingle(1)  One-way ETH-DM, each MEP sends a frame with one-way
                          ETH-DM information to its peer MEP in a point to-point
                          ME to facilitate one-way frame delay and/or one-way 
                          frame delay variation measurements at the peer MEP.
             dmDual(2)    Two-way ETH-DM, A MEP sends frames with ETH-DM request
                          information to its peer MEP and receives frames with
                          ETH-DM reply information from its peer MEP to 
                          carry out two-way frame delay and two-wayframe 
                          delay variation measurements.
             "
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 1 }

    zxAnPonOnuDmAction  OBJECT-TYPE
        SYNTAX      INTEGER {
                    start(1),
                    stop(2)
                    }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Start/Stop the DM test operation "
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 2 }

    zxAnPonOnuDmTargetMac  OBJECT-TYPE
        SYNTAX      MacAddress
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The target MAC address."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 3 }

    zxAnPonOnuDmTargetMepId  OBJECT-TYPE
        SYNTAX      Integer32 (1..16)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The target MEP id."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 4 }

    zxAnPonOnuDmInterval  OBJECT-TYPE
        SYNTAX      INTEGER {
                       interval100ms     (1),
                       interval1s        (2),
                       interval10s       (3),
                       interval1min      (4),
                       interval10min     (5)
                    }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "
             interval100ms(1)   CCMs are sent every 100 milliseconds.
             interval1s(2)      CCMs are sent every 1 second.
             interval10s(3)     CCMs are sent every 10 seconds.
             interval1min(4)    CCMs are sent every minute.
             interval10min(5)   CCMs are sent every 10 minutes.
             "
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        DEFVAL {interval100ms}
        ::= { zxAnPonRmOnuCfmMepDmEntry 5 }

    zxAnPonOnuDmPri  OBJECT-TYPE
        SYNTAX      Integer32 (0..7)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The priority."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 6 }

    zxAnPonOnuDmDropEligibility  OBJECT-TYPE
        SYNTAX      INTEGER  {
                     enabled(1),
                     disabled(2)
                     }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The drop eligibility."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 7 }

    zxAnPonOnuDmTransmitMsgs  OBJECT-TYPE
        SYNTAX      Integer32(1..1024)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Repetition count, range 1~1024. This governs how many
             DM test messages are generated."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 8 }

    zxAnPonOnuDmLastDelay OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(5))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The first bytes representative value of second and the last
             four bytes representative value of nanosecond,
             the final value is value of second plus value of nanosecond.
             "
        REFERENCE
            "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 9 }

    zxAnPonOnuDmCurrentDelay OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(5))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The first byte representative value of second and the
             last four bytes representative value of nanosecond,
             the final value is value of second plus value of nanosecond."
        REFERENCE
            "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 10 }

    zxAnPonOnuDmDelay OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(5))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The first bytes representative value of second and
             the last four bytes representative value of nanosecond,
             the final value is value of second plus value of nanosecond.
             This value indicates the last delay statistic when the
             'zxAnPonOnuDmWayType' is dmSingle or dmDual."
        REFERENCE
            "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 11 }

    zxAnPonOnuDmDelayDiff OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(5))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The first byte representative value of second and the last four 
            bytes representative value of nanosecond, the final value is value 
            of second plus value of nanosecond."
        REFERENCE
            "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 12 }

    zxAnPonOnuDmDelayAvg OBJECT-TYPE
        SYNTAX      OCTET STRING  (SIZE(5))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average statistic frame delay in nanosecond. The first byte 
             representative value of second and the last four bytes
             representative value of nanosecond, the final value is value of 
             second plus value of nanosecond."
        REFERENCE
            "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 13 }

    zxAnPonOnuDmDelayAvgDiff OBJECT-TYPE
        SYNTAX      OCTET STRING  (SIZE(5))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average difference statistic frame delay in nanosecond. 
             The first byte representative value of second and the last 
             four bytes representative value of nanosecond, 
             the final value is value of second plus value of nanosecond."
        REFERENCE
            "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepDmEntry 14 }

--------------------------------------------------------------------------------
--   zxAnPonRmOnuPppoeTestTable
--------------------------------------------------------------------------------

    zxAnPonRmOnuPppoeTestTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuPppoeTestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The table lists PPPoE test entry. the entry indicates the test."
        REFERENCE
            "GPON in ZXPON ZTE private OMCI & PLOAM Specification 3.8.4;
            EPON in ZXPON ZTE private extended OAM Specification 3.3.5"
        ::= { zxAnPonRmOnuOamObjects 2 }

    zxAnPonRmOnuPppoeTestEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuPppoeTestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "An entry in the zxAnPonRmOnuPppoeTestTable."
        INDEX       { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuIfIndex}
        ::= { zxAnPonRmOnuPppoeTestTable 1 }

    ZxAnPonRmOnuPppoeTestEntry ::= SEQUENCE {
        zxAnPonRmPppoeTestVid          Integer32,
        zxAnPonRmPppoeTestUsername     DisplayString,
        zxAnPonRmPppoeTestPassword     DisplayString,
        zxAnPonRmPppoeTestAuthMode     INTEGER,
        zxAnPonRmPppoeTestAction       INTEGER,
        zxAnPonRmPppoeTestStatus       INTEGER,
        zxAnPonRmPppoeTestFailReason   INTEGER
    }

    zxAnPonRmPppoeTestVid OBJECT-TYPE
        SYNTAX      Integer32 (0..4094)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The VLAN of interface which will be used in testing datagram.

            0 means that test will use the PVID of interface.
            Non-zero value must be within the tagged VLAN list of interface. If
            ONU can not find the VLAN in the tagged VLAN list of interface, test
            will fail."
        DEFVAL { 0 }
        ::= { zxAnPonRmOnuPppoeTestEntry 1 }

    zxAnPonRmPppoeTestUsername  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..64))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The user name.max size is 64 for epon, 25 for gpon"
        ::= { zxAnPonRmOnuPppoeTestEntry 2 }

    zxAnPonRmPppoeTestPassword  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The password.max size is 32 for EPON, 25 for GPON"
        ::= { zxAnPonRmOnuPppoeTestEntry 3 }

    zxAnPonRmPppoeTestAuthMode  OBJECT-TYPE
        SYNTAX      INTEGER {
            auto(1),
            chap(2),
            pap(3)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The protocol that is used to anthenticate user."
        DEFVAL { auto }
        ::= { zxAnPonRmOnuPppoeTestEntry 4 }

    zxAnPonRmPppoeTestAction OBJECT-TYPE
        SYNTAX      INTEGER {
            start(1),
            stop(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The object is used to start or stop test.
             start(1) - Start the test.
             stop(2)  - Stop the test."
        ::= { zxAnPonRmOnuPppoeTestEntry 5 }

    zxAnPonRmPppoeTestStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            notStarted(1),
            inProgress(2),
            success(3),
            failed(4)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The status of test. Agent need keep this parameter updated so that
            manager can get the latest status of test by polling.

            notStarted(1) - test is not started
            inProgress(2) - test is in progress
            success(3) - test is completed successfully
            failed(4) - test failed."
        ::= { zxAnPonRmOnuPppoeTestEntry 6 }

    zxAnPonRmPppoeTestFailReason OBJECT-TYPE
        SYNTAX      INTEGER {
            none(1),
            unknownError(2),
            hardwareNotSupport(3),
            vlanNotExist(4),
            padiTimeOut(5),
            padrTimeOut(6),
            lcpNegotiationFail(7),
            userAuthFail(8),
            ipNegotiationFail(9)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed reason of test.

            none(1)               - no error
            unknownError(2)       - unknown error
            hardwareNotSupport(3) - Hardware does not support the test.
            notFindVlan(4)        - Specified VLAN is not existed.
            padiTimeOut(5)        - PADI request timed out.
            padrTimeOut(6)        - PADR request timed out.
            lcpNegotiationFail(7) - LCP negotiation failed.
            userAuthFail(8)       - User name or password is invalid.
            ipNegotiationFail(9)  - IP negotiation failed."
        ::= { zxAnPonRmOnuPppoeTestEntry 7 }



