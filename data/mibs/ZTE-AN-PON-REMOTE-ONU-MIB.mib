-- 12.2 zxAnPonRmGfastLnInventoryTable
-- ITU-T G.988 9.7.56 FAST line inventory and status data
-- ITU-T G.997.2, clause 7.13.2
--------------------------------------------------------------------------------    
    zxAnPonRmGfastLnInventoryTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmGfastLnInventoryEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The G.fast line inventory table."  
        REFERENCE
            "G.988 9.7.56 FAST line inventory and status data."          
        ::= { zxAnPonRmGfastLineObjects 3 }

    zxAnPonRmGfastLnInventoryEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmGfastLnInventoryEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The G.fast line Inventory entry."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex }
        ::= { zxAnPonRmGfastLnInventoryTable 1 }

    ZxAnPonRmGfastLnInventoryEntry  ::= SEQUENCE {        
        zxAnPonRmGfastLInvDpuSysVendorId     OCTET STRING,
        zxAnPonRmGfastLInvNtSysVendorId      OCTET STRING,
        zxAnPonRmGfastLInvDpuSysSn           OCTET STRING,
        zxAnPonRmGfastLInvNtSysSn            OCTET STRING   
        }

    zxAnPonRmGfastLInvDpuSysVendorId  OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(8))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Reports the DPU system vendor ID as inserted by the FTU-O in the
             embedded operations channel (see clause 11.2.2.10/G.9701) and
             as defined in clause 9.3.3.1/G.994.1."
        REFERENCE
            "ITU-T G.988 9.7.56 FAST line inventory and status data,
             ITU-T G.997.2, paragraph #7.13.2.1"
        ::= { zxAnPonRmGfastLnInventoryEntry 1 }

    zxAnPonRmGfastLInvNtSysVendorId  OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(8))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Reports the NT system vendor ID as inserted by the FTU-R in th
             embedded operations channel (see clause 11.2.2.10/G.9701) and
             as defined in clause 9.3.3.1/G.994.1."
        REFERENCE
           "ITU-T G.988 9.7.56 FAST line inventory and status data,
            ITU-T G.997.2, paragraph #7.13.2.2"                  
        ::= { zxAnPonRmGfastLnInventoryEntry 2 }

    zxAnPonRmGfastLInvDpuSysSn  OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(0..32))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Reports the DPU serial number as inserted by the FTU-O
             in the embedded operations channel (see clause 11.2.2.10/G.9701).
             It is vendor specific information. The combination of
             DPU system vendor ID and DPU system serial number
             creates a unique number for each DPU."
        REFERENCE   
            "ITU-T G.988 9.7.56 FAST line inventory and status data,
             ITU-T G.997.2, paragraph #7.13.2.3"                
        ::= { zxAnPonRmGfastLnInventoryEntry 3 }

    zxAnPonRmGfastLInvNtSysSn  OBJECT-TYPE
        SYNTAX      OCTET STRING  (SIZE(0..32))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Reports the NT system serial number as inserted by the FTU-R
             in the embedded operations channel (see clause 11.2.2.10/G.9701).
             It shall contain the NT system serial number, the NT model and
             the NT firmware version.
             All shall be encoded in this order and separated by space 
             characters, i.e.,
             <NT serial number><space><NT model><space><NT firmware version>.
             The combination of NT system vendor ID and NT system serial number
             creates a unique number for each NT."
        REFERENCE
            "ITU-T G.988 9.7.56 FAST line inventory and status data,
             ITU-T G.997.2, paragraph #7.13.2.4"
        ::= { zxAnPonRmGfastLnInventoryEntry 4 }

--------------------------------------------------------------------------------
-- 12.3 zxAnPonRmGfastLnConfPrfTable
--------------------------------------------------------------------------------
    zxAnPonRmGfastLnConfPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmGfastLnConfPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "G.fast line configuration profile table."
        ::= { zxAnPonRmGfastLineObjects 4 }

    zxAnPonRmGfastLnConfPrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmGfastLnConfPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "G.fast line configuration profile entry."
        INDEX  { zxAnPonRmGfastLnConfPrfName }
        ::= { zxAnPonRmGfastLnConfPrfTable 1 }

    ZxAnPonRmGfastLnConfPrfEntry  ::= SEQUENCE {
        zxAnPonRmGfastLnConfPrfName       DisplayString,        
        zxAnPonRmGfastLnDsDataRatePrf     DisplayString,
        zxAnPonRmGfastLnUsDataRatePrf     DisplayString,
        zxAnPonRmGfastLnSpectrumPrf       DisplayString,
        zxAnPonRmGfastLnSnrMarginPrf      DisplayString,
        zxAnPonRmGfastLnInpDelayPrf       DisplayString,
        zxAnPonRmGfastLnTotalSymbPeriods  INTEGER,
        zxAnPonRmGfastLnSymbPositionsDs   Integer32,
        zxAnPonRmGfastLnConfPrfRowStatus  RowStatus
        }

    zxAnPonRmGfastLnConfPrfName OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "G.fast line configuration profile name."
        ::= { zxAnPonRmGfastLnConfPrfEntry 1 }  
        
    zxAnPonRmGfastLnDsDataRatePrf  OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(0..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Refers to 'zxAnPonRmGfastDsDRPrfName'. The empty string 
             indicates that no downstream data rate profile is specified."
        DEFVAL  { "" }
        ::= { zxAnPonRmGfastLnConfPrfEntry 2 }

    zxAnPonRmGfastLnUsDataRatePrf  OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(0..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Refers to 'zxAnPonRmGfastUsDRPrfName'. The empty string 
             indicates that no upstream data rate profile is specified."
        DEFVAL  { "" }
        ::= { zxAnPonRmGfastLnConfPrfEntry 3 }

    zxAnPonRmGfastLnSpectrumPrf  OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(0..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Refers to 'zxAnPonRmGfastSPrfName'. The empty string 
             indicates that no spectrum profile is specified."
        DEFVAL  { "" }
        ::= { zxAnPonRmGfastLnConfPrfEntry 4 }

    zxAnPonRmGfastLnSnrMarginPrf OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Refers to 'zxAnPonRmGfastSnrmPrfName'. The empty string 
             indicates that no SNR margin profile is specified."
        DEFVAL { "" } 
        ::= { zxAnPonRmGfastLnConfPrfEntry 5 }  
     
    zxAnPonRmGfastLnInpDelayPrf OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Refers to 'zxAnPonRmGfastIDPrfName'. The empty string 
             indicates that no INP or delay profile is specified."
        DEFVAL { "" } 
        ::= { zxAnPonRmGfastLnConfPrfEntry 6 }
        
    zxAnPonRmGfastLnTotalSymbPeriods      OBJECT-TYPE
        SYNTAX      INTEGER {
            mf23(1),
            mf36(2)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Total symbol periods in a TDD frame.
             mf23(1) - A TDD frame has 23 symbol periods.
             mf36(2) - A TDD frame has 36 symbol periods."
        REFERENCE   
            "ITU-T G.997.2, paragraph #7.1.1.1,
             G.988 9.7.49 FAST line configuration profile part 1"
        DEFVAL  { mf36 }
        ::= { zxAnPonRmGfastLnConfPrfEntry 7 }

    zxAnPonRmGfastLnSymbPositionsDs      OBJECT-TYPE
        SYNTAX      Integer32(6..32)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The number of downstream symbol positions (Mds) that is the same as
             the value assigned for the active lines in a TDD frame.
             The value ranges from 6 to 19, when 
             zxAnPonRmGfastLnTotalSymbPeriods is mf23(1).
             The value ranges from 10 to 32, when 
             zxAnPonRmGfastLnTotalSymbPeriods is mf36(2)."
        REFERENCE   
            "ITU-T G.997.2, paragraph #7.1.1.2,
             G.988 9.7.49 FAST line configuration profile part 1"
        DEFVAL  { 28 }
        ::= { zxAnPonRmGfastLnConfPrfEntry 8 }    

    zxAnPonRmGfastLnConfPrfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
             The state of this conceptual row only support
             'not exist' and  'active'.
             The action of this conceptual row only support
             'createAndGo' and 'destroy'.
        
             To create a row in this table, a manager must
             set this object to createAndGo(4), and must comply
             with the multi-variables usage rules in 
             'zxAnPonRmGfastLnConfPrfEntry' description.
        
             To delete a row in this table, a manager must
             set this object to destroy(6).
        
             To query this object, always return 1. "
        ::= { zxAnPonRmGfastLnConfPrfEntry 50 }       
        
--------------------------------------------------------------------------------
-- 12.4 zxAnPonRmGfastLnConfTable
--------------------------------------------------------------------------------
    zxAnPonRmGfastLnConfTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmGfastLnConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "G.fast line configuration table. The index 'zxAnPonRmOnuUniIndex' 
             of this table only supports xDSL UNI."
        ::= { zxAnPonRmGfastLineObjects 5 }

    zxAnPonRmGfastLnConfEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmGfastLnConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "G.fast line configuration entry. The index 'zxAnPonOnuIndex' 
             represents the normal ONU index or the virtual ONU index 
             for profile."
        INDEX   { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex }
        ::= { zxAnPonRmGfastLnConfTable 1 }
               
    ZxAnPonRmGfastLnConfEntry ::=
        SEQUENCE {
            zxAnPonRmGfastLnConfPrf            DisplayString,
            zxAnPonRmGfastLnConfRowStatus      RowStatus
        } 
        
    zxAnPonRmGfastLnConfPrf OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Refers to 'zxAnPonRmGfastLnConfPrfName'."
        ::= { zxAnPonRmGfastLnConfEntry 1 }   
        
    zxAnPonRmGfastLnConfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must
            set this object to createAndGo(4), and must comply
            with the multi-variables usage rules in 'zxAnPonRmGfastLnConfEntry'
            description.
        
            To delete a row in this table, a manager must
            set this object to destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmGfastLnConfEntry 50 }
                                                                                                                                                                                                                                  
--------------------------------------------------------------------------------
--  zxAnPonRmOnuConformance                                                          
--------------------------------------------------------------------------------
zxAnPonRmOnuConformance       OBJECT IDENTIFIER ::= { zxAnPonRemoteOnuMib 4}        
                                                                            
zxAnPonRmOnuCompliances       OBJECT IDENTIFIER ::= {zxAnPonRmOnuConformance 1}     
zxAnPonRmOnuGroups            OBJECT IDENTIFIER ::= {zxAnPonRmOnuConformance 2}   

zxAnPonRmOnuCompliance MODULE-COMPLIANCE
    STATUS current
    DESCRIPTION
        "The compliance statement for entities which implement the
         ZTE-AN-PON-REMOTE-ONU-MGMT-MIB."
    MODULE
    MANDATORY-GROUPS{   
                    zxAnPonRmOnuProtocolGroup,
                    zxAnPonRmOnuVoipGroup,
                    zxAnPonRmOnuCliOverSnmpGroup,
                    zxAnPonRmOnuCfgGroup,
                    zxAnPonRmOnuWifiGroup,
                    zxAnPonRmOnuCfmGroup,
                    zxAnPonRmOnuOamGroup,
                    zxAnPonRmOnuXdslGroup,
                    zxAnPonRmOnuGfastGroup
                    }
    ::= { zxAnPonRmOnuCompliances 1 }  
--------------------------------------------------------------------------------
-- Units of Conformance
--------------------------------------------------------------------------------     
zxAnPonRmOnuProtocolGroup OBJECT-GROUP
    OBJECTS         { 
                     zxAnPonRmProtoPktsLimitArp,       
                     zxAnPonRmProtoPktsLimitDhcp,      
                     zxAnPonRmProtoPktsLimitPppoe,     
                     zxAnPonRmProtoPktsLimitIgmp,      
                     zxAnPonRmProtoPktsLimitCfm,       
                     zxAnPonRmProtoPktsLimitRowstatus,   
                     zxAnPonRmDhcpRelayEnable,      
                     zxAnPonRmDhcpOption82Enable,   
                     zxAnPonRmPppoeIntermediateEnable,
                     zxAnPonRmArpInspectionEnable,  
                     zxAnPonRmIptvAgeByLeaseEnable, 
                     zxAnPonRmProtoEnableRowstatus,
