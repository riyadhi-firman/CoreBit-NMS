-- 11.5 zxAnPonRmGfastInpDelayPrfTable
-- ITU-T G.988 9.7.53 INP and delay configuration profile
-- ITU-T G.997.2, clause 7.2.2
--------------------------------------------------------------------------------
    zxAnPonRmGfastInpDelayPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmGfastInpDelayPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "INP and delay configuration profile table."
        ::= { zxAnPonRmGfastLineProfileObjects 6 }

    zxAnPonRmGfastInpDelayPrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmGfastInpDelayPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "INP and delay configuration profile entry."
        INDEX  { zxAnPonRmGfastIDPrfName }
        ::= { zxAnPonRmGfastInpDelayPrfTable 1 }

    ZxAnPonRmGfastInpDelayPrfEntry  ::= SEQUENCE {
        zxAnPonRmGfastIDPrfName          DisplayString,
        zxAnPonRmGfastIDRnRatioDs        Integer32,
        zxAnPonRmGfastIDRnRatioUs        Integer32,
        zxAnPonRmGfastIDMaxDelayDs       Integer32,
        zxAnPonRmGfastIDMaxDelayUs       Integer32,
        zxAnPonRmGfastIDMinInpShineDs    Integer32,
        zxAnPonRmGfastIDMinInpShineUs    Integer32,
        zxAnPonRmGfastIDShineRatioDs     Integer32,
        zxAnPonRmGfastIDShineRatioUs     Integer32,
        zxAnPonRmGfastIDInpMinReinDs     Integer32,
        zxAnPonRmGfastIDInpMinReinUs     Integer32,
        zxAnPonRmGfastIDIatReinDs        INTEGER,
        zxAnPonRmGfastIDIatReinUs        INTEGER,
        zxAnPonRmGfastIDPrfRowStatus     RowStatus
        }

    zxAnPonRmGfastIDPrfName  OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "INP and delay configuration profile name."
        ::= { zxAnPonRmGfastInpDelayPrfEntry 1 }

    zxAnPonRmGfastIDRnRatioDs  OBJECT-TYPE
        SYNTAX      Integer32(0..8)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream minimal required ratio, RFEC/NFEC, of Reed-Solomon code
             parameters.
             The G.9701 control parameter rnratio is set to the same value as
             the Minimum Reed-Solomon RFEC/NFEC ratio (see clause
             11.4.2.8/G.9701).

             This data format supports a range from 0 to 0.25 with granularity
             of 0.03125."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.6"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 2 }

    zxAnPonRmGfastIDRnRatioUs  OBJECT-TYPE
        SYNTAX      Integer32(0..8)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream minimal required ratio, RFEC/NFEC, of Reed-Solomon code
             parameters.
             The G.9701 control parameter rnratio is set to the same value as
             the Minimum Reed-Solomon RFEC/NFEC ratio (see clause
             11.4.2.8/G.9701).

             This data format supports a range from 0 to 0.25 with granularity
             of 0.03125."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.6"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 3 }

    zxAnPonRmGfastIDMaxDelayDs  OBJECT-TYPE
        SYNTAX      Integer32(4..252)
        UNITS       "0.25Milliseconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream maximum allowed delay for retransmission (see clause
             9.8/G.9701).
             The G.9701 control parameter delay_max is set to the same value as
             the maximum delay (see clause 11.4.2.3/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.1"
        DEFVAL  { 40 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 4 }

    zxAnPonRmGfastIDMaxDelayUs  OBJECT-TYPE
        SYNTAX      Integer32(4..252)
        UNITS       "0.25Milliseconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream maximum allowed delay for retransmission (see clause
             9.8/G.9701).
             The G.9701 control parameter delay_max is set to the same value as
             the maximum delay (see clause 11.4.2.3/G.9701)."
       REFERENCE   
           "ITU-T G.988 9.7.52 FAST channel config profile,
            ITU-T G.997.2, paragraph #7.2.2.1"
       DEFVAL  { 40 }
       ::= { zxAnPonRmGfastInpDelayPrfEntry 5 }

    zxAnPonRmGfastIDMinInpShineDs  OBJECT-TYPE
        SYNTAX      Integer32(0..520)
        UNITS       "Symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream minimum impulse noise protection against SHINE (see
             clause 9.8/G.9701). The G.9701 control parameter INP_min_shine is
             set to the same value as the minimum impulse noise protection
             against SHINE (see clause 11.4.2.4/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.2"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 6 }

    zxAnPonRmGfastIDMinInpShineUs  OBJECT-TYPE
        SYNTAX      Integer32(0..520)
        UNITS       "Symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream minimum impulse noise protection against SHINE (see clause
             9.8/G.9701). The G.9701 control parameter INP_min_shine is set to
             the same value as the minimum impulse noise protection against
             SHINE (see clause 11.4.2.4/G.9701)."
        REFERENCE    
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.2"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 7 }

    zxAnPonRmGfastIDShineRatioDs  OBJECT-TYPE
        SYNTAX      Integer32(0..100)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream SHINE ratio that is used in the definition of the
             expected throughput rate (ETR) (see clause 9.8/G.9701).
             The G.9701 control parameter SHINEratio is set to the same value
             as the SHINE ratio (see clause 11.4.2.5/G.9701).

             This data format supports a range from 0 to 0.1 with granularity
             of 0.001."
       REFERENCE   
           "ITU-T G.988 9.7.52 FAST channel config profile,
            ITU-T G.997.2, paragraph #7.2.2.3"
       DEFVAL  { 0 }
       ::= { zxAnPonRmGfastInpDelayPrfEntry 8 }

    zxAnPonRmGfastIDShineRatioUs  OBJECT-TYPE
        SYNTAX      Integer32(0..100)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream SHINE ratio that is used in the definition of the expected
             throughput rate (ETR) (see clause 9.8/G.9701).
             The G.9701 control parameter SHINEratio is set to the same value
             as the SHINE ratio (see clause 11.4.2.5/G.9701).

             This data format supports a range from 0 to 0.1 with granularity
             of 0.001."
        REFERENCE    
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.3"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 9 }

    zxAnPonRmGfastIDInpMinReinDs  OBJECT-TYPE
        SYNTAX      Integer32(0..63)
        UNITS       "Symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream minimum impulse noise protection against REIN (see
             clause 9.8/G.9701). The G.9701 control parameter INP_min_rein
             is set to the same value as the minimum impulse noise protection
             against REIN (see clause 11.4.2.6/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.4"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 10 }

    zxAnPonRmGfastIDInpMinReinUs  OBJECT-TYPE
        SYNTAX      Integer32(0..63)
        UNITS       "Symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream minimum impulse noise protection against REIN (see
             clause 9.8/G.9701). The G.9701 control parameter INP_min_rein
             is set to the same value as the minimum impulse noise protection
             against REIN (see clause 11.4.2.6/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.4"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 11 }

    zxAnPonRmGfastIDIatReinDs  OBJECT-TYPE
        SYNTAX      INTEGER {
            iatRein100Hz(1),
            iatRein120Hz(2),
            iatRein360Hz(3)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream REIN inter-arrival time (see clause 9.8/G.9701).
             The G.9701 control parameter iat_rein_flag is set to the same
             value as the the REIN inter-arrival time (see clause
             11.4.2.7/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.5"
        DEFVAL  { iatRein100Hz }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 12 }

    zxAnPonRmGfastIDIatReinUs  OBJECT-TYPE
        SYNTAX      INTEGER {
            iatRein100Hz(1),
            iatRein120Hz(2),
            iatRein360Hz(3)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream REIN inter-arrival time (see clause 9.8/G.9701).
             The G.9701 control parameter iat_rein_flag is set to the same
             value as the the REIN inter-arrival time (see clause
             11.4.2.7/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.52 FAST channel config profile,
             ITU-T G.997.2, paragraph #7.2.2.5"
        DEFVAL  { iatRein100Hz }
        ::= { zxAnPonRmGfastInpDelayPrfEntry 13 }

    zxAnPonRmGfastIDPrfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.

             The supported actions of this conceptual row only include:
             'createAndGo' and 'destroy'.

             To create a row in this table, a manager must set this object to
             createAndGo(4), and must comply with the multi-variables binding
             rule described in zxAnPonRmGfastInpDelayPrfEntry.

             To delete a row in this table, a manager must set this object to
             destroy(6).

             To get this object, the agent always returns active(1)."
        ::= { zxAnPonRmGfastInpDelayPrfEntry 50 }

