    }

    zxAnPonRmCalleeTestDuration OBJECT-TYPE
        SYNTAX      Integer32(60..300)
        UNITS       "seconds"
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The duration of test. Agent should stop test following regular
            on-hook procedure, if the test hasn't completed after duration yet."
        DEFVAL{ 90 }
        ::= { zxAnPonRmOnuVoipCalleeTestEntry 1 }

    zxAnPonRmCalleeTestMaxRingTime OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "seconds"
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The max ring time of test."
        DEFVAL{4}
        ::= { zxAnPonRmOnuVoipCalleeTestEntry 2 }

    zxAnPonRmCalleeTestPortStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            idle(1),
            ringing(2),
            offHook(3),
            connected(4),
            busyTone(5),
            onHook(6)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This object indicates the current status of port.

            idle(1) - The state of port is idle.
            ringing(2) - The state of port is ringing.
            offHook(3) - The state of port is off-hook.
            connected(4) - Voice data path is established. The port can receive
            and send voice data.
            busyTone(5) - The port is playing busy tone.
            onHook(6) - The state of port is on-hook.
            "
        ::= { zxAnPonRmOnuVoipCalleeTestEntry 3 }
        
    zxAnPonRmCalleeTestAction OBJECT-TYPE
        SYNTAX      INTEGER {
            start(1),
            stop(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The object is used to start or stop test.
            start(1) - Start the test.
            stop(2) - Stop the test. Agent should stop test following regular
            on-hook procedure.
            "
        ::= { zxAnPonRmOnuVoipCalleeTestEntry 4 }    
        
    zxAnPonRmCalleeTestStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            notStarted(1),
            inProgress(2),
            success(3),
            failed(4)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The status of test. Agent need keep this parameter updated so that
            manager can get the latest status of test by polling.

            notStarted(1) - Test is not started.
            inProgress(2) - Test is in progress.
            success(3) - Test is successful. It means that the voice path of
            call is well, while the on-hook operation is successful.
            failed(4) - Test failed.
            "
        ::= { zxAnPonRmOnuVoipCalleeTestEntry 5 }            

    zxAnPonRmCalleeTestFailReason OBJECT-TYPE
        SYNTAX      INTEGER {
            other(1),
            noRing(2),
            noUpstreamVoice(3),
            noDownstreamVoice(4),
            noBidirectionVoice(5)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed reason of test.

            other(1) - Other reason.
            noRing(2) - No ringing.
            noUpstreamVoice(3) - No upstream voice.
            noDownstreamVoice(4) - No downstream voice.
            noBidirectionVoice(5) - No upstream and downstream voice.
            "
        ::= { zxAnPonRmOnuVoipCalleeTestEntry 6 }

    zxAnPonRmCalleeTestFailDetail OBJECT-TYPE
        SYNTAX      DisplayString (SIZE (0..255))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed detail. This field should be filled when the value of
            zxAnPonRmCalleeTestFailReason is 'other'."
        ::= { zxAnPonRmOnuVoipCalleeTestEntry 7 }


--------------------------------------------------------------------------------
--  zxAnPonRmOnuVoipCallerTestTable
--------------------------------------------------------------------------------

    zxAnPonRmOnuVoipCallerTestTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuVoipCallerTestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The table lists caller test entry. The entry indicates a test."
        REFERENCE
            "GPON in ZXPON ZTE private OMCI & PLOAM Specification 3.8.3;
            EPON in ZXPON ZTE private extended OAM Specification 3.3.5"
        ::= { zxAnPonRmOnuOamObjects 6 }

    zxAnPonRmOnuVoipCallerTestEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuVoipCallerTestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "An entry in the zxAnPonRmOnuVoipCallerTestTable."
        INDEX       { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuIfIndex}
        ::= { zxAnPonRmOnuVoipCallerTestTable 1 }

    ZxAnPonRmOnuVoipCallerTestEntry ::= SEQUENCE {
        zxAnPonRmCallerTestTimeout        Integer32,
        zxAnPonRmCallerTestDialedNumber   DisplayString,
        zxAnPonRmCallerTestPortStatus     INTEGER,
        zxAnPonRmCallerTestDelay          Integer32,
        zxAnPonRmCallerTestSipFailReason  INTEGER,
        zxAnPonRmCallerTestSipErrorCode   INTEGER,
        zxAnPonRmCallerTestAction         INTEGER,
        zxAnPonRmCallerTestStatus         INTEGER,
        zxAnPonRmCallerTestFailReason     INTEGER,
        zxAnPonRmCallerTestFailDetail     DisplayString
    }

    zxAnPonRmCallerTestTimeout OBJECT-TYPE
        SYNTAX      Integer32(60..300)
        UNITS       "seconds"
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The time-out of test. Agent should stop test following regular
            on-hook procedure, if the test hasn't completed after time-out yet."
        DEFVAL{ 90 }
        ::= { zxAnPonRmOnuVoipCallerTestEntry 1 }

    zxAnPonRmCallerTestDialedNumber OBJECT-TYPE
        SYNTAX      DisplayString (SIZE (0..64))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The number that user dials.
            The max size is 64 for EPON ,20 for GPON.
            "
        ::= { zxAnPonRmOnuVoipCallerTestEntry 2 }

    zxAnPonRmCallerTestPortStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            idle(1),
            offHook(2),
            dialTone(3),
            receiveNumber(4),
            receiveEnd(5),
            ringBackTone(6),
            connected(7),
            busyTone(8),
            onHook(9)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This object indicates the current status of port.

            idle(1) - The state of port is idle.
            offHook(2) - The state of port is off-hook.
            dialTone(3) - The port is playing dial tone.
            receiveNumber(4) - The port is receiving number.
            receiveEnd(5) - Receiving number ended.
            ringBackTone(6) - The port is playing ring back tone.
            connected(7) - Voice data path is established. The port can receive
            and send voice data.
            busyTone(8) - The port is playing busy tone.
            onHook(9) - The state of port is on-hook.
            "
        ::= { zxAnPonRmOnuVoipCallerTestEntry 3 }

    zxAnPonRmCallerTestDelay OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "0.1second"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Specifies how long it takes to set up bearer traffic RTP packets
            for the POTS line being tested in tenths of a second.The delay
            measure timer starts when the INVITE is generated for a call
            origination to the phone number specified by the PHONENO
            parameter in the DGN-SIPDIALTONE TL1 command. The SIP
            application at the ONU starts listening for RTP packets. If RTP
            packets are detected, the delay measure timer is stopped and
            the timer value is recorded for later reporting. Range for measure
            post dial delay is 0.0 to 6553.5 in tenths of seconds."
        ::= { zxAnPonRmOnuVoipCallerTestEntry 4 }

    zxAnPonRmCallerTestSipFailReason  OBJECT-TYPE
        SYNTAX      INTEGER {
            dialToneTestFailure(1),
            inviteOkButNoBearerData(2),
            callTimeoutNo200Ok(3),
            noResponseToInvite(4),
            errorCodeAndReasonPhrase(5),
            callCancelledByServer(6),
            callCancelledByOnt(7),
            lineNotConfigured(8),
            lineNotInValidState(9),
            lineNotRegistered(10),
            notchFiltersRequired(11)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed reason of SIP test. This field should be filled when the
            value of zxAnPonRmCallerTestFailReason is 'sipTestFailed'.

            dialToneTestFailure(1) - Dial tone test failure.
            inviteOkButNoBearerData(2) - No bearer traffic was received even
            though the test call was successful.
            callTimeoutNo200Ok(3) - The test call never completed although
            provisional response were received for the INVITE request.
            noResponseToInvite(4) - No response was received to the INVITE
            request and attempts to retry the INVITE timed out without a
            response.
            errorCodeAndReasonPhrase(5) - The softswitch returned an error to
            the INVITE request.
            callCancelledByServer(6) - The softswitch sent a CANCEL for the
            INVITE transaction.
            callCancelledByOnt(7) - The call was cancelled by the ONT.
            lineNotConfigured(8) - The POTS line is not fully configured,
            probably due to missing SIP provisioning data.
            lineNotInValidState(9)- The POTS line is in the wrong status to
            perform the test.
            lineNotRegistered(10) - The POTS line is not registered with the
            softswitch.
            notchFiltersRequired(11) - The notch filter settings in the
            configuration profile analog data were missing.
            "
        ::= { zxAnPonRmOnuVoipCallerTestEntry 5 }

    zxAnPonRmCallerTestSipErrorCode OBJECT-TYPE
        SYNTAX      INTEGER {
            unauthorized(1),
            forbidden(2),
            notFound(3),
            proxyAuthenticationRequired(4),
            requestTimeout(5),
            temporarilyUnavailable(6),
            addressIncomplete(7),
            busyHere(8),
            requestTerminated(9),
            notAcceptableHere(10),
            serverInternalError(11),
            serviceUnavailable(12),
            serverTimeout(13)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The error code of SIP test. This field should be filled when the
            value of zxAnPonRmCallerTestSipFailReason is
            'errorCodeAndReasonPhrase'.

            unauthorized(1) - 401 Unauthorized.
            forbidden(2) - 403 Forbidden.
            notFound(3) - 404 Not found.
            proxyAuthenticationRequired(4) - 407 Proxy authentication required.
            requestTimeout(5) - 408 Request timeout.
            temporarilyUnavailable(6) - 480 Temporarily unavailable.
            addressIncomplete(7) - 484 Address incomplete.
            busyHere(8) - 486 Busy here.
            requestTerminated(9) - 487 Request terminated.
            notAcceptableHere(10) - 488 Not acceptable here.
            serverInternalError(11) - 500 Server internal error.
            serviceUnavailable(12) - 503 Service unavailable.
            serverTimeout(13) - 504 Server time-out.
            "
        ::= { zxAnPonRmOnuVoipCallerTestEntry 6 }

    zxAnPonRmCallerTestAction OBJECT-TYPE
        SYNTAX      INTEGER {
            start(1),
            stop(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The object is used to start or stop test.

            start(1) - Start the test.
            stop(2) - Stop the test. Agent should stop test following regular
            on-hook procedure.
            "
        ::= { zxAnPonRmOnuVoipCallerTestEntry 7 }
        
        
    zxAnPonRmCallerTestStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            notStarted(1),
            inProgress(2),
            success(3),
            failed(4),
            notForced(5)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The status of test. Agent need keep this parameter updated so that
            manager can get the latest status of test by polling.

            notStarted(1) - Test is not started.
            inProgress(2) - Test is in progress.
            success(3) - Test is successful. It means that the voice path of
            call is well, while the on-hook operation is successful.
            failed(4) - Test failed.
            notForced(5)  - Test is not attempted because the POTS line is busy.
            "
        ::= { zxAnPonRmOnuVoipCallerTestEntry 8 }
        
    zxAnPonRmCallerTestFailReason OBJECT-TYPE
        SYNTAX      INTEGER {
            other(1),
            noDialTone(2),
            noRingBack(3),
            noAnswer(4),
            noUpstreamVoice(5),
            noDownstreamVoice(6),
            noBidirectionVoice(7),
            sipTestFailed(8)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed reason of test.

            other(1) - Other reason.
            noDialTone(2) - No dial tone.
            noRingBack(3) - No ring back tone.
            noAnswer(4) - No answer.
            noUpstreamVoice(5) - No upstream voice.
            noDownstreamVoice(6) - No downstream voice.
            noBidirectionVoice(7) - No upstream and downstream voice.
            sipTestFailed(8) - SIP test failed.
            "
        ::= { zxAnPonRmOnuVoipCallerTestEntry 9 }
        

    zxAnPonRmCallerTestFailDetail OBJECT-TYPE
        SYNTAX      DisplayString (SIZE (0..255))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed detail. This field should be filled when the value of
            zxAnOnuVoipCallerTestFailReason is 'other'."
        ::= { zxAnPonRmOnuVoipCallerTestEntry 10 }

--------------------------------------------------------------------------------
-- zxAnPonRmOnuOTransceiversTable
--------------------------------------------------------------------------------
    zxAnPonRmOnuOTransceiversTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuOTransceiversEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers table."
        ::= { zxAnPonRmOnuOamObjects 7 }

    zxAnPonRmOnuOTransceiversEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuOTransceiversEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers entry."
        INDEX   { ifIndex, zxAnPonOnuIndex }
        ::= { zxAnPonRmOnuOTransceiversTable 1 }

    ZxAnPonRmOnuOTransceiversEntry ::=
        SEQUENCE {            
            zxAnPonRmOnuOTSpeedMode              INTEGER,
            zxAnPonRmOnuOTOdnType                INTEGER,
            zxAnPonRmOnuOTApplicableDevType      INTEGER,            
            zxAnPonRmOnuOTEncapsulationType      INTEGER,
            zxAnPonRmOnuOTTxWavelength           Integer32,
            zxAnPonRmOnuOTRxWavelength           Integer32,
            zxAnPonRmOnuOTVendorName             DisplayString,
            zxAnPonRmOnuOTVendorPn               DisplayString,
            zxAnPonRmOnuOTVendorSn               DisplayString
            } 
    
    zxAnPonRmOnuOTSpeedMode OBJECT-TYPE
        SYNTAX      INTEGER{
            gpon(1),
            xgpon(2),
            xgspon(3),
            epon(11),
            oneGAndTenGEpon(12),
            tenGAnd10GEpon(13),
            unknown(255)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers speed mode.
             The following values are valid for GPON:
                 gpon(1): GPON,
                 xgpon(2): XG-PON,
                 xgspon(3): XGS-PON,
                 unknown(255): unknown.
             The following values are valid for EPON:
                 oneG(11): EPON,
                 oneGAndTenGEpon(12): 1G/10G-EPON, 
                 tenGAnd10GEpon(13): 10G/10G-EPON,
                 unknown(255): unknown."
        ::= { zxAnPonRmOnuOTransceiversEntry 1 }  
        
    zxAnPonRmOnuOTOdnType OBJECT-TYPE
        SYNTAX      INTEGER{
            classBplusAndCplus(1),
            n1AndN2aAndE1AndE2a(2),
            n2bAndE2b(3),
            n1AndN2AndE1(4),
            px20(51),
            px20plus(52),
            prx30(53),
            pr30(54),
            prx40(55),
            pr40(56),
            unknown(255)            
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers ODN type.
             The following values are valid for GPON:
                 classBplusAndCplus(1): Class B+/C+,
                 n1AndN2aAndE1AndE2a(2): N1/N2a/E1/E2a,
                 n2bAndE2b(3): N2b/E2b,
                 n1AndN2AndE1(4): N1/N2/E1.
             The following values are valid for EPON:
                 px20(51): PX20,
                 px20plus(52): PX20+,
                 prx30(53): PRX30,
                 pr30(54): PR30,
                 prx40(55): PRX40,
                 pr40(56): PR40,
                 unknown(255): unknown."
        ::= { zxAnPonRmOnuOTransceiversEntry 2 }

    zxAnPonRmOnuOTApplicableDevType OBJECT-TYPE
        SYNTAX      INTEGER{
            onu(1),
            unknown(255)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers applicable device type."
        ::= { zxAnPonRmOnuOTransceiversEntry 3 } 

    zxAnPonRmOnuOTEncapsulationType OBJECT-TYPE
        SYNTAX      INTEGER{
            sfpAndsfpplus(1),
            xfp(2),
            unknown(255)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers encapsulation type.
             sfpAndsfpplus(1): SFP/SFP+,
             xfp(2): XFP,
             unknown(255): unknown."
        ::= { zxAnPonRmOnuOTransceiversEntry 4 } 

    zxAnPonRmOnuOTTxWavelength OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "nm"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers transmitted wavelength."
        ::= { zxAnPonRmOnuOTransceiversEntry 5 }
        
    zxAnPonRmOnuOTRxWavelength OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "nm"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers received wavelength."
        ::= { zxAnPonRmOnuOTransceiversEntry 6 } 

    zxAnPonRmOnuOTVendorName OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..16))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers vendor name."
        ::= { zxAnPonRmOnuOTransceiversEntry 7 }
         
    zxAnPonRmOnuOTVendorPn OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..16))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers vendor part number."
        ::= { zxAnPonRmOnuOTransceiversEntry 8 }
                
    zxAnPonRmOnuOTVendorSn OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..16))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "ONU optical transceivers vendor serial number."
        ::= { zxAnPonRmOnuOTransceiversEntry 9 }
        
-------------------------------------------------------------------------------
-- 10 zxAnPonRmOnuXdslObjects
-- 10.2 zxAnPonRmXdslDsDataRatePrfTable
-- G.988 9.7.7 xDSL channel configuration profile
-------------------------------------------------------------------------------
    zxAnPonRmXdslDsDataRatePrfTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslDsDataRatePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Downstream data rate configuration profile table."
        REFERENCE
           "G.988 9.7.7 xDSL channel configuration profile"
        ::= { zxAnPonRmOnuXdslObjects 2 }   

    zxAnPonRmXdslDsDataRatePrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslDsDataRatePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "xDSL channel configuration profile entry. Entries in the 
            zxAnPonRmXdslDsDataRatePrfTable are created and deleted using the 
            zxAnPonRmXdslDsChConfRowStatus object."
        INDEX  { zxAnPonRmXdslDsDataRatePrfName }
        ::= { zxAnPonRmXdslDsDataRatePrfTable 1 }   

    ZxAnPonRmXdslDsDataRatePrfEntry  ::=
        SEQUENCE { 
            zxAnPonRmXdslDsDataRatePrfName       DisplayString,
            zxAnPonRmXdslChRaRatioDs             Integer32,
            zxAnPonRmXdslChMinDataRateDs         Integer32,
            zxAnPonRmXdslChMaxDataRateDs         Integer32,
            zxAnPonRmXdslChUsDataRateDs          Integer32,
            zxAnPonRmXdslChDsDataRateDs          Integer32,
            zxAnPonRmXdslChMinResRateDs          Integer32,
            zxAnPonRmXdslChMinRateLowPwrDs       Integer32,
            zxAnPonRmXdslChMaxBerDs              Xdsl2MaxBer,
            zxAnPonRmXdslChMinSosBitRateDs       Integer32,
            zxAnPonRmXdslDsChConfRowStatus       RowStatus 
        }

    zxAnPonRmXdslDsDataRatePrfName OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Downstream data rate profile name."
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 1 } 

    zxAnPonRmXdslChRaRatioDs  OBJECT-TYPE
        SYNTAX      Integer32(0..100)
        UNITS       "percents"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Rate adaptation ratio.  
            This attribute specifies the weight that should be taken into 
            account when performing rate adaptation in the direction of the 
            bearer channel. The attribute is defined as a percentage in the 0 
            to 100 range. The value 20, for example, means that 20% of the 
            available data rate (in excess of the minimum data rate summed over 
            all bearer channels) is assigned to this bearer channel and 80% to 
            the other bearer channels. The OLT must assure that the sum of rate 
            adaptation ratios over all bearers in one direction is 100%. "
        REFERENCE
            "ITU-T G.997.1, paragraph 7.3.2.1"
        DEFVAL { 100 }
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 2 }     

    zxAnPonRmXdslChMinDataRateDs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum data rate on downstream direction. The minimum net
            data rate for the bearer channel, coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile."  
        DEFVAL { 32 }
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 3 }  

    zxAnPonRmXdslChMaxDataRateDs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum data rate on downstream direction. The maximum net
            data rate for the bearer channel, coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile."   
        DEFVAL { 120000 }                 
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 4 } 

    zxAnPonRmXdslChUsDataRateDs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Data rate threshold upshift on downstream direction.  
            An 'Up-shift rate change' event is triggered when the actual 
            downstream data rate exceeds, by more than the threshold, the data 
            rate at the last entry into showtime. 
            The parameter is coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.8.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 200000 }
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 5 }               

    zxAnPonRmXdslChDsDataRateDs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Data rate threshold downshift on downstream direction.  
            A 'Down-shift rate change' event is triggered when the actual
            downstream data rate is below the data rate at the last entry
            into showtime, by more than the threshold. 
            The parameter is coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.8.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 0 }                
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 6 }  

    zxAnPonRmXdslChMinResRateDs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum reserved data rate on downstream direction. 
            The minimum reserved net data rate for the bearer channel, coded in
            bit/s. This parameter is used only if the rate adaptation
            mode in the direction of the bearer channel (i.e.,
            zxAnPonRmXdslRaModeDs) is set to 'dynamicRa'."
        REFERENCE
            "ITU-T G.997.1, paragraph 7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 64 }
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 7 }   

    zxAnPonRmXdslChMinRateLowPwrDs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum data rate in low power state on downstream direction.
            The minimum net data rate for the bearer channel, coded in bit/s, 
            during the low power state (L1 in G.992.2, L2 in G.992.3)."
        REFERENCE
            "ITU-T G.997.1, paragraph 7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 128 }
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 8 } 

    zxAnPonRmXdslChMaxBerDs  OBJECT-TYPE
        SYNTAX      Xdsl2MaxBer
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum bit error ratio on downstream direction. The maximum
            bit error ratio for the bearer channel. The parameter can
            take the following values (for 1E-3, 1E-5 or 1E-7):
               eminus3 (1),
               eminus5 (2),
               eminus7 (3)"
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.6,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { eminus7 }
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 9 } 

    zxAnPonRmXdslChMinSosBitRateDs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This parameter specifies the minimum net data rate required for a
            valid SOS request in the downstream direction. 
            The value shall be coded as an unsigned integer representing the 
            data rate as a multiple of 8 kbit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.1.7,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 32 }
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 10 }                       

    zxAnPonRmXdslDsChConfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must set this object to 
            createAndGo(4), and must comply with the multi-variables usage rules
            in 'zxAnPonRmXdslDsDataRatePrfEntry' description.
        
            To delete a row in this table, a manager must set this object to 
            destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslDsDataRatePrfEntry 50 } 

-------------------------------------------------------------------------------
-- 10.3 zxAnPonRmXdslUsDataRatePrfTable
-- G.988 9.7.7 xDSL channel configuration profile
-------------------------------------------------------------------------------
    zxAnPonRmXdslUsDataRatePrfTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslUsDataRatePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Upstream data rate configuration profile table."
        REFERENCE
            "G.988 9.7.7 xDSL channel configuration profile"
        ::= { zxAnPonRmOnuXdslObjects 3 }   

    zxAnPonRmXdslUsDataRatePrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslUsDataRatePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "xDSL channel configuration profile entry. Entries in the 
            zxAnPonRmXdslUsDataRatePrfTable are created and deleted using the 
            zxAnPonRmXdslUsChConfRowStatus object."
        INDEX  { zxAnPonRmXdslUsDataRatePrfName }
        ::= { zxAnPonRmXdslUsDataRatePrfTable 1 }   

    ZxAnPonRmXdslUsDataRatePrfEntry  ::=
        SEQUENCE { 
            zxAnPonRmXdslUsDataRatePrfName       DisplayString,
            zxAnPonRmXdslChRaRatioUs             Integer32,
            zxAnPonRmXdslChMinDataRateUs         Integer32,
            zxAnPonRmXdslChMaxDataRateUs         Integer32,
            zxAnPonRmXdslChUsDataRateUs          Integer32,
            zxAnPonRmXdslChDsDataRateUs          Integer32,
            zxAnPonRmXdslChMinResRateUs          Integer32,
            zxAnPonRmXdslChMinRateLowPwrUs       Integer32,  
            zxAnPonRmXdslChMaxBerUs              Xdsl2MaxBer,
            zxAnPonRmXdslChMinSosBitRateUs       Integer32,
            zxAnPonRmXdslUsChConfRowStatus       RowStatus 
        }

    zxAnPonRmXdslUsDataRatePrfName OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Upstream data rate profile name."
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 1 }  

    zxAnPonRmXdslChRaRatioUs  OBJECT-TYPE
        SYNTAX      Integer32(0..100)
        UNITS       "percents"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Rate adaptation ratio.  
            This attribute specifies the weight that should be taken into 
            account when performing rate adaptation in the direction of the 
            bearer channel. The attribute is defined as a percentage in the 0 
            to 100 range. The value 20, for example, means that 20% of the 
            available data rate (in excess of the minimum data rate summed over 
            all bearer channels) is assigned to this bearer channel and 80% to 
            the other bearer channels. The OLT must assure that the sum of rate 
            adaptation ratios over all bearers in one direction is 100%. "
        REFERENCE
            "ITU-T G.997.1, paragraph 7.3.2.1"
        DEFVAL { 100 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 2 }    

    zxAnPonRmXdslChMinDataRateUs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum data rate on upstream direction. The minimum net
            data rate for the bearer channel, coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile."  
        DEFVAL { 32 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 3 }  

    zxAnPonRmXdslChMaxDataRateUs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum data rate on upstream direction. The maximum net
            data rate for the bearer channel, coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile."   
        DEFVAL { 120000 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 4 }  

    zxAnPonRmXdslChUsDataRateUs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Data rate threshold upshift on upstream direction. An
            'Up-shift rate change' event is triggered when the
            actual upstream data rate exceeds, by more than the threshold, the
            data rate at the last entry into showtime. The parameter is
            coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.8.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 200000 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 5 }               

    zxAnPonRmXdslChDsDataRateUs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Data rate threshold downshift on upstream direction. A
            'Down-shift rate change' event is triggered when the
            actual upstream data rate is below the data rate at the last entry
            into showtime, by more than the threshold. The parameter is
            coded in bit/s."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.8.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 0 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 6 }  

    zxAnPonRmXdslChMinResRateUs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum reserved data rate on upstream direction. The minimum
            reserved net data rate for the bearer channel, coded in
            bit/s. This parameter is used only if the rate adaptation
            mode in the direction of the bearer channel (i.e.,
            zxAnPonRmXdslRaModeUs) is set to 'dynamicRa'."
        REFERENCE
            "ITU-T G.997.1, paragraph 7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 64 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 7 }   

    zxAnPonRmXdslChMinRateLowPwrUs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum data rate in low power state on upstream direction.
            The minimum net data rate for the bearer channel, coded in bit/s, 
            during the low power state (L1 in G.992.2, L2 in G.992.3)."
        REFERENCE
            "ITU-T G.997.1, paragraph 7.3.2.1,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 128 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 8 } 

    zxAnPonRmXdslChMaxBerUs  OBJECT-TYPE
        SYNTAX      Xdsl2MaxBer
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum bit error ratio on upstream direction. The maximum
            bit error ratio for the bearer channel. The parameter can
            take the following values (for 1E-3, 1E-5 or 1E-7):
               eminus3 (1),
               eminus5 (2),
               eminus7 (3)"
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.6,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { eminus7 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 9 } 

    zxAnPonRmXdslChMinSosBitRateUs  OBJECT-TYPE
        SYNTAX      Integer32(0..200000)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This parameter specifies the minimum net data rate required for a
            valid SOS request in the upstream direction. 
            The value shall be coded as an unsigned integer representing the 
            data rate as a multiple of 8 kbit/s."
        REFERENCE    
            "ITU-T G.997.1, paragraph #7.3.2.1.7,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 32 }
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 10 } 

    zxAnPonRmXdslUsChConfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must set this object to 
            createAndGo(4), and must comply with the multi-variables usage rules
            in 'zxAnPonRmXdslUsDataRatePrfEntry' description.
        
            To delete a row in this table, a manager must set this object to 
            destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslUsDataRatePrfEntry 50 }   

--------------------------------------------------------------------------------
-- 10.4 zxAnPonRmXdslSpectrumPrfTable
--------------------------------------------------------------------------------
    zxAnPonRmXdslSpectrumPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslSpectrumPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Spectrum configuration profile."
        ::= { zxAnPonRmOnuXdslObjects 4 }

    zxAnPonRmXdslSpectrumPrfEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslSpectrumPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "A zxAnPonRmXdslSpectrumPrfTable entry."
        INDEX  { zxAnPonRmXdslSpectrumPrfName }
        ::= { zxAnPonRmXdslSpectrumPrfTable 1 }

    ZxAnPonRmXdslSpectrumPrfEntry  ::= SEQUENCE {
        zxAnPonRmXdslSpectrumPrfName       DisplayString,
        zxAnPonRmXdslXtuTransSysEn         ZxAnPonRmXdslTransModeType,
        zxAnPonRmXdslScMaskDs              Xdsl2ScMaskDs,
        zxAnPonRmXdslScMaskUs              Xdsl2ScMaskUs,
        zxAnPonRmXdslVdsl2CarMask          Xdsl2CarMask,
        zxAnPonRmXdslMsgMinDs              Integer32,
        zxAnPonRmXdslMsgMinUs              Integer32,
        zxAnPonRmXdslCeFlag                Xdsl2LineCeFlag,
        zxAnPonRmXdslPmMode                Xdsl2LinePmMode,
        zxAnPonRmXdslL0Time                Integer32,
        zxAnPonRmXdslL2Time                Integer32,
        zxAnPonRmXdslL2Atpr                Integer32,
        zxAnPonRmXdslL2Atprt               Integer32,
        zxAnPonRmXdslProfiles              Xdsl2LineProfiles,
        zxAnPonRmXdslUs0Mask               Xdsl2LineUs0Mask,
        zxAnPonRmXdslSpectrumRowStatus     RowStatus
        }
        
    zxAnPonRmXdslSpectrumPrfName  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Spectrum profile name."
        ::= { zxAnPonRmXdslSpectrumPrfEntry 1 }   
            
    zxAnPonRmXdslXtuTransSysEn  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslTransModeType
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "xTU transmission system enabling (xTSE).  
             A list of the different coding types enabled in this profile. 
             It is coded in a bit-map representation with 1 or more bits set. 
             A bit set to '1' means that the xTUs may apply the respective 
             coding for the DSL line. A bit set to '0' means that the xTUs 
             cannot apply the respective coding for the ADSL line. 
             All 'reserved' bits should be set to '0'."
        REFERENCE
            "ITU-T G.997.1, paragraph 7.3.1.1.1,
            G.988 9.7.3 xDSL line configuration profile part 1."
        ::= { zxAnPonRmXdslSpectrumPrfEntry 2 }  
        
    zxAnPonRmXdslScMaskDs  OBJECT-TYPE
        SYNTAX      Xdsl2ScMaskDs
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Sub-carriers mask.  A bitmap of 4096 bits that allows masking
            up to 4096 downstream sub-carriers, depending on NSCds.  If
            bit i (0 <= i < NSCds) is set to '1', the respective downstream 
            sub-carrier i is masked, and if set to '0', the respective 
            sub-carrier is unmasked.  Note that there should always be unmasked 
            sub-carriers (i.e., the object cannot be all 1's).  Also note that 
            if NSCds < 4096, all bits i (NSCds < i <= 4096) should 
            be set to '1'."
        REFERENCE    
            "ITU-T G.997.1, paragraph #7.3.1.2.6,
            9.7.8 xDSL subcarrier masking downstream profile."
        ::= { zxAnPonRmXdslSpectrumPrfEntry 3 }
     
     zxAnPonRmXdslScMaskUs  OBJECT-TYPE
        SYNTAX      Xdsl2ScMaskUs
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Sub-carriers mask. A bitmap of 4096 bits that allows masking
            up to 4096 upstream sub-carriers, depending on NSCus. If
            bit i (0 <= i < NSCus) is set to '1', the respective upstream 
            sub-carrier i is masked, and if set to '0', the respective 
            sub-carrier is unmasked. Note that there should always be unmasked 
            sub-carriers (i.e., the object cannot be all 1's). Also note that 
            if NSCus < 4096, all bits i (NSCuss < i <= 4096) should be 
            set to '1'."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.2.7,
            9.7.9 xDSL subcarrier masking upstream profile."
        ::= { zxAnPonRmXdslSpectrumPrfEntry 4 }
        
    zxAnPonRmXdslVdsl2CarMask  OBJECT-TYPE
        SYNTAX      Xdsl2CarMask
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
           "(VDSL2-CARMASK).
           VDSL2 specific sub-carriers mask. This configuration parameter 
           defines the restrictions, additional to the band plan, to determine 
           the set of subcarriers allowed for transmission in both upstream and 
           downstream directions. 
           The parameter shall describe the not masked subcarriers as one or 
           more frequency bands. Each band is represented by start and stop 
           subcarrier indices with a subcarrier spacing of 4.3125kHz. The valid 
           range of subcarrier indices run from 0 to at least the index of the 
           highest allowed subcarrier in both transmission directions among all
           profiles enabled by the parameter zxAnPonRmXdslProfiles. Up to 32 
           bands may be specified. Other subcarriers shall be masked."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions" 
        ::= { zxAnPonRmXdslSpectrumPrfEntry 5 }   
        
    zxAnPonRmXdslMsgMinDs  OBJECT-TYPE
        SYNTAX      Integer32(4..248)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum overhead rate downstream. This attribute defines the 
            minimum rate of the message-based overhead that shall be maintained
            by the xTU in downstream direction. Expressed in bits per second 
            and ranges from 4000 to 248000 bps."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.5.2,
             G.988 9.7.3 xDSL line configuration profile part 1."
        DEFVAL { 4 }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 6 }      

    zxAnPonRmXdslMsgMinUs OBJECT-TYPE
        SYNTAX      Integer32(4..248)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum overhead rate upstream. This attribute defines the minimum 
            rate of the message-based overhead that shall be maintained by the 
            xTU in upstream direction. Expressed in bits per second and ranges 
            from 4000 to 248000 bps."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.5.1,
             G.988 9.7.3 xDSL line configuration profile part 1."
        DEFVAL { 4 }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 7 }   
             
    zxAnPonRmXdslCeFlag     OBJECT-TYPE
        SYNTAX      Xdsl2LineCeFlag
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(CEFLAG).
            This parameter is a bit that enables the use of the optional cyclic
            extension values. If the bit is set to 1, the optional cyclic 
            extension values may be used. Otherwise, the cyclic extension shall
            be forced to the mandatory length (5N/32)."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.6.1, 
            G.988 9.7.6 VDSL2 line configuration extensions."
        DEFVAL { { } }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 8 }  
        
    zxAnPonRmXdslPmMode  OBJECT-TYPE
        SYNTAX      Xdsl2LinePmMode
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Power management state enabling (PMMode). Defines the power states 
            the xTU-C or xTU-R may autonomously transit to on this line. 
            The various bit positions are: allowTransitionsToIdle (0) and 
            allowTransitionsToLowPower (1). A bit with a '1' value means that 
            the xTU is allowed to transit into the respective state and a '0' 
            value means that the xTU is not allowed to transit into the 
            respective state."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.1.4,
            G.988 9.7.3 xDSL line configuration profile part 1."
        DEFVAL { { } }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 9}   
        
    zxAnPonRmXdslL0Time  OBJECT-TYPE
        SYNTAX      Integer32 (0..255)
        UNITS       "seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The minimum time (in seconds) between an exit from the L2 state and
            the next entry into the L2 state (L0-TIME). 
            It ranges from 0 to 255 seconds."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.1.5,
            G.988 9.7.4 xDSL line configuration profile part 2." 
        DEFVAL { 255 }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 10 }

    zxAnPonRmXdslL2Time  OBJECT-TYPE
        SYNTAX      Integer32 (0..255)
        UNITS       "seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The minimum time (in seconds) between an entry into the L2 state 
            and the first power trim in the L2 state or between two 
            consecutive power trims in the L2 State (L2-TIME). 
            It ranges from 0 to 255 seconds."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.1.6,
            G.988 9.7.4 xDSL line configuration profile part 2." 
        DEFVAL { 255 }
        ::= {  zxAnPonRmXdslSpectrumPrfEntry 11 }
        
    zxAnPonRmXdslL2Atpr  OBJECT-TYPE
        SYNTAX      Integer32 (0..31)
        UNITS       "dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The maximum aggregate transmit power reduction (in dB) that can be 
            performed at transition of L0 to L2 state or through a single power
            trim in the L2 state (L2-ATPR). It ranges from 0 dB to 31 dB."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.1.7"
        DEFVAL { 3 }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 12 }      

    zxAnPonRmXdslL2Atprt  OBJECT-TYPE
        SYNTAX      Integer32 (0..31)
        UNITS       "dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The total maximum aggregate transmit power reduction (in dB) that 
            can be performed in an L2 state. This is the sum of all reductions 
            of L2 request (i.e., at transition of L0 to L2 state) and power 
            trims (L2-ATPRT)."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.1.9"
        DEFVAL { 31 }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 13 }   
                                       
    zxAnPonRmXdslProfiles  OBJECT-TYPE
        SYNTAX      Xdsl2LineProfiles
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
           "The configuration parameter contains the G.993.2 profiles to be 
           allowed by the near-end xTU on this line (PROFILES). It is coded 
           in a bitmap representation (0 if not allowed, 1 if allowed). "
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"
        DEFVAL { { profile17a } }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 14 }     
        
    zxAnPonRmXdslUs0Mask  OBJECT-TYPE
        SYNTAX      Xdsl2LineUs0Mask
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The US0MASK attribute contains the US0 PSD masks to be allowed by 
            the xTU-C. This attribute is only defined for Annex A of 
            [ITU T G.993.2]. It is represented as a bit map (0 if not allowed, 
            1 if allowed) with the definitions of table 9.7.6-2."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions" 
        DEFVAL { { } }
        ::= { zxAnPonRmXdslSpectrumPrfEntry 15 }     
        
    zxAnPonRmXdslSpectrumRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must set this object to 
            createAndGo(4), and must comply with the multi-variables usage rules
            in 'zxAnPonRmXdslSpectrumPrfEntry' description.
        
            To delete a row in this table, a manager must set this object to 
            destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslSpectrumPrfEntry 50 } 

--------------------------------------------------------------------------------
-- 10.5 zxAnPonRmXdslModeSpecPrfTable
--------------------------------------------------------------------------------
    zxAnPonRmXdslModeSpecPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslModeSpecPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Each Line Spectrum Profile is associated with one or more 
             Mode Specific PSD Profiles. Each transmission mode enabled in a 
             Line Spectrum Profile is covered by one and only one of the 
             Mode Specific PSD Profiles contained in that Line Spectrum Profile.
            
             The table zxAnPonRmXdslModeSpecPrfTable extends the DSL line 
             configuration profile by xDSL Mode Specific parameters.
             A row in this table that has an index of zxAnPonRmXdslXdslMode.
             When a row in the zxAnPonRmXdslSpectrumPrfTable table (the parent 
             row) is created, the manager must also create a row in this table 
             using the zxAnPonRmXdslModeSpecRowStatus attribute.
             The manager may delete a row in this table using the 
             zxAnPonRmXdslModeSpecRowStatus attribute.
             Entries in this table must be maintained in a persistent manner."
        ::= { zxAnPonRmOnuXdslObjects 5 }

    zxAnPonRmXdslModeSpecPrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslModeSpecPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The table zxAnPonRmXdslModeSpecPrfTable extends the
            DSL line configuration profile by DSL Mode Specific
            parameters."
        INDEX   { zxAnPonRmXdslSpectrumPrfName, zxAnPonRmXdslXdslMode } 
        ::= { zxAnPonRmXdslModeSpecPrfTable 1 }

    ZxAnPonRmXdslModeSpecPrfEntry  ::= SEQUENCE {
        zxAnPonRmXdslXdslMode              ZxAnPonRmXdslOperationModes,
        zxAnPonRmXdslMaxNomPsdDs           Integer32,
        zxAnPonRmXdslMaxNomPsdUs           Integer32,
        zxAnPonRmXdslMaxNomAtpDs           Integer32,
        zxAnPonRmXdslMaxNomAtpUs           Integer32,
        zxAnPonRmXdslClassMask             Xdsl2LineClassMask,
        zxAnPonRmXdslLimitMask             Xdsl2LineLimitMask,
        zxAnPonRmXdslUs0Disable            Xdsl2LineUs0Disable,
        zxAnPonRmXdslMaxAggRxPwrUs         Integer32,
        zxAnPonRmXdslPsdMaskDs             Xdsl2PsdMaskDs, 
        zxAnPonRmXdslPsdMaskUs             Xdsl2PsdMaskUs,
        zxAnPonRmXdslPsdMaskSelectUs       Xdsl2LinePsdMaskSelectUs,
        zxAnPonRmXdslModeSpecRowStatus     RowStatus
        }

    zxAnPonRmXdslXdslMode    OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslOperationModes
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The DSL mode is a way of categorizing the various xDSL
            transmission modes into groups, each group (xDSL Mode) shares
            the same PSD configuration.
            There should be multiple entries in this table for a given
            line profile in case multiple bits are set in
            zxAnPonRmXdslXtuTransSysEn for that profile. "
        REFERENCE
            "G.988 9.7.4 xDSL line configuration profile part 2" 
        DEFVAL { g9932AnnexB }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 1 }   

    zxAnPonRmXdslMaxNomPsdDs  OBJECT-TYPE
        SYNTAX      Integer32(-600..-300)
        UNITS       "0.1 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(MAXNOMPSDds).
            The maximum nominal transmit PSD in the downstream direction
            during initialization and showtime. It ranges from -600 to
            -300 units of 0.1 dBm/Hz. (Physical values are -60 to
            -30 dBm/Hz).  "
        REFERENCE
            "G.988 9.7.4 xDSL line configuration profile part 2"
        DEFVAL { -300 }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 2 }

    zxAnPonRmXdslMaxNomPsdUs  OBJECT-TYPE
        SYNTAX      Integer32(-600..-300)
        UNITS       "0.1 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(MAXNOMPSDus).
            The maximum nominal transmit PSD in the upstream direction
            during initialization and showtime. It ranges from -600 to
            -300 units of 0.1 dBm/Hz.  (Physical values are -60 to
            -30 dBm/Hz).  "
        REFERENCE
            "G.988 9.7.4 xDSL line configuration profile part 2"
        DEFVAL { -300 }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 3 }    

    zxAnPonRmXdslMaxNomAtpDs  OBJECT-TYPE
        SYNTAX      Integer32 (0..255)
        UNITS       "0.1 dBm"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(MAXNOMATPds).
            The maximum nominal aggregate transmit power in the downstream 
            direction during initialization and showtime. It ranges from 0 to 
            255 units of 0.1 dBm (Physical values are 0 to 25.5 dBm)."
        REFERENCE
            "G.988 9.7.4 xDSL line configuration profile part 2"   
        DEFVAL { 255 }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 4 }     

    zxAnPonRmXdslMaxNomAtpUs  OBJECT-TYPE
        SYNTAX      Integer32 (0..255)
        UNITS       "0.1 dBm"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(MAXNOMATPus).
            The maximum nominal aggregate transmit power in the upstream
            direction during initialization and showtime. It ranges from 0 to 
            255 units of 0.1 dBm (Physical values are 0 to 25.5 dBm)."
        REFERENCE
            "G.988 9.7.4 xDSL line configuration profile part 2" 
        DEFVAL { 255 }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 5 } 

    zxAnPonRmXdslClassMask  OBJECT-TYPE
        SYNTAX      Xdsl2LineClassMask
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(CLASSMASK).
            In order to reduce the number of configuration possibilities, the 
            limit power spectral density masks (see LIMITMASK) are grouped in 
            PSD mask classes. Each class is designed such that the PSD levels 
            of each limit PSD mask of a specific class are equal in their 
            respective passbands above 276 kHz. This parameter is defined per 
            VDSL2 Annex enabled in the zxAnPonRmXdslXtuTransSysEn object. 
            It selects a single PSD mask class per Annex that is activated at 
            the VTU-O."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"
        DEFVAL { b998AdeM2x }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 6 }

    zxAnPonRmXdslLimitMask  OBJECT-TYPE
        SYNTAX      Xdsl2LineLimitMask
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(LIMITMASK).
            This configuration parameter contains the G.993.2 limit PSD masks 
            of the selected PSD mask class, enabled by the near-end xTU on this 
            line for each class of profiles. Through this parameter several 
            limit PSD masks of the selected PSD mask class 
            (zxAnPonRmXdslClassMask ) may be enabled. The enabling parameter 
            is coded in a bitmap representation (0 if the associated mask is 
            not allowed, 1 if it is allowed)."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"
        DEFVAL { {profile17Limit1} }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 7 }    

    zxAnPonRmXdslUs0Disable  OBJECT-TYPE
        SYNTAX      Xdsl2LineUs0Disable
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The US0DISABLE attribute specifies whether channel US0 is disabled 
            for each limit PSD mask enabled in the LIMITMASK attribute. For each
            limit PSD mask enabled in the LIMITMASK attribute, one bit indicates
            if US0 is disabled. The disabling attribute is a bit map where the 
            value 1 specifies that US0 is disabled for the associated limit 
            mask. The bit map has the same structure as the LIMITMASK 
            attribute."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"          
        DEFVAL { { } }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 8 } 
        
    zxAnPonRmXdslMaxAggRxPwrUs  OBJECT-TYPE
        SYNTAX      Integer32(-255..255|65535)
        UNITS       "0.1 dBm"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(MAXRXPWRus).
            The maximum upstream aggregate receive power over the relevant
            set of sub-carriers. The xTU-C should verify that the
            upstream power cutback is such that this maximum aggregate
            receive power value is honored. It ranges from -255 to 255
            units of 0.1 dBm (physical values are -25.5 to 25.5 dBm).
            A value of 0xFFFF (65535) means that there is no limit."
        REFERENCE    
            "ITU-T G.997.1, paragraph #7.3.1.2.5,
            9.7.4 xDSL line configuration profile part 2. "
        DEFVAL { 255 }
        ::= { zxAnPonRmXdslModeSpecPrfEntry 9 }   
        
    zxAnPonRmXdslPsdMaskDs   OBJECT-TYPE
        SYNTAX      Xdsl2PsdMaskDs
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(PSDMASKds).
            The downstream PSD mask applicable at the U-C2 reference point. 
            This parameter is used only for G.992.5 and it may impose PSD
            restrictions (breakpoints) in addition to the Limit PSD mask
            defined in G.992.5.
            This is a string of 32 pairs of values in the following structure:
                Octets 0+1 - Index of 1st sub-carrier used in the context
                             of a first breakpoint.
                Octet  2   - The PSD reduction for the sub-carrier indicated in
                             octets 0 and 1.
                Octets 3-5 - Same, for a 2nd breakpoint.
                Octets 6-8 - Same, for a 3rd breakpoint.
            This architecture continues until octets 94-95, which are
            associated with a 32nd breakpoint.
            Each subcarrier index is an unsigned number in the range 1 and
            NSCds. Each PSD reduction value is in the range 0 (0dBm/Hz) to
            255 (-127.5dBm/Hz) with steps of 0.5dBm/Hz. Valid values are
            in the range 0 to 190 (0 to -95dBm/Hz).
            When the number of breakpoints is less than 32, all remaining
            octets are set to the value 0.  Note that the content of this
            object should be correlated with the sub-carriers mask and with
            the RFI setup. "
        REFERENCE    
            "ITU-T G.997.1, paragraph #7.3.1.2.9,
             9.7.10 xDSL PSD mask profile. "
          ::= { zxAnPonRmXdslModeSpecPrfEntry 10 }
     
    zxAnPonRmXdslPsdMaskUs   OBJECT-TYPE
        SYNTAX      Xdsl2PsdMaskUs
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(PSDMASKus).
            The upstream PSD mask applicable at the U-R2 reference point.
            This parameter is used only for G.992.5 and it may impose PSD
            restrictions (breakpoints) in addition to the Limit PSD mask
            defined in G.992.5.
            This is a string of 16 pairs of values in the following structure:
                Octets 0+1 - Index of 1st sub-carrier used in the context
                             of a first breakpoint.
                Octet  2   - The PSD reduction for the sub-carrier indicated in
                             octets 0 and 1.
                Octets 3-5 - Same, for a 2nd breakpoint.
                Octets 6-8 - Same, for a 3rd breakpoint.
            This architecture continues until octets 9-47, which are
            associated with a 16th breakpoint.
            Each subcarrier index is an unsigned number in the range 1 and
            NSCus. Each PSD reduction value is in the range 0 (0dBm/Hz) to
            255 (-127.5dBm/Hz) with steps of 0.5dBm/Hz. Valid values are
            in the range 0 to 190 (0 to -95dBm/Hz).
            When the number of breakpoints is less than 16, all remaining
            octets are set to the value 0. Note that the content of this
            object should be correlated with the sub-carriers mask and with
            the RFI setup. "
        REFERENCE    
            "ITU-T G.997.1, paragraph #7.3.1.2.12,
            9.7.10 xDSL PSD mask profile. "
          ::= { zxAnPonRmXdslModeSpecPrfEntry 11 }
          
    zxAnPonRmXdslPsdMaskSelectUs  OBJECT-TYPE
        SYNTAX      Xdsl2LinePsdMaskSelectUs
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The selected upstream PSD mask. This parameter is used only
            for annexes J and M of G.992.3 and G.992.5, and the same
            selection is used for all relevant enabled bits in
            zxAnPonRmXdslXtuTransSysEn. "
        REFERENCE  
            "ITU-T G.997.1, paragraph #7.3.1.2.12,
            G.988 9.7.3 xDSL line configuration profile part 1."
        DEFVAL { adlu56Eu56 }     
        ::= { zxAnPonRmXdslModeSpecPrfEntry 12 }  

    zxAnPonRmXdslModeSpecRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must set this object to 
            createAndGo(4), and must comply with the multi-variables usage rules
            in 'zxAnPonRmXdslModeSpecPrfEntry' description.
        
            To delete a row in this table, a manager must set this object to 
            destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslModeSpecPrfEntry 50 }

--------------------------------------------------------------------------------
-- 10.6 zxAnPonRmXdslUpboPrfTable
--------------------------------------------------------------------------------
    zxAnPonRmXdslUpboPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslUpboPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "UPBO configuration profile table."
        ::= { zxAnPonRmOnuXdslObjects 6 }

    zxAnPonRmXdslUpboPrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslUpboPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "A zxAnPonRmXdslUpboPrfTable entry."
        INDEX  { zxAnPonRmXdslUpboPrfName }
        ::= { zxAnPonRmXdslUpboPrfTable 1 }

    ZxAnPonRmXdslUpboPrfEntry  ::= SEQUENCE {
        zxAnPonRmXdslUpboPrfName           DisplayString,
        zxAnPonRmXdslUpboKL                Integer32,
        zxAnPonRmXdslUpboKLF               Xdsl2UpboKLF,
        zxAnPonRmXdslUpboU1PsdA            Integer32,
        zxAnPonRmXdslUpboU1PsdB            Integer32,
        zxAnPonRmXdslUpboU2PsdA            Integer32,
        zxAnPonRmXdslUpboU2PsdB            Integer32,
        zxAnPonRmXdslUpboU3PsdA            Integer32,
        zxAnPonRmXdslUpboU3PsdB            Integer32,
        zxAnPonRmXdslUpboU4PsdA            Integer32,
        zxAnPonRmXdslUpboU4PsdB            Integer32,
        zxAnPonRmXdslUpboU5PsdA            Integer32,
        zxAnPonRmXdslUpboU5PsdB            Integer32,
        zxAnPonRmXdslUpboU1KLRef           Integer32,
        zxAnPonRmXdslUpboU2KLRef           Integer32,
        zxAnPonRmXdslUpboU3KLRef           Integer32,
        zxAnPonRmXdslUpboU4KLRef           Integer32,
        zxAnPonRmXdslUpboU5KLRef           Integer32,
        zxAnPonRmXdslUpboPrfRowStatus      RowStatus
        }
        
    zxAnPonRmXdslUpboPrfName OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "UPBO profile name."
        ::= { zxAnPonRmXdslUpboPrfEntry 1 }
        
    zxAnPonRmXdslUpboKL  OBJECT-TYPE
        SYNTAX      Integer32 (0..1280)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOKL). 
            This configuration parameter defines the electrical length 
            expressed in dB at 1MHz, kl0, configured by the CO-MIB. 
            The value ranges from 0 (coded as 0) to 128 dB (coded as 1280) in 
            steps of 0.1 dB. This parameter is relevant only if 
            zxAnPonRmXdslUpboKLF is set to 'override(2)', which indicates that 
            this parameter's value will override the VTUs' determination of the
            electrical length. If zxAnPonRmXdslUpboKLF is set either to 
            'auto(1)' or 'disableUpbo(3)', then this parameter will be ignored."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions" 
        DEFVAL { 0 }
        ::= { zxAnPonRmXdslUpboPrfEntry 2 }
        
    zxAnPonRmXdslUpboKLF OBJECT-TYPE
        SYNTAX      Xdsl2UpboKLF
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Defines the upstream power backoff force mode (UPBOKLF)."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions" 
        DEFVAL { disableUpbo }
        ::= { zxAnPonRmXdslUpboPrfEntry 3 }

    zxAnPonRmXdslUpboU1PsdA  OBJECT-TYPE
        SYNTAX      Integer32(4000..8095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pa). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU1PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU1PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU1PsdA=zxAnPonRmXdslUpboU1PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"       
        DEFVAL { 5650 }
        ::= { zxAnPonRmXdslUpboPrfEntry  4 }

    zxAnPonRmXdslUpboU1PsdB  OBJECT-TYPE
        SYNTAX      Integer32(0..4095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pb). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU1PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU1PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'.             
            Setting zxAnPonRmXdslUpboU1PsdA=zxAnPonRmXdslUpboU1PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"       
        DEFVAL { 1020 }
        ::= { zxAnPonRmXdslUpboPrfEntry 5 }

    zxAnPonRmXdslUpboU2PsdA  OBJECT-TYPE
        SYNTAX      Integer32(4000..8095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pa). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU2PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU2PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU2PsdA=zxAnPonRmXdslUpboU2PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"       
        DEFVAL { 5650 }
        ::= { zxAnPonRmXdslUpboPrfEntry 6 }

    zxAnPonRmXdslUpboU2PsdB  OBJECT-TYPE
        SYNTAX      Integer32(0..4095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pb). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU2PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU2PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU2PsdA=zxAnPonRmXdslUpboU2PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"
        DEFVAL { 615 }
        ::= { zxAnPonRmXdslUpboPrfEntry 7 }

    zxAnPonRmXdslUpboU3PsdA  OBJECT-TYPE
        SYNTAX      Integer32(4000..8095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pa). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU3PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU3PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU3PsdA=zxAnPonRmXdslUpboU3PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"  
        DEFVAL { 5650 }
        ::= { zxAnPonRmXdslUpboPrfEntry 8 }
        
    zxAnPonRmXdslUpboU3PsdB  OBJECT-TYPE
        SYNTAX      Integer32(0..4095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pb). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU3PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU3PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU3PsdA=zxAnPonRmXdslUpboU3PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"  
        DEFVAL { 615 }
        ::= { zxAnPonRmXdslUpboPrfEntry 9 }

    zxAnPonRmXdslUpboU4PsdA  OBJECT-TYPE
        SYNTAX      Integer32(4000..8095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pa). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU4PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU4PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU4PsdA=zxAnPonRmXdslUpboU4PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"  
        DEFVAL { 4000 }
        ::= { zxAnPonRmXdslUpboPrfEntry 10 }

    zxAnPonRmXdslUpboU4PsdB  OBJECT-TYPE
        SYNTAX      Integer32(0..4095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pb). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU4PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU4PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU4PsdA=zxAnPonRmXdslUpboU4PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"  
        DEFVAL { 0 }
        ::= { zxAnPonRmXdslUpboPrfEntry 11 }  
        
    zxAnPonRmXdslUpboU5PsdA  OBJECT-TYPE
        SYNTAX      Integer32(4000..8095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pa). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU5PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU5PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU5PsdA=zxAnPonRmXdslUpboU5PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"
        DEFVAL { 5650 }
        ::= { zxAnPonRmXdslUpboPrfEntry 12 }

    zxAnPonRmXdslUpboU5PsdB  OBJECT-TYPE
        SYNTAX      Integer32(0..4095)
        UNITS       "0.01 dBm/Hz"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(UPBOPSD-pb). 
            This configuration parameter defines the 'a' reference parameter of
            the UPBO reference PSD used to compute the upstream power back-off 
            for the upstream band. A UPBOPSD defined for each band shall 
            consist of two parameters [a, b]. Parameter 'a' 
            (zxAnPonRmXdslUpboU5PsdA) ranges from 40 dBm/Hz (coded as 4000) to
            80.95 dBm/Hz (coded as 8095) in steps of 0.01 dBm/Hz; and parameter
            'b' (zxAnPonRmXdslUpboU5PsdB) ranges from 0 dBm/Hz (coded as 0) to
            40.95 dBm/Hz (coded as 4095) in steps of 0.01 dBm/Hz. The UPBO 
            reference PSD at the frequency 'f' expressed in MHz shall be equal 
            to '-a-b(SQRT(f))'. 
            Setting zxAnPonRmXdslUpboU5PsdA=zxAnPonRmXdslUpboU5PsdB=0 is a 
            special configuration to disable UPBO in the respective upstream 
            band."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"
        DEFVAL { 1020 }
        ::= { zxAnPonRmXdslUpboPrfEntry 13 }
        
    zxAnPonRmXdslUpboU1KLRef OBJECT-TYPE
        SYNTAX      Integer32 (0|18..635)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This parameter defines the UPBO reference electrical length used to
            compute the upstream power back-off for each upstream band except 
            US0, for the optional equalized FEXT UPBO method. The value ranges 
            from 1.8 to 63.5 dB in steps of 0.1 dB with special value 0. 
            The use of the special value 0 is described in 7.2.1.3.2/G.993.2."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.2.13,
            G.988 9.7.6 VDSL2 line configuration extensions."        
        DEFVAL { 0 }
        ::= { zxAnPonRmXdslUpboPrfEntry 14 }   

    zxAnPonRmXdslUpboU2KLRef OBJECT-TYPE
        SYNTAX      Integer32 (0|18..635)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
