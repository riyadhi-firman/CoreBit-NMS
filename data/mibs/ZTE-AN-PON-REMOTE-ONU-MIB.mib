 -- zxAnPonRmXdsl2PMChannelC15MTable 
--------------------------------------------------------------------------------
    zxAnPonRmXdsl2PMChannelC15MTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdsl2PMChannelC15MEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL channel current 15 minutes performance data table."
        ::= { zxAnPonRmXdsl2PMChannelObjects 10 }
    
    zxAnPonRmXdsl2PMChannelC15MEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2PMChannelC15MEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL channel current 15 minutes performance data entry."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex, 
                 zxAnPonRmXdsl2ChC15MUnit, zxAnPonRmXdsl2ChC15MChannelId }
        ::= { zxAnPonRmXdsl2PMChannelC15MTable 1 }
    
    ZxAnPonRmXdsl2PMChannelC15MEntry ::=
        SEQUENCE {
            zxAnPonRmXdsl2ChC15MUnit                 Xdsl2Unit,
            zxAnPonRmXdsl2ChC15MChannelId            Integer32,          
            zxAnPonRmXdsl2ChC15MCorrBlks             Counter32,
            zxAnPonRmXdsl2ChC15MUncorrBlks           Counter32,
            zxAnPonRmXdsl2ChC15MTxBlks               Counter32,
            zxAnPonRmXdsl2ChC15MRxBlks               Counter32,
            zxAnPonRmXdsl2ChC15MCodeViolates         Counter32,
            zxAnPonRmXdsl2ChC15MFecs                 Counter32       
        }           

    zxAnPonRmXdsl2ChC15MUnit  OBJECT-TYPE
        SYNTAX      Xdsl2Unit
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The termination unit, xtuc(1) or xtur(2)."
        ::= { zxAnPonRmXdsl2PMChannelC15MEntry 1 }
        
    zxAnPonRmXdsl2ChC15MChannelId  OBJECT-TYPE
        SYNTAX      Integer32(1..4)       
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The channel ID of ONU xDSL port."  
        REFERENCE
            "G.988 9.7.23 xDSL xTU-C channel performance monitoring
             history data
             G.988 9.7.24 xDSL xTU-R channel performance monitoring
             history data."
        ::= { zxAnPonRmXdsl2PMChannelC15MEntry 2 }          
        
     zxAnPonRmXdsl2ChC15MCorrBlks  OBJECT-TYPE
        SYNTAX      Counter32   
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of blocks received with errors that were 
             corrected on this channel during this interval."
        REFERENCE
            "G.988 9.7.23 xDSL xTU-C channel performance monitoring
             history data
             G.988 9.7.24 xDSL xTU-R channel performance monitoring
             history data."
