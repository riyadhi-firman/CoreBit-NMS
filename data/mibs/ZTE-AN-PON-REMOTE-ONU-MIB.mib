    zxAnPonRmXdslUpboPrfRowStatus OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must set this object to 
            createAndGo(4), and must comply with the multi-variables usage rules
            in 'zxAnPonRmXdslUpboPrfEntry' description.
        
            To delete a row in this table, a manager must set this object to 
            destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslUpboPrfEntry 50 }           

--------------------------------------------------------------------------------
-- 10.7 zxAnPonRmXdslSnrMarginPrfTable
--------------------------------------------------------------------------------
    zxAnPonRmXdslSnrMarginPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslSnrMarginPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "SNR margin configuration profile table."
        ::= { zxAnPonRmOnuXdslObjects 7 }

    zxAnPonRmXdslSnrMarginPrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslSnrMarginPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "A zxAnPonRmXdslSnrMarginPrfTable entry."
        INDEX  { zxAnPonRmXdslSnrMarginPrfName }
        ::= { zxAnPonRmXdslSnrMarginPrfTable 1 }
        
    ZxAnPonRmXdslSnrMarginPrfEntry  ::= SEQUENCE {
        zxAnPonRmXdslSnrMarginPrfName      DisplayString,
        zxAnPonRmXdslTargetSnrmDs          Integer32,
        zxAnPonRmXdslTargetSnrmUs          Integer32,
        zxAnPonRmXdslMaxSnrmDs             Integer32,
        zxAnPonRmXdslMaxSnrmUs             Integer32,
        zxAnPonRmXdslMinSnrmDs             Integer32,
        zxAnPonRmXdslMinSnrmUs             Integer32,
        zxAnPonRmXdslRaModeDs              INTEGER,
        zxAnPonRmXdslRaModeUs              INTEGER,
        zxAnPonRmXdslSnrModeDs             Xdsl2LineSnrMode,
        zxAnPonRmXdslSnrModeUs             Xdsl2LineSnrMode,
        zxAnPonRmXdslRaUsNrmDs             Integer32,
        zxAnPonRmXdslRaUsNrmUs             Integer32,
        zxAnPonRmXdslRaUsTimeDs            Integer32,
        zxAnPonRmXdslRaUsTimeUs            Integer32,
        zxAnPonRmXdslRaDsNrmDs             Integer32,
        zxAnPonRmXdslRaDsNrmUs             Integer32,
        zxAnPonRmXdslRaDsTimeDs            Integer32,
        zxAnPonRmXdslRaDsTimeUs            Integer32,
        zxAnPonRmXdslSnrMarginRowStatus    RowStatus
        }  

    zxAnPonRmXdslSnrMarginPrfName  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "SNR margin profile name."
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 1 }  

    zxAnPonRmXdslTargetSnrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The minimum noise margin the xTU-R receiver shall achieve,
            relative to the BER requirement for each of the downstream
            bearer channels, to successfully complete initialization.
            The target noise margin ranges from 0 to 310 units of 0.1 dB
            (Physical values are 0 to 31 dB)."
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { 60 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 2 }

    zxAnPonRmXdslTargetSnrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The minimum noise margin the xTU-C receiver shall achieve,
            relative to the BER requirement for each of the upstream
            bearer channels, to successfully complete initialization.
            The target noise margin ranges from 0 to 310 units of 0.1 dB
            (Physical values are 0 to 31 dB)."
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { 60 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 3 }   

    zxAnPonRmXdslMaxSnrmDs  OBJECT-TYPE
        SYNTAX      Integer32 (0..310|65535)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
           "The MAXSNRMds attribute specifies the maximum noise margin the xTU-R
           receiver tries to sustain. If the noise margin is above this level, 
           the xTU-R requests the xTU-C to reduce its transmit power, if this 
           functionality is supported by the pertinent xDSL recommendation. Its 
           value ranges from 0 (0.0 dB) to 310 (31.0 dB). The special value 
           0xFFFF indicates that the maximum noise margin limit is unbounded."
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { 300 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 4 }

    zxAnPonRmXdslMaxSnrmUs  OBJECT-TYPE
        SYNTAX      Integer32 (0..310|65535)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
           "The MAXSNRMus attribute specifies the maximum noise margin the xTU-C
           receiver tries to sustain. If the noise margin is above this level,
           the xTU-C requests the xTU-R to reduce its transmit power, if this 
           functionality is supported by the pertinent xDSL recommendation. Its 
           value ranges from 0 (0.0 dB) to 310 (31.0 dB). The special value 
           0xFFFF indicates that the maximum noise margin limit is unbounded."
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { 300 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 5 } 

    zxAnPonRmXdslMinSnrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The minimum noise margin the xTU-R receiver shall tolerate.
            If the noise margin falls below this level, the xTU-R shall
            request that the xTU-C increase the xTU-C transmit power.
            If an increase to xTU-C transmit power is not possible, a
            loss-of-margin (LOM) defect occurs, the xTU-R shall fail and
            attempt to reinitialize and the NMS shall be notified. The
            minimum noise margin ranges from 0 to 310 units of
            0.1 dB (Physical values are 0 to 31 dB). A value of 0 means
            that there is no minimum."
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { 0 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 6 }

    zxAnPonRmXdslMinSnrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The minimum noise margin the xTU-C receiver shall tolerate.
            If the noise margin falls below this level, the xTU-C shall
            request that the xTU-R increase the xTU-R transmit power.
            If an increase of xTU-R transmit power is not possible, a
            loss-of-margin (LOM) defect occurs, the xTU-C shall fail and
            attempt to re-initialize and the NMS shall be notified. The
            minimum noise margin ranges from 0 to 310 units of
            0.1 dB (Physical values are 0 to 31 dB). A value of 0 means
            that there is no minimum."
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { 0 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 7 }

    zxAnPonRmXdslRaModeDs  OBJECT-TYPE
        SYNTAX      INTEGER {
            manual(1),  
            raInit(2),  
            dynamicRa(3),
            dynamicSos(4)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(RA-MODEds).
            The mode of operation of a rate-adaptive xTU-C in the transmit
            direction. "
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { manual }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 8 }

    zxAnPonRmXdslRaModeUs  OBJECT-TYPE
        SYNTAX      INTEGER {
            manual(1),  
            raInit(2),  
            dynamicRa(3),
            dynamicSos(4)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(RA-MODEus).
            The mode of operation of a rate-adaptive xTU-R in the transmit
            direction. "
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 1"
        DEFVAL { manual }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 9 }

    zxAnPonRmXdslSnrModeDs  OBJECT-TYPE
        SYNTAX      Xdsl2LineSnrMode
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This parameter enables/disables the transmitter referred virtual 
            noise in the downstream direction."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"  
        DEFVAL { virtualNoiseDisabled }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 10 }

    zxAnPonRmXdslSnrModeUs  OBJECT-TYPE
        SYNTAX     Xdsl2LineSnrMode
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This parameter enables/disables the transmitter referred virtual 
            noise in the upstream direction."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions"  
        DEFVAL { virtualNoiseDisabled }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 11 }    

    zxAnPonRmXdslRaUsNrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The downstream upshift noise margin value, to be used when 
            zxAnPonRmXdslRaModeDs is set to 'dynamicRa'. If the downstream 
            noise margin is above this value and stays above it for more than 
            the time specified by the zxAnPonRmXdslRaUsTimeDs, the xTU-R shall 
            attempt to increase the downstream net data rate.  
            The downstream upshift noise margin ranges from 0 to 310 units of 
            0.1 dB (Physical values are 0 to 31 dB)."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.4.3,
            G.988 9.7.3 xDSL line configuration profile part 1."
        DEFVAL { 90 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 12 }

    zxAnPonRmXdslRaUsNrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The upstream upshift noise margin value, to be used when 
            zxAnPonRmXdslRaModeUs is set to 'dynamicRa'. If the upstream noise 
            margin is above this value and stays above it for more than the 
            time specified by the zxAnPonRmXdslRaUsTimeUs, the xTU-C shall 
            attempt to increase the upstream net data rate.
            The upstream upshift noise margin ranges from 0 to 310 units of 
            0.1 dB (Physical values are 0 to 31 dB)."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.4.4,
            G.988 9.7.3 xDSL line configuration profile part 1."
        DEFVAL { 90 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 13 } 

    zxAnPonRmXdslRaUsTimeDs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The downstream upshift time interval, to be used when 
            zxAnPonRmXdslRaModeDs is set to 'dynamicRa'. The interval of time 
            that the downstream noise margin should stay above the downstream 
            upshift noise margin before the xTU-R shall attempt to increase 
            the downstream net data rate. 
            The time interval ranges from 0 to 16383 seconds."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.4.5,
            G.988 9.7.3 xDSL line configuration profile part 2."
        DEFVAL { 60 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 14 }

    zxAnPonRmXdslRaUsTimeUs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The upstream upshift time interval, to be used when 
            zxAnPonRmXdslRaModeUs is set to 'dynamicRa'. The interval of time 
            the upstream noise margin should stay above the upstream upshift 
            noise margin before the xTU-C shall attempt to increase the 
            upstream net data rate. 
            The time interval ranges from 0 to 16383 seconds."
        REFERENCE 
            "ITU-T G.997.1, paragraph #7.3.1.4.6,
            G.988 9.7.3 xDSL line configuration profile part 2."
        DEFVAL { 60 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 15 } 

    zxAnPonRmXdslRaDsNrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The downstream downshift noise margin value, to be used when 
            zxAnPonRmXdslRaModeDs is set to 'dynamicRa'. If the downstream 
            noise margin is below this value and stays below that for more than 
            the time specified by the zxAnPonRmXdslRaDsTimeDs, the xTU-R shall 
            attempt to decrease the downstream net data rate.
            The downstream downshift noise margin ranges from 0 to 310 units 
            of 0.1 dB (Physical values are 0 to 31 dB)."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.4.7,
            G.988 9.7.3 xDSL line configuration profile part 2."
        DEFVAL { 30 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 16 }

    zxAnPonRmXdslRaDsNrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The upstream downshift noise margin value, to be used when 
            zxAnPonRmXdslRaModeUs is set to 'dynamicRa'. If the upstream noise 
            margin is below this value and stays below that for more than the 
            time specified by the zxAnPonRmXdslRaDsTimeUs, the xTU-C shall 
            attempt to decrease the upstream net data rate. 
            The upstream downshift noise margin ranges from 0 to 310 units of 
            0.1 dB (Physical values are 0 to 31 dB)."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.4.8,
            G.988 9.7.3 xDSL line configuration profile part 2."
        DEFVAL { 30 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 17 }

    zxAnPonRmXdslRaDsTimeDs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The downstream downshift time interval, to be used when 
            zxAnPonRmXdslRaModeDs is set to 'dynamicRa'. The interval of time 
            the downstream noise margin should stay below the downstream 
            downshift noise margin before the xTU-R shall attempt to decrease 
            the downstream net data rate. 
            The time interval ranges from 0 to 16383 seconds."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.4.9,
            G.988 9.7.3 xDSL line configuration profile part 2."
        DEFVAL { 60 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 18 }

    zxAnPonRmXdslRaDsTimeUs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The upstream downshift time interval, to be used when 
            zxAnPonRmXdslRaModeUs is set to 'dynamicRa'. The interval of time 
            the upstream noise margin should stay below the upstream downshift
            noise margin before the xTU-C shall attempt to decrease the 
            upstream net data rate.  
            The time interval ranges from 0 to 16383 seconds."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.1.4.10,
            G.988 9.7.3 xDSL line configuration profile part 2."
        DEFVAL { 60 }
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 19 }        

    zxAnPonRmXdslSnrMarginRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must set this object to 
            createAndGo(4), and must comply with the multi-variables usage rules
            in 'zxAnPonRmXdslSnrMarginPrfEntry' description.
        
            To delete a row in this table, a manager must set this object to 
            destroy(6).

            To query this object, always return 1. "
        ::= { zxAnPonRmXdslSnrMarginPrfEntry 50 }

--------------------------------------------------------------------------------
-- 10.8 zxAnPonRmXdslDelayInpPrfTable
--------------------------------------------------------------------------------
    zxAnPonRmXdslDelayInpPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslDelayInpPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Delay and INP configuration profile table."
        ::= { zxAnPonRmOnuXdslObjects 8 }

    zxAnPonRmXdslDelayInpPrfEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslDelayInpPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "A zxAnPonRmXdslDelayInpPrfTable entry."
        INDEX  { zxAnPonRmXdslDelayInpPrfName }
        ::= { zxAnPonRmXdslDelayInpPrfTable 1 }

    ZxAnPonRmXdslDelayInpPrfEntry ::= SEQUENCE {
        zxAnPonRmXdslDelayInpPrfName      DisplayString,
        zxAnPonRmXdslChMaxDelayDs         Integer32,
        zxAnPonRmXdslChMaxDelayUs         Integer32,
        zxAnPonRmXdslChMinProtectDs       Xdsl2SymbolProtection,
        zxAnPonRmXdslChMinProtectUs       Xdsl2SymbolProtection,
        zxAnPonRmXdslChMinProtect8Ds      Xdsl2SymbolProtection8,
        zxAnPonRmXdslChMinProtect8Us      Xdsl2SymbolProtection8,
        zxAnPonRmXdslChMaxDelayVarDs      Integer32, 
        zxAnPonRmXdslChMaxDelayVarUs      Integer32,
        zxAnPonRmXdslChInitPolicyDs       Xdsl2ChInitPolicy,
        zxAnPonRmXdslChInitPolicyUs       Xdsl2ChInitPolicy,
        zxAnPonRmXdslChForceInpDs         INTEGER,
        zxAnPonRmXdslChForceInpUs         INTEGER, 
        zxAnPonRmXdslDelayInpRowStatus    RowStatus
        }

    zxAnPonRmXdslDelayInpPrfName  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Delay and INP profile name."
        ::= { zxAnPonRmXdslDelayInpPrfEntry 1 }
        
    zxAnPonRmXdslChMaxDelayDs  OBJECT-TYPE
        SYNTAX      Integer32(0..63|255)
        UNITS       "milliseconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum interleave delay on downstream direction. This attribute 
            is the maximum one-way interleaving delay introduced by the PMS-TC 
            between the alpha and the beta reference points, in the direction of
            the bearer channel. The one-way interleaving delay is defined in 
            individual xDSL recommendations as cap(S*D)/4 ms, where S is the S 
            factor, D is the interleaving depth, and cap() denotes rounding to 
            the next higher integer. xTUs choose S and D values such that the 
            actual one-way interleaving delay does not exceed the configured 
            maximum interleaving delay. The delay is coded in ms, varying from 
            2 to 63, with special meaning assigned to values 0, 1 and 255. The 
            value 0 indicates that no delay bound is imposed. The value 1 
            indicates the fast latency path is to be used in the G.992.1 
            operating mode and S and D are to be selected such that S <= 1 and 
            D = 1 in G.992.2, G.992.3, G.992.4, G.992.5 and G.993.2 operating 
            modes. The value 255 indicates a delay bound of 1 ms in G.993.2 
            operation. "
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.2,
            G.988 9.7.7 xDSL channel configuration profile."  
        DEFVAL { 16 } 
        ::= { zxAnPonRmXdslDelayInpPrfEntry 2 }
        
    zxAnPonRmXdslChMaxDelayUs  OBJECT-TYPE
        SYNTAX      Integer32(0..63|255)
        UNITS       "milliseconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum interleave delay on upstream direction. This attribute is 
            the maximum one-way interleaving delay introduced by the PMS-TC 
            between the alpha and the beta reference points, in the direction of
            the bearer channel. The one-way interleaving delay is defined in 
            individual xDSL recommendations as cap(S*D)/4 ms, where S is the S 
            factor, D is the interleaving depth, and cap() denotes rounding to 
            the next higher integer. xTUs choose S and D values such that the 
            actual one-way interleaving delay does not exceed the configured 
            maximum interleaving delay. The delay is coded in ms, varying from 
            2 to 63, with special meaning assigned to values 0, 1 and 255. The 
            value 0 indicates that no delay bound is imposed. The value 1 
            indicates the fast latency path is to be used in the G.992.1 
            operating mode and S and D are to be selected such that S <= 1 and 
            D = 1 in G.992.2, G.992.3, G.992.4, G.992.5 and G.993.2 operating 
            modes. The value 255 indicates a delay bound of 1 ms in G.993.2." 
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.2,
            G.988 9.7.7 xDSL channel configuration profile."  
        DEFVAL { 16 } 
        ::= { zxAnPonRmXdslDelayInpPrfEntry 3 }        
        
    zxAnPonRmXdslChMinProtectDs  OBJECT-TYPE
        SYNTAX      Xdsl2SymbolProtection
        UNITS       "symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum impulse noise protection on downstream direction. The
            minimum impulse noise protection for the bearer channel,
            expressed in symbols. "
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.3,
            G.988 9.7.7 xDSL channel configuration profile" 
        DEFVAL { noProtection }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 4 }
           
    zxAnPonRmXdslChMinProtectUs  OBJECT-TYPE
        SYNTAX      Xdsl2SymbolProtection
        UNITS       "symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum impulse noise protection on upstream direction. The
            minimum impulse noise protection for the bearer channel,
            expressed in symbols. "
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.3,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { noProtection }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 5 }   
                
    zxAnPonRmXdslChMinProtect8Ds  OBJECT-TYPE
        SYNTAX      Xdsl2SymbolProtection8
        UNITS       "symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(INPMIN8ds).
            This parameter specifies the minimum impulse noise protection
            for the bearer channel if it is transported over DMT symbols
            with a subcarrier spacing of 8.625 kHz. The impulse noise
            protection is expressed in DMT symbols with a subcarrier
            spacing of 8.625 kHz and can take any integer value from
            0 to 16, inclusive."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.4,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { noProtection }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 6 }  

    zxAnPonRmXdslChMinProtect8Us  OBJECT-TYPE
        SYNTAX      Xdsl2SymbolProtection8
        UNITS       "symbols"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "(INPMIN8us).
            This parameter specifies the minimum impulse noise protection
            for the bearer channel if it is transported over DMT symbols
            with a subcarrier spacing of 8.625 kHz. The impulse noise
            protection is expressed in DMT symbols with a subcarrier
            spacing of 8.625 kHz and can take any integer value from
            0 to 16, inclusive."
        REFERENCE
            "ITU-T G.997.1, paragraph #7.3.2.4,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { noProtection }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 7 }   
               
    zxAnPonRmXdslChMaxDelayVarDs  OBJECT-TYPE
        SYNTAX      Integer32(1..255)
        UNITS       "0.1 milliseconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum delay variation (DVMAX). This optional VDSL2 specific 
            parameter specifies the maximum value for the delay variation 
            allowed in an OLR procedure. It is ranges from 1 to 254 units of 
            0.1 milliseconds (i.e., 0.1 to 25.4 milliseconds) with the special 
            value 255 which indicates that no delay variation bound is imposed."
        REFERENCE
            "ITU-T G.997.1 Amendment 1, paragraph #7.3.2.9,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 255 }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 8 }    
    
    zxAnPonRmXdslChMaxDelayVarUs  OBJECT-TYPE
        SYNTAX      Integer32(1..255)
        UNITS       "0.1 milliseconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum delay variation (DVMAX). This optional VDSL2 specific 
            parameter specifies the maximum value for the delay variation 
            allowed in an OLR procedure. It is ranges from 1 to 254 units of 
            0.1 milliseconds (i.e., 0.1 to 25.4 milliseconds) with the special 
            value 255 which indicates that no delay variation bound is imposed."
        REFERENCE    
            "ITU-T G.997.1 Amendment 1, paragraph #7.3.2.9,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { 255 }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 9 }  
                   
    zxAnPonRmXdslChInitPolicyDs  OBJECT-TYPE
        SYNTAX      Xdsl2ChInitPolicy
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Channel initialization policy selection (CIPOLICY). This optional 
            parameter indicates which policy shall be applied to determine the 
            transceiver configuration parameters at initialization. The valid 
            values for CIPOLICY are policy0 and policy1. Those policies are 
            defined in the respective recommendations."
        REFERENCE
            "ITU-T G.997.1 Amendment 1, paragraph #7.3.2.10,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { policy0 }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 10 }
        
    zxAnPonRmXdslChInitPolicyUs  OBJECT-TYPE
        SYNTAX      Xdsl2ChInitPolicy
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
           "Channel initialization policy selection (CIPOLICY). This optional 
           parameter indicates which policy shall be applied to determine the 
           transceiver configuration parameters at initialization. The valid 
           values for CIPOLICY are policy0 and policy1. Those policies are 
           defined in the respective recommendations."
        REFERENCE
            "ITU-T G.997.1 Amendment 1, paragraph #7.3.2.10,
            G.988 9.7.7 xDSL channel configuration profile." 
        DEFVAL { policy0 }
        ::= { zxAnPonRmXdslDelayInpPrfEntry 11 }    
            
    zxAnPonRmXdslChForceInpDs  OBJECT-TYPE
        SYNTAX      INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "When set to 1, the FORCEINPds attribute forces the framer settings 
            of all downstream bearer channels to be selected such that the 
            impulse noise protection computed according to the formula specified
            in the relevant recommendation is greater than or equal to the 
            minimal impulse noise protection requirement. "
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 2" 
        DEFVAL { disabled } 
        ::= { zxAnPonRmXdslDelayInpPrfEntry 12 }      
      
    zxAnPonRmXdslChForceInpUs  OBJECT-TYPE
        SYNTAX      INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
           "When set to 1, the FORCEINPus attribute forces the framer settings 
           of all upstream bearer channels to be selected such that the impulse 
           noise protection computed according to the formula specified in the 
           relevant recommendation is greater than or equal to the minimal 
           impulse noise protection requirement. "
        REFERENCE
            "G.988 9.7.3 xDSL line configuration profile part 2" 
        DEFVAL { disabled } 
        ::= { zxAnPonRmXdslDelayInpPrfEntry 13 } 

    zxAnPonRmXdslDelayInpRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must
            set this object to createAndGo(4), and must comply with the 
            multi-variables usage rules in 'zxAnPonRmXdslDelayInpPrfEntry'
            description.
        
            To delete a row in this table, a manager must
            set this object to destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslDelayInpPrfEntry 50 }   

