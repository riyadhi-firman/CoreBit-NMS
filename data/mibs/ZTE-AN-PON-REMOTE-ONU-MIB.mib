--------------------------------------------------------------------------------      
 -- zxAnPonRmXdsl2PMChannelH15MTable 
--------------------------------------------------------------------------------
    zxAnPonRmXdsl2PMChannelH15MTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdsl2PMChannelH15MEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL channel historical 15 minutes performance data table."
        ::= { zxAnPonRmXdsl2PMChannelObjects 11 }
    
    zxAnPonRmXdsl2PMChannelH15MEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2PMChannelH15MEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL channel historical 15 minutes performance data entry."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex, 
                 zxAnPonRmXdsl2ChH15MUnit, zxAnPonRmXdsl2ChH15MChannelId,
                 zxAnPonRmXdsl2ChH15MInterval }
        ::= { zxAnPonRmXdsl2PMChannelH15MTable 1 }
    
    ZxAnPonRmXdsl2PMChannelH15MEntry ::=
        SEQUENCE {
            zxAnPonRmXdsl2ChH15MUnit                 Xdsl2Unit,
            zxAnPonRmXdsl2ChH15MChannelId            Integer32,
            zxAnPonRmXdsl2ChH15MInterval             Integer32,          
            zxAnPonRmXdsl2ChH15MCorrBlks             Counter32,
            zxAnPonRmXdsl2ChH15MUncorrBlks           Counter32,
            zxAnPonRmXdsl2ChH15MTxBlks               Counter32,
            zxAnPonRmXdsl2ChH15MRxBlks               Counter32,
            zxAnPonRmXdsl2ChH15MCodeViolates         Counter32,
            zxAnPonRmXdsl2ChH15MFecs                 Counter32       
        }           

    zxAnPonRmXdsl2ChH15MUnit  OBJECT-TYPE
        SYNTAX      Xdsl2Unit
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The termination unit, xtuc(1) or xtur(2)."
        ::= { zxAnPonRmXdsl2PMChannelH15MEntry 1 }
        
    zxAnPonRmXdsl2ChH15MChannelId  OBJECT-TYPE
        SYNTAX      Integer32(1..4)       
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The channel ID of ONU xDSL port."
        REFERENCE
            "G.988 9.7.23 xDSL xTU-C channel performance monitoring
             history data
             G.988 9.7.24 xDSL xTU-R channel performance monitoring
             history data."
        ::= { zxAnPonRmXdsl2PMChannelH15MEntry 2 }          

    zxAnPonRmXdsl2ChH15MInterval  OBJECT-TYPE
        SYNTAX      Integer32(1..96)
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The interval number.
             Interval 1 is the the most recent previous interval and interval 96
             is 24 hours ago. Intervals from 2 to 96 are optional."
        ::= { zxAnPonRmXdsl2PMChannelH15MEntry 3 }    
                
     zxAnPonRmXdsl2ChH15MCorrBlks  OBJECT-TYPE
        SYNTAX      Counter32   
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of blocks received with errors that were 
