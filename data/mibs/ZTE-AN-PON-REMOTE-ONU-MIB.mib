--------------------------------------------------------------------------------  
-- PON ONU POTS calling data record table                                                 
-- zxAnPonRmPotsCallDataRecordTable                                                      
--------------------------------------------------------------------------------  
    zxAnPonRmPotsCallDataRecordTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmPotsCallDataRecordEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "PON ONU POTS calling data record table."
        ::= { zxAnPonRmOnuVoipObjects 2 }

    zxAnPonRmPotsCallDataRecordEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmPotsCallDataRecordEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "An entry in zxAnPonRmPotsCallDataRecordTable."
        INDEX   { ifIndex, zxAnPonOnuIndex,
         zxAnPonRmOnuUniIndex, zxAnPonRmPotsCdrIndex }
        ::= { zxAnPonRmPotsCallDataRecordTable 1 }
        
    ZxAnPonRmPotsCallDataRecordEntry ::=
        SEQUENCE {
            zxAnPonRmOnuUniIndex            ZxAnPonRmOnuUniIndex,
            zxAnPonRmPotsCdrIndex           Integer32,
            zxAnPonRmPotsCdrTotalNum        Integer32,
            zxAnPonRmPotsCdrSequenceNum     Integer32,
            zxAnPonRmPotsCdrTime            DateAndTime,
            zxAnPonRmPotsCdrDuration        Integer32,
            zxAnPonRmPotsCdrCalleeNumber    DisplayString,
            zxAnPonRmPotsCdrCallerNumber    DisplayString,
            zxAnPonRmPotsCdrTxRtpPkts       Integer32,
            zxAnPonRmPotsCdrRxRtpPkts       Integer32,
            zxAnPonRmPotsCdrLostRtpPkts     Integer32,
            zxAnPonRmPotsCdrDiscardRtpPkts  Integer32,
            zxAnPonRmPotsCdrBufOverCount    Integer32,
            zxAnPonRmPotsCdrBufEmptyCount   Integer32,
            zxAnPonRmPotsCdrRxAvgJitter     Integer32,
            zxAnPonRmPotsCdrFarEndRtcp      INTEGER,
            zxAnPonRmPotsCdrRxPeakJitter    Integer32,
            zxAnPonRmPotsCdrRxAvgJtrBufDep  Integer32,
            zxAnPonRmPotsCdrFarEndRtcpXr    INTEGER,
            zxAnPonRmPotsCdrPeakRtDelay     Integer32,
            zxAnPonRmPotsCdrAvgRtDelay      Integer32,
            zxAnPonRmPotsCdrAvgMos          Integer32
        }
                
    zxAnPonRmOnuUniIndex OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuUniIndex
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This attribute indicates the index of UNI in ONU."
        ::= { zxAnPonRmPotsCallDataRecordEntry 1}    
            
    zxAnPonRmPotsCdrIndex OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "VoIP calling record index."
        ::= { zxAnPonRmPotsCallDataRecordEntry 2 }

    zxAnPonRmPotsCdrTotalNum OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of the call records."
        ::= { zxAnPonRmPotsCallDataRecordEntry 3 }            

    zxAnPonRmPotsCdrSequenceNum OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Sequence number of call record."
        ::= { zxAnPonRmPotsCallDataRecordEntry 4 }  

    zxAnPonRmPotsCdrTime OBJECT-TYPE
        SYNTAX      DateAndTime
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The time of one call,
             format is yyyy-mm-dd,HH:MM:SS. For example,2010-12-30,13:06:30."
        ::= { zxAnPonRmPotsCallDataRecordEntry 5 }  

    zxAnPonRmPotsCdrDuration OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "Seconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The duration of one call."
        ::= { zxAnPonRmPotsCallDataRecordEntry 6 }  
        
    zxAnPonRmPotsCdrCalleeNumber OBJECT-TYPE
        SYNTAX      DisplayString
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Callee number."
        ::= { zxAnPonRmPotsCallDataRecordEntry 7 }  
        
    zxAnPonRmPotsCdrCallerNumber OBJECT-TYPE
        SYNTAX      DisplayString
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Caller number."
        ::= { zxAnPonRmPotsCallDataRecordEntry 8 }  
        
    zxAnPonRmPotsCdrTxRtpPkts OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of 
             RTP packets transmitted during the call."
        ::= { zxAnPonRmPotsCallDataRecordEntry 9 }  
        
    zxAnPonRmPotsCdrRxRtpPkts OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION 
            "The total number of RTP packets received during the call."
        ::= { zxAnPonRmPotsCallDataRecordEntry 10 } 
         
    zxAnPonRmPotsCdrLostRtpPkts OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of 
             RTP packets lost during the call."
        ::= { zxAnPonRmPotsCallDataRecordEntry 11 }  
        
    zxAnPonRmPotsCdrDiscardRtpPkts OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of 
             RTP packets discarded due to error."
        ::= { zxAnPonRmPotsCallDataRecordEntry 12 }  
        
    zxAnPonRmPotsCdrBufOverCount OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Buffer overflow count."
        ::= { zxAnPonRmPotsCallDataRecordEntry 13 }  
        
    zxAnPonRmPotsCdrBufEmptyCount OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Buffer empty count."
        ::= { zxAnPonRmPotsCallDataRecordEntry 14 }  
        
    zxAnPonRmPotsCdrRxAvgJitter OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "Milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average jitter for received packets."
        ::= { zxAnPonRmPotsCallDataRecordEntry 15 }  
        
    zxAnPonRmPotsCdrFarEndRtcp OBJECT-TYPE
        SYNTAX      INTEGER{
                    participated(1),
                    notParticipated(2)
                    } 
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Whether or not the 
             far end participated in RTCP."
        ::= { zxAnPonRmPotsCallDataRecordEntry 16 }  
        
    zxAnPonRmPotsCdrRxPeakJitter OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "Milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The peak jitter for received packets."
        ::= { zxAnPonRmPotsCallDataRecordEntry 17 }  
        
    zxAnPonRmPotsCdrRxAvgJtrBufDep OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "Milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average jitter buffer depth for received packets."
        ::= { zxAnPonRmPotsCallDataRecordEntry 18 }  
        
    zxAnPonRmPotsCdrFarEndRtcpXr OBJECT-TYPE
        SYNTAX      INTEGER{
                    participated(1),
                    notParticipated(2)
                    } 
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Whether or not the
             far end participated in RTCP-XR."
        ::= { zxAnPonRmPotsCallDataRecordEntry 19 }  
        
    zxAnPonRmPotsCdrPeakRtDelay OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "Milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The peak round-trip delay for a call."
        ::= { zxAnPonRmPotsCallDataRecordEntry 20 }  
        
    zxAnPonRmPotsCdrAvgRtDelay OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "Milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average round-trip delay for the call."
        ::= { zxAnPonRmPotsCallDataRecordEntry 21 }  
        
    zxAnPonRmPotsCdrAvgMos OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average mean opinion score."
        ::= { zxAnPonRmPotsCallDataRecordEntry 22 }   

-------------------------------------------------------------------------------      
-- zxAnPonRmEnergySavePrfTable
-------------------------------------------------------------------------------
    zxAnPonRmEnergySavePrfTable    OBJECT-TYPE
      SYNTAX      SEQUENCE OF ZxAnPonRmEnergySavePrfEntry
      MAX-ACCESS  not-accessible
      STATUS      current
      DESCRIPTION
      "The table of energy saving profile management."
      REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"
        ::= { zxAnPonRmOnuEnergySaveObjects 2 }
        
    zxAnPonRmEnergySavePrfEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmEnergySavePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is an entry in the zxAnPonRmEnergySavePrfTable." 
        INDEX   {zxAnPonRmEnergySavePrfName}
        ::= { zxAnPonRmEnergySavePrfTable 1 } 
        
    ZxAnPonRmEnergySavePrfEntry ::=
        SEQUENCE {
            zxAnPonRmEnergySavePrfName                   DisplayString,
            zxAnPonRmEnergySaveModeEnable                BITS,
            zxAnPonRmEnergySaveMaxSleepIntvl             Unsigned32,
            zxAnPonRmEnergySaveMinAwareIntvl             Unsigned32,
            zxAnPonRmEnergySaveMinHoldIntvl              Integer32,
            zxAnPonRmEnergySaveRowStatus                 RowStatus            
        }
        
    zxAnPonRmEnergySavePrfName OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This attribute is the name of the energy saving profile."  
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"
        ::= { zxAnPonRmEnergySavePrfEntry 1 }        
         
    zxAnPonRmEnergySaveModeEnable OBJECT-TYPE
        SYNTAX      BITS {
                    doze(0),
                    cyclicSleep(1),
                    deepSleep(2)
                    }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This attribute enables one or more of the ONU's managed energy 
            saving modes. It is a bit map in which the bit value 0 
            disables the mode, while the value 1 enables the mode. Bit 
            assignments are the same as those of the power reduction management 
            capability attribute. The default value of each bit is 0."
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"
        DEFVAL {{}}
        ::= { zxAnPonRmEnergySavePrfEntry 2 }  
        
    zxAnPonRmEnergySaveMaxSleepIntvl OBJECT-TYPE   
        SYNTAX      Unsigned32 (0..4294967295)
        UNITS       "125Microseconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This attribute specifies the maximum time the ONU spends
            in its asleep or listen states, as a count of 125 microsecond 
            frames. Local or remote events may truncate the ONU's sojourn in 
            these states. The default value of this attribute is 0. 
            (R, W) (mandatory) (4 bytes)"
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"
        DEFVAL { 0 }
        ::= { zxAnPonRmEnergySavePrfEntry 3 }                              
                               
    zxAnPonRmEnergySaveMinAwareIntvl OBJECT-TYPE
        SYNTAX      Unsigned32 (0..4294967295)
        UNITS       "125Microseconds"
        MAX-ACCESS  read-create
        STATUS      current    
        DESCRIPTION            
            "This attribute specifies the time the ONU spends in its aware 
            state, as a count of 125 microsecond frames, before it re-enters 
            asleep or listen states. Local or remote events may independently 
            cause the ONU to enter an active state rather than returning 
            to a sleep state. The default value of this attribute is 0. 
            (R, W) (mandatory) (4 bytes)"
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control" 
        DEFVAL { 0 }     
        ::= { zxAnPonRmEnergySavePrfEntry 4 } 
         
    zxAnPonRmEnergySaveMinHoldIntvl OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "125Microseconds"
        MAX-ACCESS  read-create
        STATUS      current    
        DESCRIPTION            
            "This attribute specifies the minimum time during which the ONU 
            remains in the active held state, as a count of 125 microsecond 
            frames. Its initial value is zero. (R, W) (mandatory) (2 bytes)"
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control" 
        DEFVAL { 0 }     
        ::= { zxAnPonRmEnergySavePrfEntry 5 } 
      
    zxAnPonRmEnergySaveRowStatus OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support 
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
            
            To create a row in this table, a manager must
            set this object to createAndGo(4).
    
            To delete a row in this table, a manager must
            set this object to destroy(6). 
             
            To query this object, always return 1. "
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"
        ::= { zxAnPonRmEnergySavePrfEntry 50 }


-------------------------------------------------------------------------------
-- zxAnPonRmOnuEnergySaveConfTable
-------------------------------------------------------------------------------
    zxAnPonRmOnuEnergySaveConfTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuEnergySaveConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This table associated with the ONU energy saving management 
            entity."
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"
        ::= { zxAnPonRmOnuEnergySaveObjects 3 }

    zxAnPonRmOnuEnergySaveConfEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuEnergySaveConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is an entry in the zxAnPonRmOnuEnergySaveConfTable. The index 
            'zxAnPonOnuIndex' represents the normal ONU index or the virtual 
            ONU index for profile."
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"
        INDEX   { ifIndex, zxAnPonOnuIndex }
        ::= { zxAnPonRmOnuEnergySaveConfTable 1 }
        
    ZxAnPonRmOnuEnergySaveConfEntry ::=
        SEQUENCE {
            zxAnPonRmOnuEnergySaveConfPrf         DisplayString,
            zxAnPonRmOnuEnergySaveCapability      BITS,
            zxAnPonRmOnuEnergySaveItransinit      Integer32,
            zxAnPonRmOnuEnergySaveItxinit         Integer32,
            zxAnPonRmOnuEnergySaveConfStatus      INTEGER,
            zxAnPonRmOnuEnergySaveCurrMode        INTEGER
        }

    zxAnPonRmOnuEnergySaveConfPrf OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(0..32))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The attributes refers to 'zxAnPonRmEnergySavePrfName'.
            To clear the ONU's energy saving profile, a manager must
            set this object to empty string."
        ::= { zxAnPonRmOnuEnergySaveConfEntry 1 }
               
    zxAnPonRmOnuEnergySaveCapability OBJECT-TYPE
        SYNTAX      BITS {
                    doze(0),
                    cyclicSleep(1),
                    deepSleep(2)
                    } 
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute declares the ONU's support for managed energy 
            saving modes,as defined in [ITU-T G.987.3]. It is a bit map in 
            which the bit value 0 indicates no support for the specified mode,
            while the bit value 1 indicates that the ONU does support the 
            specified mode."
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control" 
        ::= { zxAnPonRmOnuEnergySaveConfEntry 2 }                        

    zxAnPonRmOnuEnergySaveItransinit OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "125Microseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute is the ONU vendor's statement of the complete 
            transceiver initialization time: the time required for the ONU to 
            regain full functionality when leaving the Asleep state 
            (i.e., turning on both receiver and transmitter and acquiring 
            synchronization to the downstream flow), measured in units of 
            125 microsecond frames. The value zero indicates that the sleeping 
            ONU can respond to a bandwidth grant without delay. 
            (R) (mandatory) (2 bytes)"   
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"  
        ::= { zxAnPonRmOnuEnergySaveConfEntry 3 } 

    zxAnPonRmOnuEnergySaveItxinit OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "125Microseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute is the ONU vendor's statement of the transmitter 
            initialization time: the time required for the ONU to regain full 
            functionality when leaving the Listen state (i.e., turning on the 
            transmitter), measured in units of 125 microsecond frames. 
            The value zero indicates that the dozing ONU can respond to a 
            bandwidth grant without delay. (R) (mandatory) (2 bytes)" 
        REFERENCE   
            "G.988 Section 9.1.14 ONU dynamic power management control"     
        ::= { zxAnPonRmOnuEnergySaveConfEntry 4 } 
        
    zxAnPonRmOnuEnergySaveConfStatus OBJECT-TYPE
        SYNTAX      INTEGER{
                    success(1),
                    failed(2),
                    unknown(3)
                    }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute is the ONU's energy saving configuration 
            status.
               success: energy saving configured success 
               failed: energy saving configured failed
               unknown: ONU not online
            "
        ::= { zxAnPonRmOnuEnergySaveConfEntry 5 }   
          
    zxAnPonRmOnuEnergySaveCurrMode OBJECT-TYPE
        SYNTAX      INTEGER{
                    noEnergySave(1),
                    doze(2),
                    cyclicSleep(3),
                    deepSleep(4)
                    }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute indicates the current mode of the ONU's energy 
            saving.
               noEnergySave: not support or not in energy saving mode
               doze: doze mode
               cyclicSleep: cyclic sleep mode
               deepSleep: deep sleep mode"
        ::= { zxAnPonRmOnuEnergySaveConfEntry 6 }  

--------------------------------------------------------------------------------
--  zxAnPonRmOnuLatestEventsTable                                                          
--------------------------------------------------------------------------------     
   zxAnPonRmOnuLatestEventsTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuLatestEventsEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This table associated with the ONU remote latest three events
             management entity."
        ::= { zxAnPonRmOnuLatestEventsObjects 2 }
            
    zxAnPonRmOnuLatestEventsEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuLatestEventsEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is an entry in the zxAnPonRmOnuLatestEventsTable. The index 
            'zxAnPonOnuIndex' represents the normal ONU index."
        INDEX   { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuLatestEventIndex }
        ::= { zxAnPonRmOnuLatestEventsTable 1 } 
        
    ZxAnPonRmOnuLatestEventsEntry::=
        SEQUENCE {
            zxAnPonRmOnuLatestEventIndex              Integer32,
            zxAnPonRmOnuLatestEvent                   DisplayString           
        }
    
    zxAnPonRmOnuLatestEventIndex OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU remote event index"
        ::= { zxAnPonRmOnuLatestEventsEntry 1 }
        
    zxAnPonRmOnuLatestEvent OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(0..255))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute indicates ONU remote latest events description string."
        ::= { zxAnPonRmOnuLatestEventsEntry 2 }        
        
          
--------------------------------------------------------------------------------
--5 zxAnPonRmOnuCliOverSnmpObjects begin
--------------------------------------------------------------------------------
------------------------------------------------------------------------------
--5.2 zxAnPonRmOnuConfCmdTable
------------------------------------------------------------------------------
    zxAnPonRmOnuConfCmdTable   OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmOnuConfCmdEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU configuration command table.
            EMS can send ONU configuration commands to OLT so as to configure
            remote ONU, and OLT only forward these commands to ONU via OMCI
            or OAM channel.

            NOTES: EMS will put all the ONU configuration commands to
            zxAnPonRmOnuConfCmd,

            The format of zxAnPonRmOnuConfCmd is:
            'command head::[parameter 1]=P1,[parameter 2]=P2,
             ...[parameter n]=Pn;'
            the command head represents a configuration function
            which is defined by EMS and ONU.
            parameters are followed by '::' and separated by ',',
            the end of the command must be ';'.
            Example:
              WAN_CONF::WANID=1,HOST=1,MODE=1,PPPUser=test,PPPPassword=test;
            "
        ::=  { zxAnPonRmOnuCliOverSnmpObjects  2 }

    zxAnPonRmOnuConfCmdEntry   OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuConfCmdEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "An entry in zxAnPonRmOnuConfCmdTable."
        INDEX {ifIndex,zxAnPonOnuIndex }
        ::=  { zxAnPonRmOnuConfCmdTable 1 }

    ZxAnPonRmOnuConfCmdEntry  ::=  SEQUENCE {
        zxAnPonRmOnuConfCmd              OCTET STRING
        }

    zxAnPonRmOnuConfCmd    OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(0..1024))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute identifies the ONU configuration command,
            EMS can configure remote ONU directly by ONU configuration commands.
             "
        ::= { zxAnPonRmOnuConfCmdEntry 1 }

------------------------------------------------------------------------------
--5.3 zxAnPonRmOnuRetrieveCmdTable
------------------------------------------------------------------------------
    zxAnPonRmOnuRetrieveCmdTable   OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmOnuRetrieveCmdEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "EMS can send zxAnPonRmOnuRetrieveCmd to retrieve ONU monitoring
             metrics which are not defined by ME of OMCI or OAM.
             Otherwise, EMS can retrieve error messages of excution of
             zxAnPonRmOnuConfCmd  in ONU.

            The action is divided into two steps.
            Step one:
                EMS sends zxAnPonRmOnuRetrieveCmdSessionId and
                zxAnPonRmOnuRetrieveCmd to OLT.
                The format of zxAnPonRmOnuRetrieveCmd is:
                'command head::[parameter 1]=P1,[parameter 2]=P2,
                 ...[parameter n]=Pn;'
                the command head represents a configuration function 
                which is defined by EMS and ONU.
                parameters are followed by '::' and separated by ',',
                the end of the command must be ';'.
                Example:
                 GET_WAN_CONF::WANID=1;                 
            Step two:  
                The result is saved in zxAnPonRmOnuRetrieveCmdReply.
                EMS can retrieve result by zxAnPonRmOnuRetrieveCmdSessionId.
                The format of zxAnPonRmOnuRetrieveCmdReply is:
                'command head::[parameter 1]=P1,[parameter 2]=P2,
                 ...[parameter n]=Pn;'
                the command head represents a configuration function 
                which is defined by EMS and ONU.
                parameters are followed by '::' and separated by ',',
                the end of the command must be ';'.
                Example:
                 GET_WAN_CONF_RESULT::WANID=1,HOST=1,MODE=1,PPPUser=test,
                   PPPPassword=test;  "
        ::=  { zxAnPonRmOnuCliOverSnmpObjects  3 }

    zxAnPonRmOnuRetrieveCmdEntry   OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuRetrieveCmdEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "An entry in zxAnPonRmOnuRetrieveCmdTable."
        INDEX { ifIndex,zxAnPonOnuIndex,
                zxAnPonRmOnuRetrieveCmdSessionId }
        ::=  { zxAnPonRmOnuRetrieveCmdTable 1 }

    ZxAnPonRmOnuRetrieveCmdEntry  ::=  SEQUENCE {
        zxAnPonRmOnuRetrieveCmdSessionId    Integer32,
        zxAnPonRmOnuRetrieveCmd             OCTET STRING,
        zxAnPonRmOnuRetrieveCmdReply        OCTET STRING
        }


    zxAnPonRmOnuRetrieveCmdSessionId OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This attribute identifies the session ID.
             The session ID is generated by EMS and is unique in EMS.
             Session ID can ensure that reply result does not conflicting."
        ::= { zxAnPonRmOnuRetrieveCmdEntry 1 }

    zxAnPonRmOnuRetrieveCmd    OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(0..1024))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute identifies commands
            which declared the information which EMS needs.
            "
        ::= { zxAnPonRmOnuRetrieveCmdEntry 2 }

    zxAnPonRmOnuRetrieveCmdReply    OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(0..1024))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute identifies the reply result.
            "
        ::= { zxAnPonRmOnuRetrieveCmdEntry 3 }

------------------------------------------------------------------------------
--5.50 zxAnPonRmOnuConfChangedTrap
------------------------------------------------------------------------------
   zxAnPonRmOnuConfChangedTrap    NOTIFICATION-TYPE
       OBJECTS {
           zxAnPonRmOnuConfCmd
           }
       STATUS current
       DESCRIPTION
            "When the configuration in ONU is modified via ONU local craft
            interface, ONU will send all the configuration commands changed
            to OLT, and then, OLT will forward this commands string to EMS
            via zxAnPonRmOnuConfChangedTrap.

            The receiving port of zxAnPonRmOnuConfChangedTrap is 49603,
            zxAnPonRmOnuConfChangedTrap is neither a alarm nor a notification,
            it is only a event of internal service configuration processes."

      ::={ zxAnPonRmOnuCliOverSnmpObjects 50}

--------------------------------------------------------------------------------
--6 zxAnPonRmOnuConfFileObjects begin
--6.2 zxAnPonRmOnuConfFileSvrTable
-------------------------------------------------------------------------------
    zxAnPonRmOnuConfFileSvrTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuConfFileSvrEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Service configuration  server  of the ONU."
        REFERENCE   "GPON:9.12.13 File transfer controller;EPON:Private OAM."
        ::= { zxAnPonRmOnuConfFileObjects 2 }

    zxAnPonRmOnuConfFileSvrEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuConfFileSvrEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is entry in the zxAnPonRmOnuConfFileSvrTable."
        INDEX   { ifIndex,zxAnPonOnuIndex }
        ::= { zxAnPonRmOnuConfFileSvrTable 1 }

    ZxAnPonRmOnuConfFileSvrEntry ::=
        SEQUENCE {
            zxAnPonRmOnuConfFileSvrAddress            DisplayString,
            zxAnPonRmOnuConfFileSvrUserName           DisplayString,
            zxAnPonRmOnuConfFileSvrPassword           DisplayString,
            zxAnPonRmOnuConfFileSvrFileName           DisplayString
        }

    zxAnPonRmOnuConfFileSvrAddress OBJECT-TYPE
        SYNTAX      DisplayString(SIZE (0..64))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute identifies the service configuration server address
             information, along with the URI to be used for the file transfer.
             The URI string should specify the protocol supported
             by the ONU, an IP address or a string that can be resolved
             into an IP address, and optionally a port.
             If this address is null, ONU will not execute file action."
        REFERENCE   "GPON:9.12.13 File transfer controller;EPON:Private OAM."
        ::= { zxAnPonRmOnuConfFileSvrEntry 1 }

    zxAnPonRmOnuConfFileSvrUserName OBJECT-TYPE
        SYNTAX      DisplayString(SIZE (0..16))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute identifies the user name for service configuration
             server authentication."
        REFERENCE   "GPON:9.12.13 File transfer controller;EPON:Private OAM."
        ::= { zxAnPonRmOnuConfFileSvrEntry 2 }

    zxAnPonRmOnuConfFileSvrPassword OBJECT-TYPE
        SYNTAX      DisplayString(SIZE (0..16))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute identifies the password for service configuration
             server  authentication."
        REFERENCE   "GPON:9.12.13 File transfer controller;EPON:Private OAM."
        ::= { zxAnPonRmOnuConfFileSvrEntry 3 }

    zxAnPonRmOnuConfFileSvrFileName OBJECT-TYPE
        SYNTAX      DisplayString(SIZE (0..32))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute identifies the service configuration file name
             that the  ONU download from service configuration server.
             if zxAnPonRmOnuConfFileSvrAddress is't null and this attribute
             is null, then it identifies that ONU will download default file."
        REFERENCE   "GPON:9.12.13 File transfer controller;EPON:Private OAM."
        ::= { zxAnPonRmOnuConfFileSvrEntry 4 }

--------------------------------------------------------------------------------
--7   zxAnPonRmOnuWifiObjects begin
--7.2 ONU WiFi Interface Capability Table
-------------------------------------------------------------------------------
    zxAnPonRmWifiIfCapabilityTable    OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmWifiIfCapabilityEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU WiFi interface capability table.
             This table is only supported by EPON ONU."
        ::=  { zxAnPonRmOnuWifiObjects  2 }

    zxAnPonRmWifiIfCapabilityEntry   OBJECT-TYPE
        SYNTAX      ZxAnPonRmWifiIfCapabilityEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU WiFi interface capability entry. "
        INDEX {  ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex }
        ::=  { zxAnPonRmWifiIfCapabilityTable 1 }

    ZxAnPonRmWifiIfCapabilityEntry  ::=  SEQUENCE {
        zxAnPonRmWifiIfSsidNumber               Integer32,
        zxAnPonRmWifiIfAuthAlgorithm            BITS,
        zxAnPonRmWifiIfRegulatoryDomains        BITS,
        zxAnPonRmWifiWirelessWorkMode           BITS
        }

    zxAnPonRmWifiIfSsidNumber OBJECT-TYPE
        SYNTAX      Integer32(1..8)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The number of WiFi interface SSID ."
        ::= { zxAnPonRmWifiIfCapabilityEntry 2 }

    zxAnPonRmWifiIfAuthAlgorithm   OBJECT-TYPE
        SYNTAX  BITS {
            openSystem(0),
            sharedKey(1),
            wpaPsk(2),
            wpa2Psk(3)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This attribute indicates all of the authentication algorithms
            supported by the STAs. The attribute is a bit map,
            format as follows:
            Bit 0 indicates 'Open System'
            Bit 1 indicates 'Shared Key'
            Bit 2 indicates 'WPA-PSK'
            Bit 3 indicates 'WPA2-PSK'
            Each bit,0 indicates not supported, 1 indicates supportd."
        ::= { zxAnPonRmWifiIfCapabilityEntry 3 }

    zxAnPonRmWifiIfRegulatoryDomains   OBJECT-TYPE
        SYNTAX  BITS {
            fcc(0),
            doc(1),
            etsi(2),
            spain(3),
            france(4),
            mkk(5),
            china(6)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Operational requirements differ, depending on the regulatory
             domain. This attribute list describes the regulatory domains
             that the PLCP and PMD support in this implementation.
             The attribute is a bit map, formatted as follows:
             Bit 0 indicates 'FCC (USA)'
             Bit 1 indicates 'DOC (Canada)'
             Bit 2 indicates 'ETSI (most of Europe)'
             Bit 3 indicates 'Spain'
             Bit 4 indicates 'France'
             Bit 5 indicates 'MKK'
             Bit 6 indicates 'China'.
             Each bit,0 indicates not supported, 1 indicates supportd."
        ::= { zxAnPonRmWifiIfCapabilityEntry 4 }

    zxAnPonRmWifiWirelessWorkMode OBJECT-TYPE
        SYNTAX  BITS {
            ieee802for11b(0),
            ieee802for11g(1),
            ieee802for11n(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The wireless work mode of WiFi interface.
             The attribute is a bit map,
             format as follows:
             Bit 0 indicates '802.11b'
             Bit 1 indicates '802.11g'
             Bit 2 indicates '802.11n'.
             Each bit,0 indicates not supported, 1 indicates supportd."
        ::=  {  zxAnPonRmWifiIfCapabilityEntry  5 }

-------------------------------------------------------------------------------
--7.3 ONU WiFi Interface Table
-------------------------------------------------------------------------------
    zxAnPonRmWifiUniTable    OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmWifiUniEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU 2.4G WiFi interface table. "
        ::=  { zxAnPonRmOnuWifiObjects  3 }

    zxAnPonRmWifiUniEntry   OBJECT-TYPE
        SYNTAX      ZxAnPonRmWifiUniEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU 2.4G WiFi interface entry."
        INDEX { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex }
        ::=  { zxAnPonRmWifiUniTable 1 }

    ZxAnPonRmWifiUniEntry  ::=  SEQUENCE {
        zxAnPonRmWifiIfAdminStatus            INTEGER,
        zxAnPonRmWifiIfOperationalStatus      INTEGER,
        zxAnPonRmWifiIfRadioMeasEnable        INTEGER,
        zxAnPonRmWifiIfIsolationEnable        INTEGER,
        zxAnPonRmWifiIfSgiEnable              INTEGER,
        zxAnPonRmWifiIfWirelessWorkMode       BITS,
        zxAnPonRmWifiIfRegulatoryDomain       INTEGER,
        zxAnPonRmWifiIfChannel                INTEGER,
        zxAnPonRmWifiIfChannelBandwidth       INTEGER,
        zxAnPonRmWifiIfQosType                INTEGER,
        zxAnPonRmWifiIfTxRate                 INTEGER,
        zxAnPonRmWifiIfTxPower                INTEGER
        }

    zxAnPonRmWifiIfAdminStatus OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the WiFi interface function."
        DEFVAL    { enabled }
        ::= { zxAnPonRmWifiUniEntry 1 }

    zxAnPonRmWifiIfOperationalStatus OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The operational status of WiFi interface."
        ::= { zxAnPonRmWifiUniEntry 2 }

    zxAnPonRmWifiIfRadioMeasEnable OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the radio measurement function."
        DEFVAL    { disabled }
        ::=  {  zxAnPonRmWifiUniEntry  3 }

    zxAnPonRmWifiIfIsolationEnable OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the SSID isolation function."
        DEFVAL    { enabled }
        ::=  {  zxAnPonRmWifiUniEntry  4 }

     zxAnPonRmWifiIfSgiEnable OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute enable or disable the SGI function.
             This attribute is valid when zxAnPonRmWifiIfWirelessWorkMode
             is '802.11n' and '802.11b-11g-11n'."
        DEFVAL    { disabled }
        ::=  {  zxAnPonRmWifiUniEntry  5 }

    zxAnPonRmWifiIfWirelessWorkMode OBJECT-TYPE
        SYNTAX  BITS {
            ieee802for11b(0),
            ieee802for11g(1),
            ieee802for11n(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The wireless work mode of WiFi interface.
             The attribute is a bit map,
             format as follows:
             Bit 0 indicates '802.11b'
             Bit 1 indicates '802.11g'
             Bit 2 indicates '802.11n'.
             Each bit,0 indicates not supported, 1 indicates supportd."
        DEFVAL    { {ieee802for11b,ieee802for11g , ieee802for11n}}
        ::=  {  zxAnPonRmWifiUniEntry  6 }

    zxAnPonRmWifiIfRegulatoryDomain OBJECT-TYPE
        SYNTAX      INTEGER{
            other(1),
            usa(2),
            canada(3),
            etsi(4),
            spain(5),
            france(6),
            mkk(7),
            china(8),
            russia(9),
            brazil(10),
            egypt(11),
            germany(12),
            greece(13),
            hongkong(14),
            italy(15),
            korea(16),
            uk(17),
            portugal(18),
            lithuania(19)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The current regulatory domain.
            The values 'mkk' and 'etsi' are only suported by EPON.
            The values only supported by GPON are as follow:
             'russia', 'brazil', 'egypt', 'germany', 'greece', 'hongkong',
             'italy', 'korea', 'uk', 'portugal', 'lithuania'.
            The value 'brazil' is valid when zxAnPonRmWifiIfWirelessWorkMode
            is '802.11b'."
        DEFVAL    { china }
        ::=  {  zxAnPonRmWifiUniEntry  7 }

    zxAnPonRmWifiIfChannel OBJECT-TYPE
        SYNTAX      INTEGER{
            auto(1),
            channel1(2),
            channel2(3),
            channel3(4),
            channel4(5),
            channel5(6),
            channel6(7),
            channel7(8),
            channel8(9),
            channel9(10),
            channel10(11),
            channel11(12),
            channel12(13),
            channel13(14)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute defines the channel. This attribute can not be
            assigned as 'channel12' and 'channel13' when
            zxAnPonRmWifiIfRegulatoryDomain is 'fcc' or 'doc'."
        DEFVAL    { auto }
        ::=  {  zxAnPonRmWifiUniEntry  8 }

    zxAnPonRmWifiIfChannelBandwidth OBJECT-TYPE
        SYNTAX      INTEGER{
            for20Mhz(1),
            for40Mhz(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute defines the channel bandwidth of WiFi interface.
             This attribute is valid when zxAnPonRmWifiIfWirelessWorkMode
             is '802.11n' and '802.11b-11g-11n'."
        DEFVAL    { for20Mhz }
        ::=  {  zxAnPonRmWifiUniEntry  9 }

    zxAnPonRmWifiIfQosType OBJECT-TYPE
        SYNTAX      INTEGER{
            disabled(1),
            wmm(2),
            ssid(3)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute defines the QoS type."
        DEFVAL    { wmm }
        ::=  {  zxAnPonRmWifiUniEntry  10 }

    zxAnPonRmWifiIfTxRate OBJECT-TYPE
        SYNTAX      INTEGER{
            auto(1),
            for1Mbps(2),
            for2Mbps(3),
            for5Dot5Mbps(4),
            for6Mbps(5),
            for9Mbps(6),
            for11Mbps(7),
            for12Mbps(8),
            for18Mbps(9),
            for24Mbps(10),
            for36Mbps(11),
            for48Mbps(12),
            for54Mbps(13)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute defines the transmitting rate.
            When zxAnPonRmWifiIfWirelessWorkMode is '802.11b', this attribute
            can only be assigned as 'auto', 'for1Mbps', 'for2Mbps',
            'for5Dot5Mbps' and 'for11Mbps'.
            When zxAnPonRmWifiIfWirelessWorkMode is '802.11n' and
            '802.11b-11g-11n', this attribute
            can only be assigned as 'auto'."
        DEFVAL    { auto }
        ::=  {  zxAnPonRmWifiUniEntry  11 }

     zxAnPonRmWifiIfTxPower OBJECT-TYPE
        SYNTAX      INTEGER{
            percent100(1),
            percent80(2),
            percent60(3),
            percent40(4),
            percent20(5)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This attribute defines the transmitting power."
        DEFVAL    { percent100 }
        ::=  {  zxAnPonRmWifiUniEntry  12 }

-------------------------------------------------------------------------------
--7.4 ONU WiFi SSID Table
-------------------------------------------------------------------------------
    zxAnPonRmWifiSsidTable    OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmWifiSsidEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU WiFi SSID table."
        ::=  { zxAnPonRmOnuWifiObjects  4 }

    zxAnPonRmWifiSsidEntry   OBJECT-TYPE
        SYNTAX      ZxAnPonRmWifiSsidEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU WiFi SSID entry.
            "
        INDEX { ifIndex, zxAnPonOnuIndex,
                zxAnPonRmOnuUniIndex, zxAnPonRmWifiSsid }
        ::=  { zxAnPonRmWifiSsidTable 1 }

    ZxAnPonRmWifiSsidEntry  ::=  SEQUENCE {
        zxAnPonRmWifiSsid                       Integer32,
        zxAnPonRmWifiSsidName                   DisplayString,
        zxAnPonRmWifiSsidAdminStatus            INTEGER,
        zxAnPonRmWifiSsidHideEnable             INTEGER,
        zxAnPonRmWifiSsidIsolationEnable        INTEGER,
        zxAnPonRmWifiSsidMaxUserNum             Integer32,
        zxAnPonRmWifiSsidCurrentUserNum         Integer32,
        zxAnPonRmWifiSsidMacAddress             MacAddress,
        zxAnPonRmWifiSsidAuthAlgorithm          INTEGER,
        zxAnPonRmWifiSsidWepEnable              INTEGER,
        zxAnPonRmWifiSsidWepKeyLen              INTEGER,
        zxAnPonRmWifiSsidWepKeyFormat           INTEGER,
        zxAnPonRmWifiSsidWepKeyValue            DisplayString,
        zxAnPonRmWifiSsidWepDefKey              Integer32,
        zxAnPonRmWifiSsidWpaInterval            Integer32,
        zxAnPonRmWifiSsidWpaAlgorithm           BITS,
        zxAnPonRmWifiSsidWpaKeyValue            DisplayString
        }

    zxAnPonRmWifiSsid OBJECT-TYPE
        SYNTAX      Integer32(1..8)
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU WiFi SSID(Service Set Identifier)."
        ::= { zxAnPonRmWifiSsidEntry 1 }

    zxAnPonRmWifiSsidName   OBJECT-TYPE
        SYNTAX      DisplayString (SIZE (0..32))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The SSID name."
        ::= { zxAnPonRmWifiSsidEntry 2 }

    zxAnPonRmWifiSsidAdminStatus OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the SSID."
        DEFVAL    { enabled }
        ::=  {  zxAnPonRmWifiSsidEntry 3 }

    zxAnPonRmWifiSsidHideEnable OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the SSID hide function."
        DEFVAL    { disabled }
        ::=  {  zxAnPonRmWifiSsidEntry  4 }

    zxAnPonRmWifiSsidIsolationEnable OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the SSID user isolation function."
        DEFVAL    { enabled }
        ::=  {  zxAnPonRmWifiSsidEntry  5 }

    zxAnPonRmWifiSsidMaxUserNum OBJECT-TYPE
        SYNTAX      Integer32(1..65535)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The maximum SSID user number."
        DEFVAL    { 32 }
        ::= { zxAnPonRmWifiSsidEntry 6 }

    zxAnPonRmWifiSsidCurrentUserNum OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The current SSID user number."
        ::= { zxAnPonRmWifiSsidEntry 7 }

    zxAnPonRmWifiSsidMacAddress OBJECT-TYPE
        SYNTAX      MacAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This MAC address associated with this SSID."
        ::= { zxAnPonRmWifiSsidEntry 8 }

    zxAnPonRmWifiSsidAuthAlgorithm   OBJECT-TYPE
        SYNTAX  INTEGER {
            openSystem(1),
            sharedKey(2),
            wpaPsk(3),
            wpa2Psk(4),
            wpaPskAndWpa2Psk(5)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The SSID authentication algorithms."
        DEFVAL    { wpaPskAndWpa2Psk }
        ::= { zxAnPonRmWifiSsidEntry 9 }

    zxAnPonRmWifiSsidWepEnable OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the WEP encryption function.
             The attribute is valid when zxAnPonRmWifiSsidAuthAlgorithm is
             openSystem or sharedKey."
        ::=  {  zxAnPonRmWifiSsidEntry  10 }

    zxAnPonRmWifiSsidWepKeyLen OBJECT-TYPE
        SYNTAX      INTEGER{
            for64(1),
            for128(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The WEP encryption key bits length.
             The attribute is valid when zxAnPonRmWifiSsidWepEncryEnable is
             enabled."
        DEFVAL { for64 }
        ::=  {  zxAnPonRmWifiSsidEntry  11 }

    zxAnPonRmWifiSsidWepKeyFormat OBJECT-TYPE
        SYNTAX      INTEGER{
            ascii(1),
            hex(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The WEP encryption key format.
             The attribute is valid when zxAnPonRmWifiSsidWepEncryEnable is
             enabled."
        DEFVAL { ascii }
        ::=  {  zxAnPonRmWifiSsidEntry  12 }

    zxAnPonRmWifiSsidWepKeyValue   OBJECT-TYPE
        SYNTAX      DisplayString (SIZE (0|20|40|52|104))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The WEP encryption key value that consists of four groups
             ASCII or hex value,format as follows:
             for64 and ascii -- each group consists of 5 bytes string;
             for128 and ascii -- each group consists of 13 bytes string;
             for64 and hex -- each group consists of 10 bytes hex string;
             for128 and hex -- each group consists of 26 bytes hex string;
             The attribute is valid when zxAnPonRmWifiSsidWepEncryEnable is
             enable.
             It should be NULL when this entry used WAP authenticaton."
        ::= { zxAnPonRmWifiSsidEntry 13 }

    zxAnPonRmWifiSsidWepDefKey OBJECT-TYPE
        SYNTAX      Integer32(1..4)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The default WEP encryption key index.
             The attribute is valid when zxAnPonRmWifiSsidWepEncryEnable is
             enabled."
        DEFVAL      { 1 }
        ::= { zxAnPonRmWifiSsidEntry 14 }

    zxAnPonRmWifiSsidWpaInterval OBJECT-TYPE
        SYNTAX      Integer32(100..1000)
        UNITS       "seconds"
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The WPA encryption key updating interal.
             The attribute is valid when zxAnPonRmWifiSsidAuthAlgorithm is
             wpaPsk or wpa2Psk or wpaPskAndWpa2Psk."
        DEFVAL    { 600 }
        ::= { zxAnPonRmWifiSsidEntry 15 }

     zxAnPonRmWifiSsidWpaAlgorithm OBJECT-TYPE
        SYNTAX  BITS {
            aes(0),
            tkip(1),
            wep(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The WPA encryption Algorithm.
             The attribute is valid when zxAnPonRmWifiSsidAuthAlgorithm is
             wpaPsk or wpa2Psk or wpaPskAndWpa2Psk.
             The attribute is a bit map,
             format as follows:
             Bit 0 indicates 'AES'
             Bit 1 indicates 'TKIP'
             Bit 2 indicates 'WEP'.
             Each bit,0 indicates not supported, 1 indicates supportd."
        DEFVAL   { { aes, tkip}}
        ::=  {  zxAnPonRmWifiSsidEntry  16 }

    zxAnPonRmWifiSsidWpaKeyValue   OBJECT-TYPE
        SYNTAX      DisplayString (SIZE (0|8..63))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The WPA encryption key value that consists of 8-63 bytes string;
             The attribute is valid when zxAnPonRmWifiSsidAuthAlgorithm is
             wpaPsk or wpa2Psk or wpaPskAndWpa2Psk.
             It should be NULL when this entry used WEP authenticaton.
             "
        ::= { zxAnPonRmWifiSsidEntry 17 }

-------------------------------------------------------------------------------
--7.5.ONU WiFi SSID VLAN Tagging Table
-------------------------------------------------------------------------------
    zxAnPonRmWifiSsidVlanTable    OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmWifiSsidVlanEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU WiFi SSID VLAN tagging configuration table.
             This table is only supported by EPON ONU."
        ::=  { zxAnPonRmOnuWifiObjects  5 }

    zxAnPonRmWifiSsidVlanEntry   OBJECT-TYPE
        SYNTAX      ZxAnPonRmWifiSsidVlanEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "ONU WiFi SSID VLAN tagging configuration entry. "
        INDEX { ifIndex, zxAnPonOnuIndex,
                zxAnPonRmOnuUniIndex, zxAnPonRmWifiSsid }
        ::=  { zxAnPonRmWifiSsidVlanTable 1 }

    ZxAnPonRmWifiSsidVlanEntry  ::=  SEQUENCE {
        zxAnPonRmWifiSsidVlanEnable             INTEGER,
        zxAnPonRmWifiSsidVlan                   Integer32,
        zxAnPonRmWifiSsidPriority               Integer32
        }

    zxAnPonRmWifiSsidVlanEnable OBJECT-TYPE
        SYNTAX      INTEGER{
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Enable or disable the VLAN tag function."
        DEFVAL    { disabled }
        ::=  {  zxAnPonRmWifiSsidVlanEntry  1 }

    zxAnPonRmWifiSsidVlan OBJECT-TYPE
        SYNTAX      Integer32(1..4094)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "VLAN ID.
             The attribute is valid when zxAnPonRmWifiSsidVlanEnable
             is enabled."
        DEFVAL    { 1 }
        ::= { zxAnPonRmWifiSsidVlanEntry 2 }

    zxAnPonRmWifiSsidPriority OBJECT-TYPE
        SYNTAX      Integer32(0..7)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Priority."
        DEFVAL    { 0 }
        ::= { zxAnPonRmWifiSsidVlanEntry 3 }

