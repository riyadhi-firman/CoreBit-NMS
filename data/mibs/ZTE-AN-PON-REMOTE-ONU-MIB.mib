--------------------------------------------------------------------------------    
    zxAnPonRmProtoEnablePrfTable   OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmProtoEnablePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION 
            "This table includes protocol enable profile information."
        ::=  { zxAnPonRmOnuProtocolObjects  3 }
        
    zxAnPonRmProtoEnablePrfEntry   OBJECT-TYPE
        SYNTAX      ZxAnPonRmProtoEnablePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION 
            "An entry in zxAnPonRmProtoEnablePrfTable."        
        INDEX { zxAnPonRmProtoEnablePrfName }
        ::=  { zxAnPonRmProtoEnablePrfTable 1 }
        
    ZxAnPonRmProtoEnablePrfEntry  ::=  SEQUENCE {
        zxAnPonRmProtoEnablePrfName        DisplayString,
        zxAnPonRmDhcpRelayEnable           INTEGER,
        zxAnPonRmDhcpOption82Enable        INTEGER,
        zxAnPonRmPppoeIntermediateEnable   INTEGER,
        zxAnPonRmArpInspectionEnable       INTEGER,
        zxAnPonRmIptvAgeByLeaseEnable      INTEGER,  
        zxAnPonRmProtoEnableRowstatus      RowStatus        
        }                  
                              
    zxAnPonRmProtoEnablePrfName    OBJECT-TYPE
        SYNTAX      DisplayString  ( SIZE ( 1 .. 64  ) )
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The profile name."
        ::= { zxAnPonRmProtoEnablePrfEntry 1 }
        
    zxAnPonRmDhcpRelayEnable OBJECT-TYPE
        SYNTAX      INTEGER{
                    enabled(1),
                    disabled(2)
                    }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION 
            "Enable or disable the DHCP relay function."
        DEFVAL    { disabled }  
        ::=  {  zxAnPonRmProtoEnablePrfEntry  2 }  
        
    zxAnPonRmDhcpOption82Enable OBJECT-TYPE
        SYNTAX      INTEGER{
                    enabled(1),
                    disabled(2)
                    }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION 
            "Enable or disable the DHCP-option82 function."
        DEFVAL    { disabled }  
        ::=  {  zxAnPonRmProtoEnablePrfEntry  3 }
        
    zxAnPonRmPppoeIntermediateEnable OBJECT-TYPE
        SYNTAX      INTEGER{
                    enabled(1),
                    disabled(2)
                    }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION 
            "Enable or disable the PPPoE intermediate function."
        DEFVAL    { disabled }  
        ::=  {  zxAnPonRmProtoEnablePrfEntry  4 }
        
    zxAnPonRmArpInspectionEnable OBJECT-TYPE
        SYNTAX      INTEGER{
                    enabled(1),
                    disabled(2)
                    }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION 
            "Enable or disable the ARP inspection function."
        DEFVAL    { disabled }  
        ::=  {  zxAnPonRmProtoEnablePrfEntry  5 }
        
     zxAnPonRmIptvAgeByLeaseEnable OBJECT-TYPE
        SYNTAX      INTEGER{
                    enabled(1),
                    disabled(2)
                    }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION 
            "Enable or disable the IPTV age function by DHCP lease."
        DEFVAL    { enabled }  
        ::=  {  zxAnPonRmProtoEnablePrfEntry  6 }                                            
        
    zxAnPonRmProtoEnableRowstatus OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.  
            
            The supported actions of this conceptual row only include:

            To create a row in this table, a manager must
            set this object to createAndGo(4).
          
            To delete a row in this table, a manager must
            set this object to destroy(6). 
            To query this object, always return 1. "       
        ::= { zxAnPonRmProtoEnablePrfEntry 50 } 
