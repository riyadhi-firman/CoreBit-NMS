        DEFVAL  { 60 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 2 }

   zxAnPonRmGfastSnrmTargetSnrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream target signal-to-noise ratio margin for the channel
             initialization policy."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 3,
             ITU-T G.997.2, paragraph 7.1.3.2"
        DEFVAL  { 60 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 3 }

    zxAnPonRmGfastSnrmMaxSnrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310|511)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream maximum signal-to-noise ratio margin used in the channel
             initialization policy.
             The special value indicates there is no maximum bound for the
             downstream signal-to-noise ratio margin (i.e., the downstream
             maximum signal-to-noise ratio margin is infinite)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 3,
             ITU-T G.997.2, paragraph #7.1.3.3"
        DEFVAL  { 511 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 4 }

    zxAnPonRmGfastSnrmMaxSnrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310|511)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream maximum signal-to-noise ratio margin used in the channel
             initialization policy.
             A value of 0x7FFFFFFF (2147483647) indicates there is no maximum
             bound for the upstream signal-to-noise ratio margin (i.e., the
             upstream maximum signal-to-noise ratio margin is infinite)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 3,
             ITU-T G.997.2, paragraph #7.1.3.4"
        DEFVAL  { 511 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 5 }

    zxAnPonRmGfastSnrmMinSnrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Downstream minimum signal-to-noise ratio margin the FTU-R receiver
             shall tolerate. If the downstream signal-to-noise ratio margin
             (SNRMds) falls below this level, the FTU-R requests the FTU-O to
             increase the FTU-O transmit power. If an increase to FTU-O transmit
             power is not possible, a loss-of-margin (lom) defect occurs. Upon
             persistency of the lom defect, the FTU-R triggers a
             re-initialization (see clause 12.1.4.2/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 3,
             ITU-T G.997.2, paragraph #7.1.3.5"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 6 }

    zxAnPonRmGfastSnrmMinSnrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Upstream minimum signal-to-noise ratio margin the FTU-O receiver
             shall tolerate. If the upstream signal-to-noise ratio margin
             (SNRMus) falls below this level, the FTU-O requests the FTU-R to
             increase the FTU-R transmit power. If an increase to FTU-R transmit
             power is not possible, a loss-of-margin (lom) defect occurs. Upon
             persistency of the lom defect, the FTU-O triggers a
             re-initialization (see clause 12.1.4.2/G.9701)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 3,
             ITU-T G.997.2, paragraph #7.1.3.6"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 7 }

    zxAnPonRmGfastSnrmSraUsNrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "If the downstream signal-to-noise ratio margin (SNRMds) is above
             the downstream upshift signal-to-noise ratio margin and stays above
             that for more than the time specified by the downstream minimum
             upshift rate adaptation interval (SRA-UTIMEds), the FTU-R
             autonomously attempts to increase the downstream net data rate
             (NDR)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.1"
        DEFVAL  { 70 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 8 }

    zxAnPonRmGfastSnrmSraUsNrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "If the upstream signal-to-noise ratio margin (SNRMus) is above the
             upstream upshift signal-to-noise ratio margin and stays above that
             for more than the time specified by the upstream minimum upshift
             rate adaptation interval (SRA-UTIMEus), the FTU-O autonomously
             attempts to increase the upstream net data rate (NDR)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.2"
        DEFVAL  { 70 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 9 }

    zxAnPonRmGfastSnrmSraUTimeDs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "Seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Interval of time the downstream signal-to-noise ratio margin
             (SNRMds) should stay above the downstream upshift signal-to-noise
             ratio margin (SRA-USNRMds) before the FTU-R autonomously attempts
             to increase the downstream net data rate (NDRds)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.3"
        DEFVAL  { 8 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 10 }

    zxAnPonRmGfastSnrmSraUTimeUs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "Seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Interval of time the upstream signal-to-noise ratio margin (SNRMus)
             should stay above the upstream upshift signal-to-noise ratio margin
             (SRA-USNRMus) before the FTU-O autonomously attempts to increase
             the upstream net data rate (NDRus)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.4"
        DEFVAL  { 8 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 11 }

    zxAnPonRmGfastSnrmSraDsNrmDs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "If the downstream signal-to-noise ratio margin (SNRMds) is below
             the downstream downshift signal-to-noise ratio margin and stays
             below that for more than the time specified by the downstream
             minimum downshift rate adaptation interval (SRA-DTIMEds), the FTU-R
             autonomously attempts to decrease the downstream net data rate
             (NDRds)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.5"
        DEFVAL  { 50 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 12 }

    zxAnPonRmGfastSnrmSraDsNrmUs  OBJECT-TYPE
        SYNTAX      Integer32(0..310)
        UNITS       "0.1dB"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "If the upstream signal-to-noise ratio margin (SNRMus) is below the
             upstream downshift signal-to-noise ratio margin and stays below
             that for more than the time specified by the upstream minimum
             downshift rate adaptation interval (SRA-DTIMEus), the FTU-O
             autonomously attempts to decrease the upstream net data rate
             (NDRus)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.6"
        DEFVAL  { 50 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 13 }

    zxAnPonRmGfastSnrmSraDTimeDs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "Seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Defines the interval of time the downstream signal-to-noise ratio
             margin (SNRMds) should stay below the downstream downshift
             signal-to-noise ratio margin (SRA-DSNRMds) before the FTU-R
             autonomously attempts to decrease the downstream net data rate
             (NDRds)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.7"
        DEFVAL  { 2 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 14 }

    zxAnPonRmGfastSnrmSraDTimeUs  OBJECT-TYPE
        SYNTAX      Integer32(0..16383)
        UNITS       "Seconds"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Defines the interval of time the upstream signal-to-noise ratio
             margin (SNRMus) should stay below the upstream downshift
             signal-to-noise ratio margin (SRA-DSNRMus) before the FTU-O
             autonomously attempts to decrease the upstream net data rate
             (NDRus)."
        REFERENCE   
            "ITU-T G.988 9.7.50 FAST line configuration extension part 4,
             ITU-T G.997.2, paragraph #7.1.4.8"
        DEFVAL  { 2 }
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 15 }

    zxAnPonRmGfastSnrmRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.

             The supported actions of this conceptual row only include:
             'createAndGo' and 'destroy'.

             To create a row in this table, a manager must set this object to
             createAndGo(4), and must comply with the multi-variables binding
             rule described in zxAnPonRmGfastSnrMarginPrfEntry.

             To delete a row in this table, a manager must set this object to
             destroy(6).

             To get this object, the agent always returns active(1)."
        ::= { zxAnPonRmGfastSnrMarginPrfEntry 50 }

