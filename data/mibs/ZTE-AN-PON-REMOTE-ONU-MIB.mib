    }

    zxAnPonRmIpoeTestAuthMode OBJECT-TYPE
        SYNTAX      INTEGER {
            option60String(1),
            usernameAndPassword(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "IPoE test authentication mode.
             option60String(1)      - authenticate using
                                      zxAnPonRmIpoeTestOption60String.
             usernameAndPassword(2) - authenticate using 
                                      zxAnPonRmIpoeTestUsername
                                      and zxAnPonRmIpoeTestPassword."
        REFERENCE
            "GPON in ZXPON ZTE private OMCI & PLOAM Specification 3.8.5~3.8.6;
            EPON in ZXPON ZTE private extended 
            OAM Specification 3.3.2.30~3.3.2.31"
        DEFVAL      { option60String }
        ::= { zxAnPonRmOnuIpoeTestEntry 1 }

    zxAnPonRmIpoeTestUsername  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..64))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The user name.
             This object is valid when zxAnPonRmIpoeTestAuthMode is
             usernameAndPassword(2)."
        REFERENCE
            "GPON in ZXPON ZTE private OMCI & PLOAM Specification 3.8.5~3.8.6;
            EPON in ZXPON ZTE private extended 
            OAM Specification 3.3.2.30~3.3.2.31"
        ::= { zxAnPonRmOnuIpoeTestEntry 2 }

    zxAnPonRmIpoeTestPassword  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..16))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The password. Max size is 16 for epon and gpon.
             This object is valid when zxAnPonRmIpoeTestAuthMode is
             usernameAndPassword(2)."
        ::= { zxAnPonRmOnuIpoeTestEntry 3 }

    zxAnPonRmIpoeTestClientMac  OBJECT-TYPE
        SYNTAX      MacAddress
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The IPoE test client MAC address."
        ::= { zxAnPonRmOnuIpoeTestEntry 4 }

    zxAnPonRmIpoeTestOption60  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..128))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The option60 for IPoE test.
             This object is valid when zxAnPonRmIpoeTestAuthMode is
             option60String(1).
            "
        ::= { zxAnPonRmOnuIpoeTestEntry 5 }

    zxAnPonRmIpoeTestVid OBJECT-TYPE
        SYNTAX      Integer32 (0..4094)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The VLAN id of interface which will be used in testing datagram.

            0 means that test will use the PVID of interface.
            Non-zero value must be within the tagged VLAN list of interface. If
            ONU can not find the VLAN in the tagged VLAN list of interface, test
             will fail."
        DEFVAL { 0 }
        ::= { zxAnPonRmOnuIpoeTestEntry 6 }

   zxAnPonRmIpoeTestTimeout  OBJECT-TYPE
        SYNTAX      Integer32(5..60)
        UNITS       "seconds"
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The IPoE test timed out."
        DEFVAL      { 30 }
        ::= { zxAnPonRmOnuIpoeTestEntry 7 }

   zxAnPonRmIpoeTestClientIpType  OBJECT-TYPE
        SYNTAX       InetAddressType
        MAX-ACCESS   read-only
        STATUS       current
        DESCRIPTION
            "Client IP address type."
        ::= { zxAnPonRmOnuIpoeTestEntry 8 }

    zxAnPonRmIpoeTestClientIpAddr  OBJECT-TYPE
        SYNTAX      InetAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IP address that is distributed by BAS when IPoE test is
             completed successfully.
            "
        ::= { zxAnPonRmOnuIpoeTestEntry 9 }

    zxAnPonRmIpoeTestGatewayIpType  OBJECT-TYPE
        SYNTAX       InetAddressType
        MAX-ACCESS   read-only
        STATUS       current
        DESCRIPTION
            "The gateway IP address type."
        ::= { zxAnPonRmOnuIpoeTestEntry 10 }

    zxAnPonRmIpoeTestGatewayIpAddr  OBJECT-TYPE
        SYNTAX      InetAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The gateway IP address."
        ::= { zxAnPonRmOnuIpoeTestEntry 11 }

    zxAnPonRmIpoeTestPingTimes OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The all times for IPoE test ping gateway."
        ::= { zxAnPonRmOnuIpoeTestEntry 12 }

    zxAnPonRmIpoeTestPingSucTimes OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The successful times for IPoE test ping gateway."
        ::= { zxAnPonRmOnuIpoeTestEntry 13 }

    zxAnPonRmIpoeTestPingMaxDelay OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The maximum delay for IPoE test ping gateway."
        ::= { zxAnPonRmOnuIpoeTestEntry 14 }

    zxAnPonRmIpoeTestPingMinDelay OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The minimum delay for IPoE test ping gateway."
        ::= { zxAnPonRmOnuIpoeTestEntry 15 }

    zxAnPonRmIpoeTestPingAvgDelay OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average delay for IPoE test ping gateway ."
        ::= { zxAnPonRmOnuIpoeTestEntry 16 }

    zxAnPonRmIpoeTestAction OBJECT-TYPE
        SYNTAX      INTEGER {
            start(1),
            stop(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The object is used to start or stop test.

            start(1) - Start the test.
            stop(2)  - Stop the test."
        REFERENCE
            "GPON in ZXPON ZTE private OMCI & PLOAM Specification 3.8.5~3.8.6;
            EPON in ZXPON ZTE private extended 
            OAM Specification 3.3.2.30~3.3.2.31"
        ::= { zxAnPonRmOnuIpoeTestEntry 17 }

    zxAnPonRmIpoeTestStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            notStarted(1),
            inProgress(2),
            success(3),
            failed(4)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The status of test. Agent need keep this parameter updated so that
            manager can get the latest status of test by polling.

            notStarted(1) - test is not started
            inProgress(2) - test is in progress
            success(3) - test is completed successfully
            failed(4) - test failed
            "
        ::= { zxAnPonRmOnuIpoeTestEntry 18 }

    zxAnPonRmIpoeTestFailReason OBJECT-TYPE
        SYNTAX      INTEGER {
            none(1),
            ipoeDiscoverTimeOut(2),
            ipoeRequestTimeOut(3),
            ipoeAuthFailed(4),
            ipoeUnavailable(5),
            ipoeTestTimeOut(6),
            unknownError(7),
            vlanNotExist(8)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed reason of test.

            none(1)                - no error
            ipoeDiscoverTimeOut(2) - IPoE discover timed out.
            ipoeRequestTimeOut(3)  - IPoE request timed out.
            ipoeAuthFailed(4)      - IPoE authentication failed.
            ipoeUnavailable(5)     - IPoE unavailable.
            ipoeTestTimeOut(6)     - IPoE test timed out.
            unknownError(7)        - unknown error
            vlanNotExist(8)        - Specified VLAN is not existed.
            "
        ::= { zxAnPonRmOnuIpoeTestEntry 19 }

