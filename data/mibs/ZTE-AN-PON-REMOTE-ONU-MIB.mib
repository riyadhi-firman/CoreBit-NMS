-- 11.1 zxAnPonRmGfastDsDataRatePrfTable
-- ITU-T G.988 9.7.53 FAST channel config profile
-- ITU-T G.997.2, clause 7.2.1.1   
-------------------------------------------------------------------------------
   zxAnPonRmGfastDsDataRatePrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmGfastDsDataRatePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Downstream data rate configuration profile table."
        ::= { zxAnPonRmGfastLineProfileObjects 2 }

    zxAnPonRmGfastDsDataRatePrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmGfastDsDataRatePrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Downstream data rate configuration profile entry."
        INDEX  { zxAnPonRmGfastDsDRPrfName }
        ::= { zxAnPonRmGfastDsDataRatePrfTable 1 }

    ZxAnPonRmGfastDsDataRatePrfEntry  ::= SEQUENCE {
        zxAnPonRmGfastDsDRPrfName        DisplayString,
        zxAnPonRmGfastDsDRMaxNdr         Unsigned32,
        zxAnPonRmGfastDsDRMinEtr         Unsigned32,
        zxAnPonRmGfastDsDRMaxGdr         Unsigned32,
        zxAnPonRmGfastDsDRMinGdr         Unsigned32,
        zxAnPonRmGfastDsDRPrfRowStatus   RowStatus
    }

    zxAnPonRmGfastDsDRPrfName  OBJECT-TYPE
        SYNTAX      DisplayString(SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Downstream data rate configuration profile name."
        ::= { zxAnPonRmGfastDsDataRatePrfEntry 1 }

    zxAnPonRmGfastDsDRMaxNdr  OBJECT-TYPE
        SYNTAX      Unsigned32(0..4294967295)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum net data rate (see clause 11.4.2.2/G.9701)."        
        REFERENCE
            "ITU-T G.988 9.7.53 FAST channel config profile,
             ITU-T G.997.2, paragraph 7.2.1.1"
        DEFVAL  { 4294967295 }
        ::= { zxAnPonRmGfastDsDataRatePrfEntry 2 }

    zxAnPonRmGfastDsDRMinEtr  OBJECT-TYPE
        SYNTAX      Unsigned32(0..4294967295)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Minimum expected throughput (see clause 11.4.2.1/G.9701)."        
        REFERENCE
            "ITU-T G.988 9.7.53 FAST channel config profile,
             ITU-T G.997.2, paragraph 7.2.1.2"
        DEFVAL  { 0 }
        ::= { zxAnPonRmGfastDsDataRatePrfEntry 3 }

    zxAnPonRmGfastDsDRMaxGdr  OBJECT-TYPE
        SYNTAX      Unsigned32(0..4294967295)
        UNITS       "kbps"
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Maximum value of the GDR (see clause 7.11.1.3).
             The GDR shall not exceed MAXGDR at the start of showtime and during
             showtime."
        REFERENCE
            "ITU-T G.988 9.7.53 FAST channel config profile,
             ITU-T G.997.2, paragraph 7.2.1.3"
        DEFVAL  { 4294967295 }
        ::= { zxAnPonRmGfastDsDataRatePrfEntry 4 }

    zxAnPonRmGfastDsDRMinGdr  OBJECT-TYPE
       SYNTAX      Unsigned32(0..4294967295)
       UNITS       "kbps"
       MAX-ACCESS  read-create
       STATUS      current
       DESCRIPTION
           "Minimum value of the GDR (see clause 7.11.1.3).
            The GDR may be lower than MINGDR. If the GDR is lower than MINGDR
            at initialization or when GDR becomes lower than MINGDR during
            showtime, a threshold crossing alert occurs."
       REFERENCE
            "ITU-T G.988 9.7.53 FAST channel config profile,
             ITU-T G.997.2, paragraph 7.2.1.4"
       DEFVAL   { 0 }
       ::= { zxAnPonRmGfastDsDataRatePrfEntry 5 }

    zxAnPonRmGfastDsDRPrfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.

             The supported actions of this conceptual row only include:
             'createAndGo' and 'destroy'.

             To create a row in this table, a manager must set this object to
             createAndGo(4), and must comply with the multi-variables binding
             rule described in zxAnPonRmGfastDsDataRatePrfEntry.

             To delete a row in this table, a manager must set this object to
             destroy(6).

            To get this object, the agent always returns active(1)."
        ::= { zxAnPonRmGfastDsDataRatePrfEntry 50 }

