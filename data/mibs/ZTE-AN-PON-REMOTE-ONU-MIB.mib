--------------------------------------------------------------------------------

    zxAnPonRmOnuIptvTestTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmOnuIptvTestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The table lists Iptv test entry. The entry indicates The test."
        REFERENCE
            "GPON in ZXPON ZTE private OMCI & PLOAM Specification 3.8.8~3.8.9;
            EPON in ZXPON ZTE private extended 
            OAM Specification 3.3.2.34~3.3.2.35"
        ::= { zxAnPonRmOnuOamObjects 4 }

    zxAnPonRmOnuIptvTestEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmOnuIptvTestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "An entry in the zxAnPonRmOnuIptvTestTable."
        INDEX { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuIfIndex}
        ::= { zxAnPonRmOnuIptvTestTable 1 }

    ZxAnPonRmOnuIptvTestEntry ::= SEQUENCE {
        zxAnPonRmIptvTestDuration       Integer32,
        zxAnPonRmIptvTestVid            Integer32,
        zxAnPonRmIptvTestPriority       Integer32,
        zxAnPonRmIptvTestGroupIpType    InetAddressType,
        zxAnPonRmIptvTestGroupIp        InetAddress,
        zxAnPonRmIptvTestMcastPkts      Counter32,
        zxAnPonRmIptvTestAction         INTEGER,
        zxAnPonRmIptvTestStatus         INTEGER,
        zxAnPonRmIptvTestFailedReason   INTEGER,
        zxAnPonRmIptvTestMcastTraffRate Counter32,
        zxAnPonRmIptvTestMcastBytes     Counter32
    }

    zxAnPonRmIptvTestDuration OBJECT-TYPE
        SYNTAX      Integer32 (1..300)
        UNITS       "seconds"
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The duration of test."
        DEFVAL { 10 }
        ::= { zxAnPonRmOnuIptvTestEntry 1 }

    zxAnPonRmIptvTestPriority OBJECT-TYPE
        SYNTAX      Integer32 (0..7)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The priority of interface which will be used in testing datagram."
        DEFVAL { 0 }
        ::= { zxAnPonRmOnuIptvTestEntry 2 }

    zxAnPonRmIptvTestVid   OBJECT-TYPE
        SYNTAX      Integer32 (0..4094)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The VLAN of interface which will be used in testing datagram.
             Value 0 means untagged.
            "
        ::= { zxAnPonRmOnuIptvTestEntry 3 }

    zxAnPonRmIptvTestGroupIpType    OBJECT-TYPE
        SYNTAX       InetAddressType
        MAX-ACCESS   read-write
        STATUS       current
        DESCRIPTION
            "Multicast group IP address type."
        ::= { zxAnPonRmOnuIptvTestEntry 4 }

    zxAnPonRmIptvTestGroupIp   OBJECT-TYPE
        SYNTAX      InetAddress
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Multicast group IP address.
             The multicast group must be created first.
             If can not find the multicast group, test fail.
            "
        ::= { zxAnPonRmOnuIptvTestEntry 5}

    zxAnPonRmIptvTestMcastPkts OBJECT-TYPE
        SYNTAX      Counter32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Iptv packets counter of successful test."
        ::= { zxAnPonRmOnuIptvTestEntry 6 }

    zxAnPonRmIptvTestAction OBJECT-TYPE
        SYNTAX      INTEGER {
            start(1),
            stop(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The object is used to start or stop test.
            start(1) - Start the test.
            stop(2)  - Stop the test.
            "
        ::= { zxAnPonRmOnuIptvTestEntry 7 }

    zxAnPonRmIptvTestStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            notStarted(1),
            inProgress(2),
            success(3),
            failed(4)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The status of test. Agent need keep this parameter updated so that
            manager can get the latest status of test by polling.

            notStarted(1) - test is not started
            inProgress(2) - test is in progress
            success(3) - test is completed successfully
            failed(4) - test failed
            "
        ::= { zxAnPonRmOnuIptvTestEntry 8 }

    zxAnPonRmIptvTestFailedReason OBJECT-TYPE
        SYNTAX      INTEGER {
            none(1),
            parameterError(2),
            joinFailed(3),
            noTrafficDetected(4),
            unknown(255)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The failed reason of test.

            none(1)                - No error.
            parameterError(2)    - parameters is invalid.
            joinFailed(3)          - Port join group failed.
            noTrafficDetected(4)   - No Iptv traffic is detected.
            unknown(255)           - Unknown error.
            "
        ::= { zxAnPonRmOnuIptvTestEntry 9 }

    zxAnPonRmIptvTestMcastTraffRate OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "kbps"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "IPTV multicast traffic rate of successful test."
        ::= { zxAnPonRmOnuIptvTestEntry 10 }

    zxAnPonRmIptvTestMcastBytes OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Bytes"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "IPTV multicast bytes of successful test."
        ::= { zxAnPonRmOnuIptvTestEntry 11 }

