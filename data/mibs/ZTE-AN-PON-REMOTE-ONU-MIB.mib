    zxAnPonRmXdslSrvPrfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must
            set this object to createAndGo(4), and must comply
            with the multi-variables usage rules in 'zxAnPonRmXdslSrvPrfEntry'
            description.
        
            To delete a row in this table, a manager must
            set this object to destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslSrvPrfEntry 50 }

-------------------------------------------------------------------------------
-- 10.21 zxAnPonRmXdslUniTable
-- G.988 9.7.1 Physical path termination point xDSL UNI part 1.
-------------------------------------------------------------------------------
    zxAnPonRmXdslUniTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslUniEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This managed entity represents the point where physical paths 
            terminate on an xDSL CO modem (xTU-C). The xDSL managed entity 
            family is used for ADSL and VDSL2 services. A legacy family of VDSL 
            managed entities remains valid for [ITU-T G.993.1] VDSL, if needed. 
            It is documented in [ITU-T G.983.2]."
        REFERENCE
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1."
        ::= { zxAnPonRmOnuXdslObjects 21 }

    zxAnPonRmXdslUniEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslUniEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is an entry in the zxAnPonRmXdslUniTable. The index
            'zxAnPonOnuIndex' represents the normal ONU index or the virtual
             ONU index for profile."
        INDEX   { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex }
        ::= { zxAnPonRmXdslUniTable 1 }
               
    ZxAnPonRmXdslUniEntry ::=
        SEQUENCE {
            zxAnPonRmXdslUniLoopbackConf    INTEGER,
            zxAnPonRmXdslUniAdminStatus     INTEGER,
            zxAnPonRmXdslUniOperStatus      INTEGER,
            zxAnPonRmXdslUniArcEnable       INTEGER,
            zxAnPonRmXdslUniArcInterval     Integer32,
            zxAnPonRmXdslUniModemType       INTEGER
        }
   
    zxAnPonRmXdslUniLoopbackConf OBJECT-TYPE
        SYNTAX      INTEGER {
            noLoopback(1),
            loopback2(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Loopback configuration. It can take the following values:
               1 No loopback
               2 Loopback2 (A loopback at the ONU toward the OLT. The OLT can 
            execute a physical level loopback test after loopback2 is set. Upon 
            ME instantiation, the ONU sets this attribute to 0. )"
        REFERENCE   
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1"
        DEFVAL { noLoopback }
        ::= { zxAnPonRmXdslUniEntry 1 }
        
    zxAnPonRmXdslUniAdminStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Administrative status. It activates and deactivates the functions 
            performed by instances of this managed entity."
        REFERENCE
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1"
        DEFVAL { enabled }    
        ::= { zxAnPonRmXdslUniEntry 2 }  
        
    zxAnPonRmXdslUniOperStatus OBJECT-TYPE
        SYNTAX      INTEGER {
            up(1),
            down(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Operational status. It reflects the perceived ability to receive 
            or to generate a valid signal."
        REFERENCE
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1"
        ::= { zxAnPonRmXdslUniEntry 3 }
                    
    zxAnPonRmXdslUniArcEnable OBJECT-TYPE
        SYNTAX      INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The activation of alarm reporting control (ARC) for this PPTP or 
            cardholder. The attribute works in concert with the ARC interval 
            attribute.
               enabled: enables ARC.
               disabled: disables ARC."
        REFERENCE
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1"
        DEFVAL { disabled }
        ::= { zxAnPonRmXdslUniEntry 4 }

    zxAnPonRmXdslUniArcInterval OBJECT-TYPE
        SYNTAX      Integer32(0..255)
        UNITS       "Minutes"
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The interval to be used with the ARC function for this PPTP or 
            cardholder. The values 0 through 254 give the duration in minutes 
            for the NALM-QI timer of M.3100.
            The special value 255 means that the timer never expires."
        REFERENCE
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1"
        DEFVAL { 0 } 
        ::= { zxAnPonRmXdslUniEntry 5 }    

    zxAnPonRmXdslUniModemType OBJECT-TYPE
        SYNTAX      INTEGER {
            undefined(1),
            atm(2),
            ptm(3)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Modem type. If the hardware cannot support the requested modem 
            type, the ONU should deny the provisioning command. For backward 
            compatibility, the attribute is optional, with a default of ATM.
               1 undefined
               2 ATM (default)
               3 PTM (Ethernet)
            Note - Many newer VDSL2 chip sets support only PTM. The ATM default 
            is retained for backward compatibility, but implementers should be 
            aware that the default may need to be overridden by provisioning 
            before the xDSL UNI can be brought into service."
        REFERENCE
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1"
        DEFVAL { atm }     
        ::= { zxAnPonRmXdslUniEntry 6 }

-------------------------------------------------------------------------------
-- 10.22 zxAnPonRmXdslSrvConfTable
-- G.988 9.7.1 Physical path termination point xDSL UNI part 1.
-------------------------------------------------------------------------------
    zxAnPonRmXdslSrvConfTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdslSrvConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "This managed entity represents the point where physical paths 
            terminate on an xDSL CO modem (xTU-C). The xDSL managed entity 
            family is used for ADSL and VDSL2 services. A legacy family of VDSL 
            managed entities remains valid for [ITU-T G.993.1] VDSL, if needed. 
            It is documented in [ITU-T G.983.2]. The index 'zxAnPonRmOnuUniIndex' 
            of this table only supports xDSL UNI."
        REFERENCE
            "G.988 9.7.1 Physical path termination point xDSL UNI part 1."
        ::= { zxAnPonRmOnuXdslObjects 22 }

    zxAnPonRmXdslSrvConfEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslSrvConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is an entry in the zxAnPonRmXdslSrvConfTable. The index
            'zxAnPonOnuIndex' represents the normal ONU index or the virtual
            ONU index for profile."
        INDEX   { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex }
        ::= { zxAnPonRmXdslSrvConfTable 1 }
               
    ZxAnPonRmXdslSrvConfEntry ::=
        SEQUENCE {
            zxAnPonRmXdslSrvConfPrf            DisplayString,
            zxAnPonRmXdslSrvConfRowStatus      RowStatus
        } 
        
    zxAnPonRmXdslSrvConfPrf OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Refers to 'zxAnPonRmXdslSrvPrfName'."
        ::= { zxAnPonRmXdslSrvConfEntry 1 }   
        
    zxAnPonRmXdslSrvConfRowStatus  OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.
            The state of this conceptual row only support
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
        
            To create a row in this table, a manager must
            set this object to createAndGo(4), and must comply
            with the multi-variables usage rules in 'zxAnPonRmXdslSrvConfEntry'
            description.
        
            To delete a row in this table, a manager must
            set this object to destroy(6).
        
            To query this object, always return 1. "
        ::= { zxAnPonRmXdslSrvConfEntry 50 }

-------------------------------------------------------------------------------
-- 10.23 zxAnPonRmXdslRfiConfPrfTable
-- G.988 9.7.11 xDSL downstream RFI bands profile.
-------------------------------------------------------------------------------
    zxAnPonRmXdslRfiConfPrfTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdslRfiConfPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "RFI configuration profile table."
        REFERENCE
            "G.988 9.7.11  xDSL downstream RFI bands profile."
        ::= { zxAnPonRmOnuXdslObjects 23 }

   zxAnPonRmXdslRfiConfPrfEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdslRfiConfPrfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "RFI configuration profile entry."
        INDEX  { zxAnPonRmXdslRfiConfPrfName }
        ::= { zxAnPonRmXdslRfiConfPrfTable 1 }

   ZxAnPonRmXdslRfiConfPrfEntry  ::=
        SEQUENCE {
            zxAnPonRmXdslRfiConfPrfName         DisplayString,
            zxAnPonRmXdslRfiConfBandsDs         Xdsl2RfiBands,
            zxAnPonRmXdslRfiConfPrfRowStatus    RowStatus         
        }
         
    zxAnPonRmXdslRfiConfPrfName  OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..32))
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "RFI configuration profile name."
        ::= { zxAnPonRmXdslRfiConfPrfEntry 1 }

    zxAnPonRmXdslRfiConfBandsDs  OBJECT-TYPE
        SYNTAX      Xdsl2RfiBands
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This value defines a subset of downstream PSD mask
            breakpoints used to notch radio frequency interference (RFI)
            bands.
            Each RFI band is represented by 4 octets: a 16-bit start
            subcarrier index followed by a 16-bit stop subcarrier index.
            There is a maximum of 16 RFI bands allowed.
            The subcarrier index is an unsigned number in the range 0 to
            NSC-1."
        REFERENCE
            "G.988 9.7.11  xDSL downstream RFI bands profile."
        DEFVAL { "" } 
        ::= { zxAnPonRmXdslRfiConfPrfEntry 2 }

    zxAnPonRmXdslRfiConfPrfRowStatus  OBJECT-TYPE
       SYNTAX      RowStatus
       MAX-ACCESS  read-create
       STATUS      current
       DESCRIPTION
           "The status of this conceptual row.
            The state of this conceptual row only support 
            'not exist' and  'active'.
            The action of this conceptual row only support
            'createAndGo' and 'destroy'.
            
            To create a row in this table, a manager must
            set this object to createAndGo(4).
    
            To delete a row in this table, a manager must
            set this object to destroy(6). 
             
            To query this object, always return 1. "    
       ::= { zxAnPonRmXdslRfiConfPrfEntry 50 }

-------------------------------------------------------------------------------
-- 10.50 zxAnPonRmXdsl2LineInventoryTable
-------------------------------------------------------------------------------
    zxAnPonRmXdsl2LineInventoryTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdsl2LineInventoryEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL line inventory table." 
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1.
             G.988 9.7.16 VDSL2 line inventory and status data part 1.
             G.988 9.7.17 VDSL2 line inventory and status data part 2"
        ::= { zxAnPonRmOnuXdslObjects 50 }

    zxAnPonRmXdsl2LineInventoryEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2LineInventoryEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL line inventory entry."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex, 
                 zxAnPonRmXdsl2LInvUnit }
        ::= { zxAnPonRmXdsl2LineInventoryTable 1 }
        
    ZxAnPonRmXdsl2LineInventoryEntry  ::=
        SEQUENCE {
            zxAnPonRmXdsl2LInvUnit               Xdsl2Unit,
            zxAnPonRmXdsl2LInvG994VendorId       OCTET STRING,
            zxAnPonRmXdsl2LInvSystemVendorId     OCTET STRING,
            zxAnPonRmXdsl2LInvVersionNumber      OCTET STRING,
            zxAnPonRmXdsl2LInvSerialNumber       OCTET STRING,
            zxAnPonRmXdsl2LInvSelfTestResult     Unsigned32,
            zxAnPonRmXdsl2LInvTransCap           BITS
        }        

    zxAnPonRmXdsl2LInvUnit  OBJECT-TYPE
        SYNTAX      Xdsl2Unit
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The termination unit."
        ::= { zxAnPonRmXdsl2LineInventoryEntry 1 }

    zxAnPonRmXdsl2LInvG994VendorId  OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(8))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This is the vendor ID as inserted in the G.994.1 CL message. 
             It comprises 8 octets, including a country code followed by a 
             (regionally allocated) provider code, as defined in [ITU-T T.35]."
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineInventoryEntry 2 }

    zxAnPonRmXdsl2LInvSystemVendorId  OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(8))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This is the vendor ID as inserted in the overhead messages 
             (both XTUs for G.992.3 and G.992.4) or in the embedded operations 
             channel (only XTU-R in G.992.1 and G.992.2). It comprises 8 binary 
             octets, with the same format as the 
             zxAnPonRmXdsl2LInvG994VendorId."
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineInventoryEntry 3 }

    zxAnPonRmXdsl2LInvVersionNumber  OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(0..16))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "For xTU-C:
             this is the vendor specific version number as inserted in the 
             overhead messages of G.992.3 and G.992.4.  It comprises up to 16 
             binary octets.
             For xTU-R:
             this is the version number as inserted by the xTU R in the embedded 
             operations channel of G.992.1 or G.992.2, or the overhead messages 
             of G.992.3, G.992.4, G.992.5 and G.993.2. The attribute value may 
             be vendor-specific, but is recommended to comprise up to 16 ASCII 
             characters, null-terminated if it is shorter than 16. The string 
             should contain the xTU-R firmware version and the xTU-R model, 
             encoded in that order and separated by a space character: 
             '<xTU-R firmware version> <xTU-R model>.' It is recognized that 
             legacy xTU-Rs may not support this format."
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineInventoryEntry 4 }

    zxAnPonRmXdsl2LInvSerialNumber  OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(0..32))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "For xTU-C:
             the vendor specific serial number inserted by the xTU-C in 
             the overhead messages of G.992.3 and G.992.4 comprises up to 32 
             ASCII characters, null terminated if it is shorter than 32 
             characters.
             For xTU-R:
             the serial number inserted by the xTU-R in the embedded 
             operations channel of G.992.1 or G.992.2, or the overhead messages
             of G.992.3, G.992.4, G.992.5 and G.993.2, comprises up to 32 ASCII
             characters, null-terminated if it is shorter than 32. It is 
             recommended to contain the equipment serial number, the equipment 
             model and the equipment firmware version, encoded in that order 
             and separated by space characters: '<equipment serial number> 
             <equipment model> <equipment firmware version>.' It is recognized 
             that legacy xTU-Rs may not support this format."
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineInventoryEntry 5 }

    zxAnPonRmXdsl2LInvSelfTestResult  OBJECT-TYPE
        SYNTAX      Unsigned32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The self-test result, coded in two fields. 
             The most significant octet is 0 if the self-test passed 
             and 1 if it failed. The three least significant octets are a 
             vendor-discretionary integer that can be interpreted in combination 
             with G.994.1 and the system vendor ID."
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineInventoryEntry 6 }

    zxAnPonRmXdsl2LInvTransCap OBJECT-TYPE
        SYNTAX      BITS{
                    g933RegionA(0),
                    g933RegionB(1),
                    g933RegionC(2)
                    }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This value extends the transmission system capability 
             attribute of the xDSL line inventory and status data part 1 to 
             include xTU-C VDSL2 capabilities. This attribute is 1 byte long.
             It is a bitmap. The bit position values are:
             bit 0: G.993.2 region A (North America) (Annex A of 
                    [ITU-T G.993.2])
             bit 1: G.993.2 region B (Europe) (Annex B of [ITU-T G.993.2])
             bit 2: G.993.2 region C (Japan) (Annex C of [ITU-T G.993.2])
             bit 3 - bit7: reserved."
        REFERENCE
            "G.988 9.7.16 VDSL2 line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineInventoryEntry 7 }

-------------------------------------------------------------------------------
-- 10.51 zxAnPonRmXdsl2LineStatusTable
-------------------------------------------------------------------------------
    zxAnPonRmXdsl2LineStatusTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdsl2LineStatusEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL line status table."
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1.
             G.988 9.7.13 xDSL line inventory and status data part 2.
             G.988 9.7.16 VDSL2 line inventory and status data part 1.
             G.988 9.7.17 VDSL2 line inventory and status data part 2.
             G.988 9.7.6 VDSL2 line configuration extensions."
        ::= { zxAnPonRmOnuXdslObjects 51 }

    zxAnPonRmXdsl2LineStatusEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2LineStatusEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL line status entry."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex }
        ::= { zxAnPonRmXdsl2LineStatusTable 1 }

    ZxAnPonRmXdsl2LineStatusEntry  ::=
        SEQUENCE {
            zxAnPonRmXdsl2LInitResult          INTEGER,
            zxAnPonRmXdsl2LPwrMgmtState        Xdsl2PowerMngState,
            zxAnPonRmXdsl2LSnrMarginDs         Integer32,
            zxAnPonRmXdsl2LSnrMarginUs         Integer32,
            zxAnPonRmXdsl2LMaxAttainRateDs     Unsigned32,
            zxAnPonRmXdsl2LMaxAttainRateUs     Unsigned32,
            zxAnPonRmXdsl2LActPsdDs            Integer32,
            zxAnPonRmXdsl2LActPsdUs            Integer32,
            zxAnPonRmXdsl2LActAtpDs            Integer32,
            zxAnPonRmXdsl2LActAtpUs            Integer32,
            zxAnPonRmXdsl2LTransSystem         BITS,
            zxAnPonRmXdsl2LActPrf              Xdsl2LineProfiles,
            zxAnPonRmXdsl2LActLimitMask        Xdsl2LineLimitMask,
            zxAnPonRmXdsl2LActUs0Mask          Xdsl2LineUs0Mask,
            zxAnPonRmXdsl2LActSnrModeDs        Xdsl2LineSnrMode,
            zxAnPonRmXdsl2LActSnrModeUs        Xdsl2LineSnrMode,
            zxAnPonRmXdsl2LClassMask           Xdsl2LineClassMask
        }        

    zxAnPonRmXdsl2LInitResult  OBJECT-TYPE
        SYNTAX      INTEGER{
                    successful(1),
                    configError(2),
                    configNotFeasible(3),
                    commFail(4),
                    noPeerXtu(5),
                    otherCause(6)
                    }              
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The value represents the success or failure cause of the last 
             full initialization performed on the line.
             1 Successful.
             2 Configuration error. This error occurs with inconsistencies in 
                 configuration parameters, for example when the line is 
                 initialized in an xDSL transmission system whose xTU does not 
                 support the configured maximum delay or the configured minimum 
                 or maximum data rate for one or more bearer channels.
             3 Configuration not feasible on the line. This error occurs if the 
                 minimum data rate cannot be achieved on the line with the 
                 minimum noise margin, maximum PSD level, maximum delay and 
                 maximum bit error ratio for one or more bearer channels.
             4 Communication problem. This error occurs for example due to 
                 corrupted messages, bad syntax messages, if no common mode can 
                 be selected in the G.994.1 handshake procedure, or due to a 
                 timeout.
             5 No peer xTU detected. This error occurs if the peer xTU is not 
                 powered or not connected or if the line is too long to allow 
                 detection of a peer xTU.
             6 Any other or unknown initialization failure cause."
        REFERENCE
            "G.988 9.7.12 xDSL line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineStatusEntry 1 }

    zxAnPonRmXdsl2LPwrMgmtState  OBJECT-TYPE
        SYNTAX      Xdsl2PowerMngState
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The line power management state."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 2 }

    zxAnPonRmXdsl2LSnrMarginDs  OBJECT-TYPE
        SYNTAX      Integer32(-640..630|65535)
        UNITS       "0.1 dB"     
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The downstream signal to noise ratio margin. 
             It is the maximum increase of noise power received at the xTU-R, 
             such that the BER requirements can still be met for all downstream 
             bearer channels. The attribute value ranges from 
             -640 (-64.0 dB) to 630 (+63.0 dB). The special value 0xFFFF 
             indicates that the attribute is out of range."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 3 }

    zxAnPonRmXdsl2LSnrMarginUs  OBJECT-TYPE
        SYNTAX      Integer32(-640..630|65535)
        UNITS       "0.1 dB"        
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The upstream signal to noise ratio margin.
             It is the maximum increase of noise power received at the xTU-C, 
             such that the BER requirements can still be met for all upstream 
             bearer channels. The attribute value ranges from 
             -640 (-64.0 dB) to 630 (+63.0 dB). The special value 0xFFFF 
             indicates that the  attribute is out of range."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 4 }

    zxAnPonRmXdsl2LMaxAttainRateDs  OBJECT-TYPE
        SYNTAX      Unsigned32
        UNITS       "bps"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The maximum downstream net data rate currently attainable. 
             The rate is coded in bit/s."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 5 }

    zxAnPonRmXdsl2LMaxAttainRateUs  OBJECT-TYPE
        SYNTAX      Unsigned32
        UNITS       "bps"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The maximum upstream net data rate currently attainable. 
             The rate is coded in bit/s."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 6 }

    zxAnPonRmXdsl2LActPsdDs  OBJECT-TYPE
        SYNTAX      Integer32(-900..0|65535)
        UNITS       "0.1 dBm/Hz"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The downstream actual power spectrum density.
             It is the average downstream transmit power spectrum density over 
             the subcarriers in use (subcarriers to which downstream user data 
             are allocated) delivered by the xTU-C at the U-C reference point, 
             at the instant of measurement. The attribute value ranges from 
             -900(-90.0 dBm/Hz) to 0 (0.0 dBm/Hz). The special value 0xFFFF 
             indicates that the parameter is out of range."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 7 }

    zxAnPonRmXdsl2LActPsdUs  OBJECT-TYPE
        SYNTAX      Integer32(-900..0|65535)
        UNITS       "0.1 dBm/Hz"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The upstream actual power spectrum density.
             It is the average upstream transmit power spectrum density over 
             the subcarriers in use (subcarriers to which upstream user data 
             are allocated) delivered by the xTU-R at the U-R reference point, 
             at the instant of measurement. The attribute value ranges from 
             -900(-90.0 dBm/Hz) to 0 (0.0 dBm/Hz). The special value 0xFFFF 
             indicates that the attribute is out of range."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 8 }

    zxAnPonRmXdsl2LActAtpDs  OBJECT-TYPE
        SYNTAX      Integer32(-310..310|65535)
        UNITS       "0.1 dBm"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The downstream actual aggregate transmit power. 
             It is the total amount of transmit power delivered by the xTU-C 
             at the U-C reference point, at the instant of measurement. The 
             attribute value ranges from -310 (-31.0 dBm) to 310 (+31.0 dBm). 
             The special value 0xFFFF indicates that the parameter is out 
             of range."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 9 }

    zxAnPonRmXdsl2LActAtpUs  OBJECT-TYPE
        SYNTAX      Integer32(-310..310|65535)
        UNITS       "0.1 dBm"        
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The upstream actual aggregate transmit power. 
             It is the total amount of transmit power delivered by the xTU-R 
             at the U-R reference point, at the instant of measurement. The 
             attribute value ranges from -310 (-31.0 dBm) to 310 (+31.0 dBm). 
             The special value 0xFFFF indicates that the parameter is out 
             of range."
        REFERENCE
            "G.988 9.7.13 xDSL line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 10 }

    zxAnPonRmXdsl2LTransSystem  OBJECT-TYPE
        SYNTAX      BITS{
                    g933RegionA(0),
                    g933RegionB(1),
                    g933RegionC(2)
                    }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The transmission system in use. It extends the xDSL transmission 
             system attribute of the xDSL line inventory and status data part 2 
             managed entity with a byte that includes VDSL2 capabilities 
             currently in use.
             It is a bitmap. The bit position values are:
             bit 0: G.993.2 region A (North America) (Annex A of 
                    [ITU-T G.993.2])
             bit 1: G.993.2 region B (Europe) (Annex B of [ITU-T G.993.2])
             bit 2: G.993.2 region C (Japan) (Annex C of [ITU-T G.993.2])
             bit 3 - bit7: reserved."
        REFERENCE
            "G.988 9.7.16 VDSL2 line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineStatusEntry 11 }
        
    zxAnPonRmXdsl2LActPrf  OBJECT-TYPE
        SYNTAX      Xdsl2LineProfiles
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The profile in use."
        REFERENCE
            "G.988 9.7.16 VDSL2 line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineStatusEntry 12 }

    zxAnPonRmXdsl2LActLimitMask  OBJECT-TYPE
        SYNTAX      Xdsl2LineLimitMask
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The limit PSD mask and band plan in use."
        REFERENCE
            "G.988 9.7.16 VDSL2 line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineStatusEntry 13 }

    zxAnPonRmXdsl2LActUs0Mask  OBJECT-TYPE
        SYNTAX      Xdsl2LineUs0Mask
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The US0 PSD mask in use."
        REFERENCE
            "G.988 9.7.16 VDSL2 line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineStatusEntry 14 }

    zxAnPonRmXdsl2LActSnrModeDs  OBJECT-TYPE
        SYNTAX      Xdsl2LineSnrMode
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This value indicates whether transmitter referred virtual 
             noise is active on the line in the downstream direction."
        REFERENCE
            "G.988 9.7.16 VDSL2 line inventory and status data part 1."
        ::= { zxAnPonRmXdsl2LineStatusEntry 15 }

    zxAnPonRmXdsl2LActSnrModeUs  OBJECT-TYPE
        SYNTAX      Xdsl2LineSnrMode
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "This value indicates whether transmitter referred virtual 
             noise is active on the line in the upstream direction."
        REFERENCE
            "G.988 9.7.17 VDSL2 line inventory and status data part 2."
        ::= { zxAnPonRmXdsl2LineStatusEntry 16 }
        
    zxAnPonRmXdsl2LClassMask  OBJECT-TYPE
        SYNTAX      Xdsl2LineClassMask
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The configured class mask.
             In order to reduce the number of configuration possibilities, the 
             limit Power Spectral Density masks 
             (see zxAnPonRmXdsl2LActLimitMask) are grouped in PSD mask classes.
             Each class is designed such that the PSD levels of each limit PSD 
             mask of a specific class are equal in their respective passband 
             above 276 kHz.
             This parameter is defined per VDSL2 Annex enabled in the 
             zxAnPonRmXdslXtuTransSysEn object. It selects a single PSD mask 
             class per Annex that is activated at the VTU-O."
        REFERENCE
            "G.988 9.7.6 VDSL2 line configuration extensions."
        DEFVAL       { a998ORb997M1cORc998B }
                ::= { zxAnPonRmXdsl2LineStatusEntry 17 }      

-------------------------------------------------------------------------------
-- 10.52 zxAnPonRmXdsl2ChannelStatusTable
-- G.988 9.7.19 xDSL channel downstream status data.
-- G.988 9.7.20 xDSL channel upstream status data.
-------------------------------------------------------------------------------
    zxAnPonRmXdsl2ChannelStatusTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdsl2ChannelStatusEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The channel status table for xDSL."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmOnuXdslObjects 52 }

    zxAnPonRmXdsl2ChannelStatusEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2ChannelStatusEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The channel status entry for xDSL."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex, 
                 zxAnPonRmXdsl2ChStatusUnit, zxAnPonRmXdsl2ChStatusChannelId}
        ::= { zxAnPonRmXdsl2ChannelStatusTable 1 }

    ZxAnPonRmXdsl2ChannelStatusEntry  ::=
        SEQUENCE {
            zxAnPonRmXdsl2ChStatusUnit            Xdsl2Unit,
            zxAnPonRmXdsl2ChStatusChannelId       Integer32,
            zxAnPonRmXdsl2ChStatusActDelay        Integer32,
            zxAnPonRmXdsl2ChStatusAdr             Unsigned32,
            zxAnPonRmXdsl2ChStatusPdr             Unsigned32,
            zxAnPonRmXdsl2ChStatusActInp          Integer32,
            zxAnPonRmXdsl2ChStatusInpRptMode      Xdsl2ChInpReport,
            zxAnPonRmXdsl2ChStatusActNFec         Integer32,
            zxAnPonRmXdsl2ChStatusActRFec         Integer32,
            zxAnPonRmXdsl2ChStatusActLsymb        Integer32,
            zxAnPonRmXdsl2ChStatActIntlvDep       Integer32,
            zxAnPonRmXdsl2ChStatActIntlvBlks      Integer32,
            zxAnPonRmXdsl2ChStatusActLPath        Integer32
        }

    zxAnPonRmXdsl2ChStatusUnit  OBJECT-TYPE
        SYNTAX      Xdsl2Unit
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The termination unit, xtuc(1) or xtur(2)."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 1 }
        
    zxAnPonRmXdsl2ChStatusChannelId  OBJECT-TYPE
        SYNTAX      Integer32(1..4)       
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The channel ID of ONU xDSL port."          
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 2 }       

    zxAnPonRmXdsl2ChStatusActDelay  OBJECT-TYPE
        SYNTAX      Integer32
        UNITS       "Milliseconds"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual one-way interleaving delay 
             introduced by the PMS-TC between the alpha and beta reference 
             points, excluding delay in L1 and L2 state. In L1 and L2 state, 
             the attribute contains the interleaving delay in the previous L0 
             state. For ADSL, this attribute is derived from the S and D 
             attributes as cap(S*D)/4 ms, where S is the number of symbols per 
             codeword, D is the interleaving depth and cap() denotes rounding 
             to the next higher integer. For G.993.2, this attribute is 
             computed according to the formula in clause 9.7 of [ITU-T G.993.2]. 
             The actual interleaving delay is coded in ms, rounded to the 
             nearest ms."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 3 }

    zxAnPonRmXdsl2ChStatusAdr  OBJECT-TYPE
        SYNTAX      Unsigned32
        UNITS       "bps"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual net data rate of the bearer channel, excluding the rate 
             in L1 and L2 states. In L1 or L2 states, the parameter contains 
             the net data rate in the previous L0 state.
             The data rate is coded in bit/s."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 4 }

    zxAnPonRmXdsl2ChStatusPdr  OBJECT-TYPE
        SYNTAX      Unsigned32
        UNITS       "bps"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The previous net data rate of the bearer channel just before 
             the latest rate change event occurred, excluding transitions 
             between the L0 state and the L1 or L2 states. 
             A rate change can occur at a power management state transition, 
             eg at full or short initialization, fast retrain or power down, 
             or at a dynamic rate adaptation.
             The data rate is coded in bit/s."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 5 }

    zxAnPonRmXdsl2ChStatusActInp  OBJECT-TYPE
        SYNTAX      Integer32(0..255)
        UNITS       "0.1 symbols"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual impulse noise protection (INP) on the bearer channel
             in the L0 state. In the L1 or L2 state, it contains the INP in
             the previous L0 state. 
             The value of this attribute is a number of DMT symbols, with a 
             granularity of 0.1 symbols. Its range is from 0 (0.0 symbols) to 
             254 (25.4 symbols). The special value 255 indicates an ACTINP 
             higher than 25.4."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 6 }

    zxAnPonRmXdsl2ChStatusInpRptMode  OBJECT-TYPE
        SYNTAX      Xdsl2ChInpReport
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Impulse noise protection reporting mode. 
             If set to 0, the ACTINP is computed according 
             to the INP_no_erasure formula (clause 9.6 of [ITU-T G.993.2]). 
             If set to 1, ACTINP is the value estimated by the xTU receiver. 
             This attribute is only used for upstream."
        REFERENCE
            "G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 7 }

    zxAnPonRmXdsl2ChStatusActNFec  OBJECT-TYPE
        SYNTAX      Integer32(0..255)
        UNITS       "bytes"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual Reed-Solomon codeword size used in the latency 
             path in which the bearer channel is transported. 
             The value is coded in bytes, and ranges from 0..255.
             The value 0 indicates no Reed-Solomon codeword."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 8 }

    zxAnPonRmXdsl2ChStatusActRFec  OBJECT-TYPE
        SYNTAX      Integer32(0..16)
        UNITS       "bytes"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual number of Reed-Solomon redundancy bytes per 
             codeword used in the latency path in which the bearer channel 
             is transported. The value is coded in bytes, and ranges from 
             0..16. The value 0 indicates no Reed-Solomon coding."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 9 }

    zxAnPonRmXdsl2ChStatusActLsymb  OBJECT-TYPE
        SYNTAX      Integer32(0..65535)
        UNITS       "bits"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual number of bits per symbol assigned to the latency
             path in which the bearer channel is transported, excluding trellis 
             overhead. The value is coded in bits, and ranges from 0..65535.
             The value 0 indicates no symbol assigned to the latency path."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 10 }

    zxAnPonRmXdsl2ChStatActIntlvDep  OBJECT-TYPE
        SYNTAX      Integer32(1..4096)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Actual interleaving depth.
             This parameter reports the actual depth of the interleaver used in
             the latency path in which the bearer channel is transported.
             The value ranges from 1..4096 in steps of 1.
             The value 1 indicates no interleaving."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 11 }

    zxAnPonRmXdsl2ChStatActIntlvBlks  OBJECT-TYPE
        SYNTAX      Integer32(4..255)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Actual interleaving block length.
             This parameter reports the actual block length of 
             the interleaver used in the latency path in which the bearer 
             channel is transported. 
             The value ranges from 4..255 in steps of 1."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 12 }

    zxAnPonRmXdsl2ChStatusActLPath  OBJECT-TYPE
        SYNTAX      Integer32(0..3)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual latency path in which the bearer channel
             is transported. Valid values are 0..3. 
             In G.992.1, the fast path is mapped to latency index 0; 
             the interleaved path to index 1."
        REFERENCE
            "G.988 9.7.19 xDSL channel downstream status data.
             G.988 9.7.20 xDSL channel upstream status data."
        ::= { zxAnPonRmXdsl2ChannelStatusEntry 13 }
        
-------------------------------------------------------------------------------
-- 10.53 zxAnPonRmXdsl2LineBandTable
-------------------------------------------------------------------------------          
    zxAnPonRmXdsl2LineBandTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdsl2LineBandEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The per-band line status parameters table of xDSL. 
             It extends the other xDSL line inventory and status data 
             MEs with attributes specific to VDSL2. This ME contains per-band 
             attributes for both directions. These same attributes are defined 
             in the xDSL line inventory and status data part 2 managed entity, 
             but only for a single band. [ITU T G.993.2] allows for VDSL2 to 
             have as many as five bands upstream and as many as five bands 
             downstream."
        ::= { zxAnPonRmOnuXdslObjects 53 }
    
    zxAnPonRmXdsl2LineBandEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2LineBandEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The per-band line status parameters entry of xDSL."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex , 
                 zxAnPonRmXdsl2LineBand }
        ::= { zxAnPonRmXdsl2LineBandTable 1 }
    
    ZxAnPonRmXdsl2LineBandEntry  ::=
        SEQUENCE {
            zxAnPonRmXdsl2LineBand                       INTEGER,
            zxAnPonRmXdsl2LineBandLatn                   Unsigned32,
            zxAnPonRmXdsl2LineBandSatn                   Unsigned32,
            zxAnPonRmXdsl2LineBandSnrm                   Integer32
        }
      
    zxAnPonRmXdsl2LineBand  OBJECT-TYPE
        SYNTAX      INTEGER{
                    us0(1),
                    ds1(2),
                    us1(3),
                    ds2(4),
                    us2(5),
                    ds3(6),
                    us3(7)
                    }                          
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION        
            "The index identifies a band in an xDSL line."
        ::= { zxAnPonRmXdsl2LineBandEntry 1 }
    
    zxAnPonRmXdsl2LineBandLatn  OBJECT-TYPE
        SYNTAX      Unsigned32 (0..1270 | 65534 | 65535)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Line Attenuation.
             It is the squared magnitude of the channel characteristics 
             function H(f) averaged over this band, and measured during loop 
             diagnostic mode and initialization. The exact definition is 
             included in the relevant xDSL recommendation. 
             The line attenuation per band ranges from 0(0.0dB) to 
             1270(127.0dB).
             The special value 0xFFFE(65534) indicates the line attenuation 
             measurement is unavailable.
             The special value 0xFFFF(65535) indicates the line attenuation per 
             band is out of range to be represented."
        REFERENCE    "9.7.18 VDSL2 line inventory and status data part 3"
        DEFVAL       { 65534 }
        ::= { zxAnPonRmXdsl2LineBandEntry 2 }
    
    zxAnPonRmXdsl2LineBandSatn  OBJECT-TYPE
        SYNTAX      Unsigned32 (0..1270 | 65534 | 65535)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Signal Attenuation.
             It is the measured difference in the total power transmitted in 
             this band by the xTU-C and the total power received by the xTU-R 
             during loop diagnostic mode, initialization and showtime. 
             The exact definition is included in the relevant xDSL 
             recommendation. 
             The signal attenuation per band ranges from 0(0.0dB) to 
             1270(127.0dB).             
             The special value 0xFFFE(65534) indicates the line attenuation 
             measurement is unavailable.
             The special value 0xFFFF(65535) indicates the line attenuation per 
             band is out of range to be represented."
        REFERENCE    "9.7.18 VDSL2 line inventory and status data part 3"
        DEFVAL       { 65534 }
        ::= { zxAnPonRmXdsl2LineBandEntry 3 }
    
    zxAnPonRmXdsl2LineBandSnrm  OBJECT-TYPE
        SYNTAX      Integer32 (-640..630 | 65534 | 65535)
        UNITS       "0.1 dB"
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Signal to noise ratio margin. 
             The maximum increase of noise power received at the xTU-R, 
             such that the BER requirements are met for all downstream 
             bearer channels. 
             Values ranges from -640(-64.0dB) to 630(63.0dB).
             The special value 0xFFFE(65534) indicates the line attenuation 
             measurement is unavailable.
             The special value 0xFFFF(65535) indicates the line attenuation per 
             band is out of range to be represented."
        REFERENCE    "9.7.18 VDSL2 line inventory and status data part 3"
        DEFVAL       { 65534 }
        ::= { zxAnPonRmXdsl2LineBandEntry 4 }   
         
-------------------------------------------------------------------------------
-- zxAnPonRmXdsl2PMConfTable
-------------------------------------------------------------------------------
    zxAnPonRmXdsl2PMConfTable    OBJECT-TYPE
        SYNTAX      SEQUENCE OF ZxAnPonRmXdsl2PMConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL performance configuration table."
        ::= { zxAnPonRmXdsl2PMConfObjects 2 }

    zxAnPonRmXdsl2PMConfEntry OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2PMConfEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL performance configuration entry."
        INDEX   { ifIndex, zxAnPonOnuIndex, zxAnPonRmXdsl2PMType,
                  zxAnPonRmXdsl2PMIndex}
        ::= { zxAnPonRmXdsl2PMConfTable 1 }

    ZxAnPonRmXdsl2PMConfEntry ::=
        SEQUENCE {
            zxAnPonRmXdsl2PMType                      INTEGER,
            zxAnPonRmXdsl2PMIndex                     OBJECT IDENTIFIER,            
            zxAnPonRmXdsl2PMConfRowStatus             RowStatus
            }

    zxAnPonRmXdsl2PMType OBJECT-TYPE
        SYNTAX      INTEGER{
                    line(1),
                    channel(2)
                    }
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The ONU xDSL performance monitoring MIB table type.
             line(1): the xDSL line performance data type.
             channel(2): the xDSL channel performance data type."
        ::= { zxAnPonRmXdsl2PMConfEntry 1 }

    zxAnPonRmXdsl2PMIndex  OBJECT-TYPE
        SYNTAX      OBJECT IDENTIFIER
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The index can be referred from the related current 15 minutes MIB
             table.
                line: zxAnPonRmXdsl2PMLineC15MTable.
                channel: zxAnPonRmXdsl2PMChC15MTable.
             The value of zxAnPonRmXdsl2PMIndex consists of some MIB object IDs,  
             the first value between zxAnPonRmXdsl2PMIndex indicates the 
             length of MIB object IDs.
             The format of the index is defined as the following:
                If 'zxAnPonRmXdsl2PMType' is line(1), the index is 
                '2.zxAnPonRmOnuIfIndex', such as
                '2.1'.
                If 'zxAnPonRmXdsl2PMType' is channel(2), the index is 
                '3.zxAnPonRmOnuIfIndex.
                zxAnPonRmXdsl2ChC15MChannelId', such as '3.1.1'."                           
        ::= { zxAnPonRmXdsl2PMConfEntry 2 }

    zxAnPonRmXdsl2PMConfRowStatus OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "The status of this conceptual row.

             The supported actions of this conceptual row only include:
             'createAndGo' and 'destroy'.

             To create a row in this table, a manager must
             set this object to createAndGo(4).

             To delete a row in this table, a manager must
             set this object to destroy(6).

             To query this object, always return 1."
        ::= { zxAnPonRmXdsl2PMConfEntry 50 }
        
--------------------------------------------------------------------------------      
 -- zxAnPonRmXdsl2PMLineC15MTable 
--------------------------------------------------------------------------------
    zxAnPonRmXdsl2PMLineC15MTable  OBJECT-TYPE
        SYNTAX      SEQUENCE  OF  ZxAnPonRmXdsl2PMLineC15MEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL line current 15 minutes performance data table."
        ::= { zxAnPonRmXdsl2PMLineObjects 10 }
    
    zxAnPonRmXdsl2PMLineC15MEntry  OBJECT-TYPE
        SYNTAX      ZxAnPonRmXdsl2PMLineC15MEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The xDSL line current 15 minutes performance data entry."
        INDEX  { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuUniIndex, 
                 zxAnPonRmXdsl2LC15MUnit }
        ::= { zxAnPonRmXdsl2PMLineC15MTable 1 }
    
    ZxAnPonRmXdsl2PMLineC15MEntry ::=
        SEQUENCE {
            zxAnPonRmXdsl2LC15MUnit                   Xdsl2Unit,                     
            zxAnPonRmXdsl2LC15MLofs                   Counter32,
            zxAnPonRmXdsl2LC15MLoss                   Counter32,
            zxAnPonRmXdsl2LC15MLols                   Counter32,
            zxAnPonRmXdsl2LC15MLprs                   Counter32,
            zxAnPonRmXdsl2LC15MErrs                   Counter32,
            zxAnPonRmXdsl2LC15MSES                    Counter32,
            zxAnPonRmXdsl2LC15MFullInits              Counter32,
            zxAnPonRmXdsl2LC15MFailFullInits          Counter32,
            zxAnPonRmXdsl2LC15MShortInits             Counter32,
            zxAnPonRmXdsl2LC15MFShortInits            Counter32, 
            zxAnPonRmXdsl2LC15MFecs                   Counter32,
            zxAnPonRmXdsl2LC15MUAS                    Counter32,              
            zxAnPonRmXdsl2LC15MSosSuccessNe           Counter32,            
            zxAnPonRmXdsl2LC15MSosSuccessFe           Counter32                       
        }           

    zxAnPonRmXdsl2LC15MUnit  OBJECT-TYPE
        SYNTAX      Xdsl2Unit
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The termination unit, xtuc(1) or xtur(2)."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 1 }
        
    zxAnPonRmXdsl2LC15MLofs  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"        
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Loss of frame seconds during this interval."             
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 2 }        

    zxAnPonRmXdsl2LC15MLoss  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"                
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Loss of signal seconds during this interval."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."    
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 3 }  
        
    zxAnPonRmXdsl2LC15MLols  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"                
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Loss of link seconds during this interval."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 4 }           
        
    zxAnPonRmXdsl2LC15MLprs  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"                
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Loss of power seconds during this interval."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 5 }          
        
    zxAnPonRmXdsl2LC15MErrs  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"                
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Errored seconds during this interval that there was:
             xTU-C: CRC-8 >= 1 for one or more bearer channels or
                 LOS >= 1 or SEF >=1 or LPR >= 1
             xTU-R: FEBE >= 1 for one or more bearer channels or
                 LOS-FE >=1 or RDI >=1 OR LPR-FE >=1."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 6 }           
        
    zxAnPonRmXdsl2LC15MSES  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"        
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Severely errored seconds during this interval that there was:
             xTU-C: (CRC-8 anomalies in one or more of the
                 received bearer channels) >= 18 or LOS >= 1
                 or SEF >= 1 or LPR >= 1
             xTU-R: (FEBE anomalies in one or more of the
                 received bearer channels) >= 18 or LOS-FE >= 1
                 or RDI >= 1 or LPR-FE >= 1."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 7 }                   
                    
    zxAnPonRmXdsl2LC15MFullInits  OBJECT-TYPE
        SYNTAX      Counter32       
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of full initializations attempted on the line 
             during this interval.
             This value is valid when zxAnPonRmXdsl2LH15MUnit is xtuc(1)."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 8 }
        
    zxAnPonRmXdsl2LC15MFailFullInits  OBJECT-TYPE
        SYNTAX      Counter32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of failed full initializations attempted on the 
             line during this interval.
             This value is valid when zxAnPonRmXdsl2LH15MUnit is xtuc(1)."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 9 }              
          
    zxAnPonRmXdsl2LC15MShortInits  OBJECT-TYPE
        SYNTAX      Counter32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of short initializations attempted on the line 
             during this interval.
             This value is valid when zxAnPonRmXdsl2LH15MUnit is xtuc(1)."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 10 }           
        
    zxAnPonRmXdsl2LC15MFShortInits  OBJECT-TYPE
        SYNTAX      Counter32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of failed short initializations attempted on the 
             line during this interval."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data.
             This value is valid when zxAnPonRmXdsl2LH15MUnit is xtuc(1)."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 11 }                   
        
    zxAnPonRmXdsl2LC15MFecs  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"        
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "FEC seconds during this interval."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 12 }           
        
    zxAnPonRmXdsl2LC15MUAS  OBJECT-TYPE
        SYNTAX      Counter32
        UNITS       "Seconds"        
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Unavailable seconds during this interval.
             for xTU-C: 
             It counts one-second intervals during which the xDSL UNI is 
             unavailable. 
             The line becomes unavailable at the onset of ten contiguous SES-Ls. 
             The ten SES-Ls are included in unavailable time. Once unavailable, 
             the line becomes available at the onset of ten contiguous seconds 
             that are not severely errored. The ten seconds with no SES Ls are 
             excluded from unavailable time.
             for xTU-R: 
             It counts one-second intervals during which the far-end xDSL 
             termination is unavailable. The far-end xDSL termination becomes 
             unavailable at the onset of ten contiguous SES-LFEs. The ten 
             SES-LFEs are included in unavailable time. Once unavailable, the 
             far-end line becomes available at the onset of ten contiguous 
             seconds with no SES-LFEs. The ten seconds with no SES-LFEs are 
             excluded from unavailable time."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data
             G.988 9.7.22 xDSL xTU-R performance monitoring history data."
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 13 }   
            
    zxAnPonRmXdsl2LC15MSosSuccessNe  OBJECT-TYPE
        SYNTAX      Counter32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of successful SOS procedures initiated by 
             the near-end xTU on the line during this interval. 
             This value is valid when zxAnPonRmXdsl2LC15MUnit is xtuc(1)."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data"             
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 14 }           
        
    zxAnPonRmXdsl2LC15MSosSuccessFe  OBJECT-TYPE
        SYNTAX      Counter32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The total number of successful SOS procedures initiated by 
             the far-end xTU on the line during this interval.
             This value is valid when zxAnPonRmXdsl2LC15MUnit is xtuc(1)."
        REFERENCE
            "G.988 9.7.21 xDSL xTU-C performance monitoring history data"
        ::= { zxAnPonRmXdsl2PMLineC15MEntry 15 } 
                 
