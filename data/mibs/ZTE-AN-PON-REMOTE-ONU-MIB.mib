        SYNTAX      ZxAnPonRmOnuCfmMepLmEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "It is entry in the zxAnPonRmOnuCfmMepLmTable."
        INDEX   { ifIndex, zxAnPonOnuIndex, zxAnPonRmOnuCfmMdId, 
                  zxAnPonOnuCfmMaId, zxAnPonOnuCfmMepId }
        ::= { zxAnPonRmOnuCfmMepLmTable 1 }

    ZxAnPonRmOnuCfmMepLmEntry ::=
        SEQUENCE {
            zxAnPonOnuLmEndType                     INTEGER,
            zxAnPonOnuLmAction                      INTEGER,
            zxAnPonOnuLmTargetMac                   MacAddress,
            zxAnPonOnuLmTargetMepId                 Integer32,
            zxAnPonOnuLmInterval                    INTEGER,
            zxAnPonOnuLmPri                         Integer32,
            zxAnPonOnuLmDropEligibility             INTEGER,
            zxAnPonOnuLmTransmitMsgs                Integer32,
            zxAnPonOnuLmNearendLossRatio            Integer32,
            zxAnPonOnuLmNearendLoss                 Integer32,
            zxAnPonOnuLmFarendLossRatio             Integer32,
            zxAnPonOnuLmFarendLoss                  Integer32,
            zxAnPonOnuLmAvgNearendLossRatio         Integer32,
            zxAnPonOnuLmAvgNearendLoss              Integer32,
            zxAnPonOnuLmAvgFarendLossRatio          Integer32,
            zxAnPonOnuLmAvgFarendLoss               Integer32
        }

    zxAnPonOnuLmEndType  OBJECT-TYPE
        SYNTAX      INTEGER {
                    lmSingle(1),
                    lmDual(2)
                    }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "lmSingle(1)  Single-ended ETH-LM, a MEP sends frames with
                          ETH-LM request information to its peer MEP and receive
                          frames with ETH-LM reply information from its peer MEP
                          to carry out loss measurements.
             lmDual(2)    Dual-ended ETH-LM, each MEP sends periodic dual-ended
                          frames with ETH-LM information to its peer MEP in
                          a point-to-point ME to facilitate frame loss
                          measurements at the peer MEP. Each MEP terminates
                          the dual-ended frames with ETH-LM information and
                          makes the near-end and far-end loss measurements.
             "
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 1 }

    zxAnPonOnuLmAction  OBJECT-TYPE
        SYNTAX      INTEGER {
                    start(1),
                    stop(2)
                    }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Start/Stop the LM test operation "
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 2 }

    zxAnPonOnuLmTargetMac  OBJECT-TYPE
        SYNTAX      MacAddress
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The target MAC address."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 3 }

    zxAnPonOnuLmTargetMepId  OBJECT-TYPE
        SYNTAX      Integer32 (1..16)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The target MEP id."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 4 }

    zxAnPonOnuLmInterval  OBJECT-TYPE
        SYNTAX      INTEGER {
                       interval100ms     (1),
                       interval1s        (2),
                       interval10s       (3),
                       interval1min      (4),
                       interval10min     (5)
                    }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "
             interval100ms(1)   CCMs are sent every 100 milliseconds.
             interval1s(2)      CCMs are sent every 1 second.
             interval10s(3)     CCMs are sent every 10 seconds.
             interval1min(4)    CCMs are sent every minute.
             interval10min(5)   CCMs are sent every 10 minutes.
             "
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        DEFVAL {interval100ms}
        ::= { zxAnPonRmOnuCfmMepLmEntry 5 }

    zxAnPonOnuLmPri  OBJECT-TYPE
        SYNTAX      Integer32 (0..7)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The priority."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 6 }

    zxAnPonOnuLmDropEligibility  OBJECT-TYPE
        SYNTAX      INTEGER  {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The drop eligibility."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 7 }

    zxAnPonOnuLmTransmitMsgs  OBJECT-TYPE
        SYNTAX      Integer32(1..1024)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "Repetition count, range 1~1024. This governs how many 
             LM test messages are generated."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 8 }

    zxAnPonOnuLmNearendLossRatio  OBJECT-TYPE
        SYNTAX      Integer32 (0..100)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The value of near-end frame loss ratio in percent."
        ::= { zxAnPonRmOnuCfmMepLmEntry 9 }

    zxAnPonOnuLmNearendLoss  OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The number of near-end frame loss."
        ::= { zxAnPonRmOnuCfmMepLmEntry 10 }

    zxAnPonOnuLmFarendLossRatio  OBJECT-TYPE
        SYNTAX      Integer32 (0..100)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The value of far-end frame loss ratio in percent."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 11 }

    zxAnPonOnuLmFarendLoss  OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The number of far-end frame loss."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 12 }

    zxAnPonOnuLmAvgNearendLossRatio  OBJECT-TYPE
        SYNTAX      Integer32 (0..100)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average value of near-end frame loss ratio in percent."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 13 }

    zxAnPonOnuLmAvgNearendLoss  OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average number of near-end frame loss."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 14 }

    zxAnPonOnuLmAvgFarendLossRatio  OBJECT-TYPE
        SYNTAX      Integer32 (0..100)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average value of far-end frame loss ratio in percent."
        REFERENCE
           "ITU-T Y.1731;ZTE private OAM/ME"
        ::= { zxAnPonRmOnuCfmMepLmEntry 15 }

    zxAnPonOnuLmAvgFarendLoss  OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The average number of far-end frame loss."
        ::= { zxAnPonRmOnuCfmMepLmEntry 16 }
